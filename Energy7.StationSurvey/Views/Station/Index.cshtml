        function mpSensorKeys() {
            var keys = {};
            (__mp.locations || []).forEach(function (l) { Object.keys(l.plan.sensors || {}).forEach(function (k) { keys[k] = true; }); });
            // Same order as the server (MaterialPositioning.SensorOrder): voltage first; DC, AC, HZ; then by range
            function ord(k) {
                var p = k.split('|'), t = (p[1] || '').toUpperCase();
                var nums = (t.match(/\d+(\.\d+)?/g) || []).map(Number);
                return [p[0] === 'Voltage' ? 0 : 1, /DC$/.test(t) ? 0 : /AC$/.test(t) ? 1 : /HZ$/.test(t) ? 2 : 3, nums.length ? Math.max.apply(null, nums) : 0];
            }
            return Object.keys(keys).sort(function (a, b) {
                var x = ord(a), y = ord(b);
                return x[0] - y[0] || x[1] - y[1] || x[2] - y[2] || a.localeCompare(b);
            });
        }
        function mpShort(k) { var p = k.split('|'); return (p[0] === 'Voltage' ? 'V ' : 'C ') + p[1]; }
        function mpSum(f) { return (__mp.locations || []).reduce(function (s, l) { return s + (f(l) || 0); }, 0); }

        function mpRender() {
            var locs = __mp.locations || [];
            var d = new Date(__mp.generatedAt);
            $('#mpStamp').text('Calculated ' + d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) + ' ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })).show();
            if (!locs.length) {
                $('#mpBody').html('<div class="mp-empty">No survey gear rows for this station yet. Add them in the Location tab → Survey gear.</div>');
                return;
            }
            var keys = mpSensorKeys();
            var gaps = locs.filter(function (l) { return (l.gaps || []).length; }).length;
            var warns = (__mp.warnings || []).length + mpSum(function (l) { return (l.plan.warnings || []).length; });
            var h = '<div class="mp-kpi">'
                + '<div class="k"><div class="l">Locations</div><div class="v">' + locs.length + '</div></div>'
                + '<div class="k"><div class="l">Voltage / current points</div><div class="v">' + mpSum(function (l) { return l.plan.voltage; }) + ' / ' + mpSum(function (l) { return l.plan.current; }) + '</div></div>'
                + '<div class="k"><div class="l">Voltage cards (MintCard)</div><div class="v">' + mpSum(function (l) { return l.plan.voltageCards; }) + '</div></div>'
                + '<div class="k"><div class="l">Current cards</div><div class="v">' + mpSum(function (l) { return l.plan.currentCards; }) + '</div></div>'
                + '<div class="k"><div class="l">A10 = ADC</div><div class="v">' + mpSum(function (l) { return l.plan.a10; }) + '</div></div>'
                + '<div class="k"><div class="l">Survey vs yard gaps</div><div class="v" style="color:' + (gaps ? 'var(--warn)' : 'var(--ok)') + '">' + gaps + '</div></div>'
                + '</div>';
            if (warns) h += '<div class="mp-warn" style="margin:-4px 0 8px"><i class="bi bi-exclamation-triangle me-1"></i>' + warns + ' remark(s) — open a location to see them.</div>';

            h += '<div class="mp-views">'
               + mpChip('loc', 'Location-wise') + mpChip('asset', 'Asset-wise (' + (__mp.assets || []).length + ')')
               + mpChip('sensor', 'Sensor matrix') + mpChip('bom', 'Bill of material') + '</div>';
            if (__mpView === 'loc') h += mpLocHtml();
            else if (__mpView === 'asset') h += mpAssetHtml();
            else if (__mpView === 'bom') h += mpBomHtml();
            else h += mpSensorHtml(keys);
            $('#mpBody').html(h);
            if (__mpSel >= 0 && __mpView !== 'asset' && __mpView !== 'bom') mpSelect(__mpSel);
        }

        var __mpView = 'loc';
        function mpChip(v, label) { return '<button class="mp-chip' + (__mpView === v ? ' on' : '') + '" onclick="__mpView=\'' + v + '\';mpRender()">' + label + '</button>'; }
        function mpLabel(l) { return l.hasSurvey ? 'cluster_' + l.plan.rfCluster + '/' + l.plan.location : l.clusterName; }
        function mpInputs(list) { return list.length ? '<div class="mp-list">' + list.map(locEsc).join(', ') + '</div>' : '<span style="color:var(--txl)">—</span>'; }
        function mpPW(plan, wired, hasWired) {
            if (!hasWired) return String(plan);
            if (plan === wired) return String(plan);
            return plan + ' <span class="mp-gap" title="Planned ' + plan + ', wired ' + wired + '">wired ' + wired + '</span>';
        }

        // e7mriv2web Material Positioning layout: Cluster | Data points | No_V | No_C | No_DI | VI | C | Type card | FTU type
        function mpLocHtml() {
            var locs = __mp.locations || [];
            var h = '<div style="overflow-x:auto;border:1px solid var(--bd);border-radius:7px"><table class="st mp-t"><thead><tr>'
                + '<th class="l">Cluster</th><th class="gh">Data points</th><th class="gh">No_V</th><th class="gh">No_C</th><th class="gh">No_DI</th>'
                + '<th class="l" style="min-width:260px">Voltage inputs (VI)</th><th class="l" style="min-width:200px">Current inputs (C)</th>'
                + '<th>Type card</th><th>FTU type</th><th>A10 / ADC</th></tr></thead><tbody>';
            locs.forEach(function (l, i) {
                var p = l.plan, hw = !!l.clusterId && (l.wiredPoints || []).length > 0;
                var src = l.hasSurvey
                    ? (p.points || []).map(function (x) { return { s: x.asset + '(' + x.title + ')', k: x.kind }; })
                    : (l.wiredPoints || []).map(function (x) { return { s: x.asset + '(' + x.title + ')', k: x.kind }; });
                var vi = src.filter(function (x) { return x.k === 'Voltage'; }).map(function (x) { return x.s; });
                var ci = src.filter(function (x) { return x.k === 'Current'; }).map(function (x) { return x.s; });
                var dpPlan = l.hasSurvey ? p.voltage + p.current : (l.wiredPoints || []).length;
                h += '<tr class="mp-row' + (i === __mpSel ? ' sel' : '') + '" onclick="mpSelect(' + i + ')">'
                   + '<td class="l"><b>' + locEsc(mpLabel(l)) + '</b>'
                   + (l.hasSurvey ? '' : '<div style="font-size:9px;color:var(--txl)">wired only · no survey row</div>')
                   + ((p.warnings || []).length ? ' <i class="bi bi-exclamation-triangle" style="color:var(--warn)" title="' + locEsc(p.warnings.join('\n')) + '"></i>' : '') + '</td>'
                   + '<td>' + (l.hasSurvey ? mpPW(dpPlan, (l.wiredPoints || []).length, hw) : dpPlan) + '</td>'
                   + '<td>' + (l.hasSurvey ? mpPW(p.voltage, l.wiredVoltageAll, hw) : l.wiredVoltageAll) + '</td>'
                   + '<td>' + (l.hasSurvey ? mpPW(p.current, l.wiredCurrentAll, hw) : l.wiredCurrentAll) + '</td>'
                   + '<td>' + (l.wiredDI || 0) + '</td>'
                   + '<td class="l">' + mpInputs(vi) + '</td><td class="l">' + mpInputs(ci) + '</td>'
                   + '<td>' + locEsc(l.hasSurvey ? (p.typeCard || '—') : (l.wiredTypeCard || '—'))
                   + (l.hasSurvey && hw && l.wiredTypeCard && l.wiredTypeCard !== p.typeCard ? '<div style="font-size:9px;color:var(--txm)">wired ' + locEsc(l.wiredTypeCard) + '</div>' : '') + '</td>'
                   + '<td>' + (l.hasSurvey ? p.ftuChannels : l.wiredFtuChannels) + '</td>'
                   + '<td><b>' + (l.hasSurvey ? p.a10 : '—') + '</b></td></tr>';
            });
            var plannedDp = mpSum(function (l) { return l.hasSurvey ? l.plan.voltage + l.plan.current : (l.wiredPoints || []).length; });
            h += '</tbody><tfoot><tr><th class="l">Total</th><th>' + plannedDp + '</th>'
               + '<th>' + mpSum(function (l) { return l.hasSurvey ? l.plan.voltage : l.wiredVoltageAll; }) + '</th>'
               + '<th>' + mpSum(function (l) { return l.hasSurvey ? l.plan.current : l.wiredCurrentAll; }) + '</th>'
               + '<th>' + mpSum(function (l) { return l.wiredDI; }) + '</th><th></th><th></th><th></th>'
               + '<th>' + mpSum(function (l) { return l.hasSurvey ? l.plan.ftuChannels : l.wiredFtuChannels; }) + '</th>'
               + '<th>' + mpSum(function (l) { return l.hasSurvey ? l.plan.a10 : 0; }) + '</th></tr></tfoot></table></div>'
               + '<div style="font-size:10px;color:var(--txl);margin-top:4px">Figures are planned from the survey; <span class="mp-gap">wired n</span> shows where Yard Config differs. Wired-only rows list what is wired. Click a row for detail.</div>'
               + '<div id="mpDetail"></div>';
            return h;
        }

        function mpAssetHtml() {
            var rows = __mp.assets || [];
            if (!rows.length) return '<div class="mp-empty">No assets found in the survey or Yard Config.</div>';
            var h = '<div style="overflow-x:auto;border:1px solid var(--bd);border-radius:7px"><table class="st mp-t"><thead><tr>'
                + '<th class="l">Asset</th><th class="l">Type</th><th class="l">Location(s)</th><th class="gh">No_V</th><th class="gh">No_C</th>'
                + '<th class="l" style="min-width:220px">Voltage inputs</th><th class="l" style="min-width:160px">Current inputs</th><th class="l">Sensors</th><th>Wired V / C</th></tr></thead><tbody>';
            rows.forEach(function (a) {
                var hw = a.wiredVoltage + a.wiredCurrent > 0;
                var diff = a.inSurvey && hw && (a.wiredVoltage !== a.voltage || a.wiredCurrent !== a.current);
                var sensors = Object.keys(a.sensors || {}).sort().map(function (k) { return mpShort(k) + ' × ' + a.sensors[k]; });
                var locs = a.locations.length ? a.locations : a.wiredLocations;
                h += '<tr><td class="l"><b>' + locEsc(a.asset) + '</b>' + (a.inSurvey ? '' : '<div style="font-size:9px;color:var(--txl)">wired only</div>') + '</td>'
                   + '<td class="l">' + locEsc(a.assetType || '—') + '</td>'
                   + '<td class="l">' + mpInputs(locs) + (a.inSurvey && hw && a.wiredLocations.join() !== a.locations.join() ? '<div style="font-size:9px;color:var(--warn)">wired in ' + locEsc(a.wiredLocations.join(', ')) + '</div>' : '') + '</td>'
                   + '<td>' + (a.inSurvey ? a.voltage : a.wiredVoltage) + '</td><td>' + (a.inSurvey ? a.current : a.wiredCurrent) + '</td>'
                   + '<td class="l">' + mpInputs(a.voltageInputs) + '</td><td class="l">' + mpInputs(a.currentInputs) + '</td>'
                   + '<td class="l">' + mpInputs(sensors) + '</td>'
                   + '<td>' + (hw ? (diff ? '<span class="mp-gap">' + a.wiredVoltage + ' / ' + a.wiredCurrent + '</span>' : a.wiredVoltage + ' / ' + a.wiredCurrent) : '—') + '</td></tr>';
            });
            return h + '</tbody></table></div>';
        }

        function mpBomHtml() {
            var h = '<div style="overflow-x:auto;border:1px solid var(--bd);border-radius:7px"><table class="st mp-t"><thead><tr>'
               + '<th>#</th><th class="l">Material</th><th>Unit</th><th class="gh">Calculated</th><th class="gh">Spare</th><th class="gh">Required</th><th>Wired</th></tr></thead><tbody>';
            (__mp.bom || []).forEach(function (b) {
                h += '<tr><td class="dv">' + ('0' + b.no).slice(-2) + '</td><td class="l">' + locEsc(b.material) + '</td><td>' + locEsc(b.unit) + '</td>'
                   + '<td>' + b.calculated + '</td><td>' + b.spare + '</td><td><b>' + b.required + '</b></td><td>' + (b.actual == null ? '—' : b.actual) + '</td></tr>';
            });
            return h + '</tbody></table></div>';
        }

        function mpSensorHtml(keys) {
            var locs = __mp.locations || [], h = '';
            h += '<div style="overflow-x:auto;border:1px solid var(--bd);border-radius:7px"><table class="st mp-t"><thead><tr>'
              + '<th class="l">RF / Location</th><th>Type</th><th>Power</th><th class="gh">V</th><th class="gh">C</th><th class="gh">MintCard</th><th class="gh">C card</th><th class="gh">A10 / ADC</th>';
            keys.forEach(function (k) { h += '<th>' + locEsc(mpShort(k)) + '</th>'; });
            h += '<th>Wired V / C</th></tr></thead><tbody>';
            locs.forEach(function (l, i) {
                var p = l.plan, wired = l.clusterId ? (l.actualVoltage + ' / ' + l.actualCurrent) : '—';
                var mism = l.clusterId && (l.actualVoltage || l.actualCurrent) && (l.actualVoltage !== p.voltage || l.actualCurrent !== p.current);
                h += '<tr class="mp-row' + (i === __mpSel ? ' sel' : '') + '" onclick="mpSelect(' + i + ')">'
                   + '<td class="l"><i class="bi bi-chevron-right" style="font-size:10px;color:var(--txl)"></i> ' + p.rfCluster + ' / ' + locEsc(p.location)
                   + ((p.warnings || []).length ? ' <i class="bi bi-exclamation-triangle" style="color:var(--warn)" title="' + locEsc(p.warnings.join('\n')) + '"></i>' : '') + '</td>'
                   + '<td>' + locEsc(l.locationType || '—') + '</td><td>' + locEsc(l.power || '—') + '</td>'
                   + '<td>' + p.voltage + '</td><td>' + p.current + '</td><td>' + p.voltageCards + '</td><td>' + p.currentCards + '</td><td><b>' + p.a10 + '</b></td>';
                keys.forEach(function (k) {
                    var plan = (p.sensors || {})[k] || 0, act = (l.actualSensors || {})[k] || 0;
                    var show = plan || '';
                    if (l.clusterId && (l.actualVoltage || l.actualCurrent) && act !== plan) show = '<span class="mp-gap" title="Wired ' + act + ', planned ' + plan + '">' + act + ' / ' + plan + '</span>';
                    h += '<td>' + show + '</td>';
                });
                h += '<td>' + (mism ? '<span class="mp-gap">' + wired + '</span>' : wired) + '</td></tr>';
            });
            h += '</tbody><tfoot><tr><th class="l" colspan="3">Total</th>'
               + '<th>' + mpSum(function (l) { return l.plan.voltage; }) + '</th><th>' + mpSum(function (l) { return l.plan.current; }) + '</th>'
               + '<th>' + mpSum(function (l) { return l.plan.voltageCards; }) + '</th><th>' + mpSum(function (l) { return l.plan.currentCards; }) + '</th>'
               + '<th>' + mpSum(function (l) { return l.plan.a10; }) + '</th>';
            keys.forEach(function (k) { h += '<th>' + mpSum(function (l) { return (l.plan.sensors || {})[k]; }) + '</th>'; });
            h += '<th>' + mpSum(function (l) { return l.actualVoltage; }) + ' / ' + mpSum(function (l) { return l.actualCurrent; }) + '</th></tr></tfoot></table></div>'
               + '<div style="font-size:10px;color:var(--txl);margin-top:4px"><span class="mp-gap">2 / 3</span> = wired in Yard Config / planned from survey. Click a row to see why each item is there.</div>'
               + '<div id="mpDetail"></div>';
            return h;
        }

        function mpSelect(i) {
            var l = (__mp.locations || [])[i];
            if (!l) return;
            __mpSel = i;
            $('#mpBody .mp-row').removeClass('sel').eq(i).addClass('sel');
            var p = l.plan;
            var why = function (a, b) { return '<div class="mp-why"><span>' + a + '</span><span>' + b + '</span></div>'; };
            var left = '<div><h6>RF ' + p.rfCluster + ' / ' + locEsc(p.location) + '</h6>'
                + '<div style="font-size:10px;color:var(--txm);margin-bottom:6px">' + locEsc([l.locationType, l.power, p.side ? 'Side ' + p.side : '', p.distanceFromRR ? p.distanceFromRR + ' from RR' : ''].filter(Boolean).join(' · ')) + '</div>'
                + why('Voltage card (MintCard) × ' + p.voltageCards, p.voltage + ' voltage on lines 1–8' + (p.axleVoltageCards ? ' · ' + p.axleVoltageCards + ' axle-counter card(s), 9–10 blank' : ''))
                + why('Current card × ' + p.currentCards, p.currentOnVoltageCards + ' current on MintCard 9–10, ' + (p.current - p.currentOnVoltageCards) + ' on current cards')
                + why('A10 × ' + p.a10 + ' · ADC × ' + p.adc, '1 per card')
                + why('Conductors × ' + p.conductor, '2V + C + 2')
                + why('Spare pins', p.spareVoltagePins + ' V · ' + p.spareCurrentPins + ' C');
            (l.gaps || []).forEach(function (g) { left += '<div class="mp-warn"><i class="bi bi-arrow-left-right me-1"></i>' + locEsc(g) + '</div>'; });
            (p.warnings || []).forEach(function (w) { left += '<div class="mp-warn"><i class="bi bi-exclamation-triangle me-1"></i>' + locEsc(w) + '</div>'; });
            left += '</div>';

            var byAsset = {};
            (p.points || []).forEach(function (pt) { (byAsset[pt.asset] = byAsset[pt.asset] || []).push(pt); });
            var right = '<div><h6>Sensor points (' + (p.points || []).length + ')</h6><div style="max-height:260px;overflow:auto"><table class="st mp-t"><thead><tr><th class="l">Gear</th><th class="l">Attribute</th><th>Kind</th><th>Sensor</th></tr></thead><tbody>';
            Object.keys(byAsset).forEach(function (a) {
                byAsset[a].forEach(function (pt, j) {
                    right += '<tr><td class="l">' + (j === 0 ? '<b>' + locEsc(a) + '</b>' : '') + '</td><td class="l">' + locEsc(pt.title) + '</td><td>' + locEsc(pt.kind) + '</td><td>' + locEsc(pt.type) + '</td></tr>';
                });
            });
            if (!(p.points || []).length) right += '<tr><td colspan="4" style="color:var(--txm)">' + (l.hasSurvey ? 'No gear in this survey row' : 'No survey row') + '</td></tr>';
            right += '</tbody></table></div>';
            if ((l.wiredPoints || []).length) {
                right += '<h6 style="margin-top:10px">Wired in Yard Config (' + l.wiredPoints.length + ' · ' + locEsc(l.wiredTypeCard || '') + ')</h6><div style="max-height:220px;overflow:auto"><table class="st mp-t"><thead><tr><th class="l">Card / line</th><th class="l">Asset</th><th class="l">Attribute</th><th>Kind</th></tr></thead><tbody>';
                l.wiredPoints.forEach(function (w) {
                    right += '<tr><td class="l">' + locEsc(w.card) + ' / ' + w.line + '</td><td class="l">' + locEsc(w.asset) + '</td><td class="l">' + locEsc(w.title)
                           + (w.inMapping ? '' : ' <span style="font-size:9px;color:var(--txl)">(not in mapping)</span>') + '</td><td>' + locEsc(w.kind) + '</td></tr>';
                });
                right += '</tbody></table></div>';
            }
            right += '</div>';
            $('#mpDetail').html('<div class="mp-det">' + left + right + '</div>');
        }

        function mpOpenReport() {
            var siteId = mpSite();
            if (!siteId) { E7.warn('Select a station first.'); return; }
            window.open('@Url.Action("MaterialReport", "Station")?siteId=' + siteId + '&spare=' + mpSpare(), '_blank');
        }

        // Styled .xlsx built on the server (StationController.MaterialExcel)
        function mpExportExcel() {
            var siteId = mpSite();
            if (!siteId) { E7.warn('Select a station first.'); return; }
            window.location.href = '@Url.Action("MaterialExcel", "Station")?siteId=' + siteId + '&spare=' + mpSpare();
        }

                 // ── State ─────────────────────────────────────────────────────────────────
        var __masterAssetTypes   = [];
        var __siteAssetTypes     = [];
        var __currentSiteId      = 0;
        var __cardLineTypeCounts = {};
        var __cardLines          = [];
        var __siteAssets         = [];      // all assets of the station (Asset API)
        var __siteAssetsLoaded   = false;
        var __savedTypeIdsBySite = {};   // { siteId: [typeId, typeId, ...] } — cleared on refresh
        var __savedTypeNamesBySite = {};

        // ── Selection helpers (in-memory, per page load) ──────────────────────────
        function getSavedTypeIds(siteId) {
            return __savedTypeIdsBySite[siteId] || null;
        }
        function saveTypeIds(siteId, ids) {
            __savedTypeIdsBySite[siteId] = ids;
        }

        // ── Also clear any legacy cookies from earlier testing ────────────────────
        (function clearLegacyCookies() {
            document.cookie.split(';').forEach(function (c) {
                var name = c.split('=')[0].trim();
                if (name.indexOf('assetTypes_') === 0) {
                    document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
                }
            });
        })();

        // ── Field helpers (tolerant of casing differences) ────────────────────────
        function typeId(t)   { return t.id ?? t.assetTypeId ?? 0; }
        function typeName(t) { return t.name ?? t.assetTypeName ?? 'Unknown'; }
        function typeCount(t){ return t.assetCount ?? t.count ?? 0; }
        function typeUnver(t){ return t.unverifiedCount ?? t.unverified ?? 0; }

        // ── Load both datasets, then render sidebar ───────────────────────────────
                          function loadAssetTypes(siteId) {
            __currentSiteId = siteId;
            $('#atList').html('<li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">Loading…</li>');

            // Site-scoped list (primary source for sidebar)
            var pSite = $.ajax({
                url: '/Station/GetAllAssetTypeById',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify([siteId])
            });

            // Master list (used only for the offcanvas checklist)
            var pMaster = $.ajax({
                url: '/Station/GetAllAssetType',
                type: 'GET'
            });

            $.when(pSite, pMaster).done(function (siteRes, masterRes) {
                __siteAssetTypes   = (siteRes[0]   && !siteRes[0].error)   ? siteRes[0]   : [];
                __masterAssetTypes = (masterRes[0] && !masterRes[0].error) ? masterRes[0] : [];
                renderAssetTypeSidebar();
            }).fail(function () {
                $('#atList').html('<li style="padding:12px;text-align:center;color:var(--err);font-size:11px">Failed to load</li>');
            });
        }

        // A station change calls this from three async callbacks in quick succession, which
        // redrew the asset sidebar three times and made it flicker. Coalesce the burst into
        // one draw on the next frame, using whatever data has arrived by then.
        var __sbTimer = null;
        function renderAssetTypeSidebar() {
            clearTimeout(__sbTimer);
            __sbTimer = setTimeout(function () { __sbTimer = null; renderSidebarNow(); }, 45);
        }
        function renderSidebarNow() {
            var $list = $('#atList');
            var saved = getSavedTypeIds(__currentSiteId);
            var savedNames = (__savedTypeNamesBySite && __savedTypeNamesBySite[__currentSiteId]) || {};

            var toShow;
            if (saved && saved.length) {
                // Build list from saved IDs — merge name from savedNames first,
                // fall back to __siteAssetTypes, fall back to __masterAssetTypes
                toShow = saved.map(function (id) {
                    // try site types first
                    var found = __siteAssetTypes.find(function (t) { return typeId(t) === id; });
                    if (!found && __masterAssetTypes.length) {
                        found = __masterAssetTypes.find(function (t) { return typeId(t) === id; });
                    }
                    // if still not found, build a minimal object from the saved name
                    if (!found) {
                        found = { id: id, name: savedNames[id] || ('Type ' + id), assetCount: 0 };
                    }
                    return found;
                });
            } else {
                toShow = __siteAssetTypes;
            }

            if (!toShow.length) {
                $list.html('<li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">No asset types for this site</li>');
                $('#tabAssetCount').text(0);
                return;
            }

            var totalAssets = 0;
            var html = '';

            $.each(toShow, function (i, t) {
                var id     = typeId(t);
                var name   = typeName(t);
                var clInfo = __cardLineTypeCounts[id];
                var count  = __siteAssetsLoaded ? siteAssetCount(id) : (clInfo ? clInfo.count : typeCount(t));
                var unver  = typeUnver(t);

                totalAssets += count;
                var isFirst  = (i === 0) ? ' on' : '';
                var unvBadge = unver > 0 ? '<span class="ae">' + unver + '?</span>' : '';

                html += '<li class="ati' + isFirst + '" data-type-id="' + id + '" data-type-name="' + name + '">'
