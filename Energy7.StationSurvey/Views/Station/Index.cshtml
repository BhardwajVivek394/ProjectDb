        // ── Station change → load CardLine stats ──────────────────────────────────────
        function onStationChange(siteId) {
            debugger;
            var stationName  = $('#ddStation option:selected').text();
            var zoneName     = $('#ddZone option:selected').text();
            var divisionName = $('#ddDivision option:selected').text();

            if (!siteId || siteId == 0) { resetStats(); return; }

            // Update info panel immediately
            $('#infoName').text(stationName);
            $('#infoZoneDiv').text(zoneName + ' / ' + divisionName);
            $('#stationInfo').text(zoneName + ' · ' + divisionName + ' · ' + stationName);

            // Show loading state
            ['statLocations','statClusters','statDataPoints','statAssets'].forEach(function(id) {
                $('#' + id).html('<i class="bi bi-arrow-clockwise" style="font-size:14px;animation:spin .7s linear infinite"></i>');
            });

            // Call CardLine API via controller
            $.ajax({
                url: '@Url.Action("GetCardLineBySiteId", "Station")',
                data: { siteId: siteId },
                success: function (data) {
                    if (!data || data.error) { resetStats(); return; }
                    bindStats(data);
