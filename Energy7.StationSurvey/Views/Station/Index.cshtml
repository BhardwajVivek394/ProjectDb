@{
    ViewData["Title"] = "Station Survey";
}

<!-- ═══ FILTER BAR ═══ -->
<div class="sbar">
    <div class="fg">
        <label>Zone</label>
        <select id="ddZone" asp-items="ViewBag.Zones" onchange="onZoneChange(this.value)">
        </select>
    </div>
    <div class="fg">
        <label>Division</label>
        <select id="ddDivision" asp-items="ViewBag.Divisions" onchange="onDivisionChange(this.value)">
        </select>
    </div>
    <div class="fg">
        <label>Station</label>
        <select id="ddStation" asp-items="ViewBag.Sites" onchange="onStationChange(this.value)">
        </select>
        <button class="bg7" id="btnEditStation" title="Edit station" disabled
                onclick="openStationModal($('#ddStation').val())"><i class="bi bi-pencil-square"></i> Edit</button>
    </div>
    <div class="dv"></div>
    <div class="sbadge"><span class="dot"></span><span id="badgeStatus">Select Station</span></div>
    <span style="font-size:10px;color:var(--txl);margin-left:6px" id="stationInfo"></span>
</div>

<!-- ═══ TABS ═══ -->
<div class="etabs">
    <div class="etab on" data-tab="overview"><i class="bi bi-grid" style="font-size:13px"></i> Overview</div>
    <div class="etab" data-tab="assets"><i class="bi bi-cpu" style="font-size:13px"></i> Assets <span class="tc" id="tabAssetCount">—</span></div>
    <div class="etab" data-tab="location"><i class="bi bi-geo-alt" style="font-size:13px"></i> Location <span class="tc" id="tabLocationCount">—</span></div>
    <div class="etab" data-tab="yard"><i class="bi bi-diagram-3" style="font-size:13px"></i> Yard Config</div>
    <div class="etab" data-tab="material"><i class="bi bi-box-seam" style="font-size:13px"></i> Material</div>
    <div class="etab" data-tab="documents"><i class="bi bi-file-earmark-check" style="font-size:13px"></i> Documents</div>
</div>

<!-- ═══ TAB CONTENT ═══ -->
<div class="econt">

    <!-- ── OVERVIEW ── -->
    <div class="tp on" id="tab-overview">
        <div class="sgrid">
            <div class="sc acc">
                <div class="sl">Total Locations</div>
                <div class="sv" id="statLocations">—</div>
                <div class="ss" id="statLocationsSub">Select a station</div>
            </div>
            <div class="sc">
                <div class="sl">Total Clusters</div>
                <div class="sv" id="statClusters">—</div>
                <div class="ss" id="statClustersSub">—</div>
            </div>
            <div class="sc">
                <div class="sl">Total Data Points</div>
                <div class="sv" id="statDataPoints">—</div>
                <div class="ss" id="statDataPointsSub">—</div>
            </div>
            <div class="sc">
                <div class="sl">Total Assets</div>
                <div class="sv" id="statAssets">—</div>
                <div class="ss" id="statAssetsSub">—</div>
            </div>
            <div class="sc">
                <div class="sl">TDC Countdown</div>
                <div class="sv" style="color:var(--err)">3d</div>
                <div class="ss">Expires: 28 Mar 2026</div>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="ic">
                    <h6><i class="bi bi-building"></i> Station Information</h6>
                    <div class="ir"><span class="il">Station Name</span><span class="iv" id="infoName">—</span></div>
                    <div class="ir"><span class="il">Station Code</span><span class="iv" id="infoCode">—</span></div>
                    <div class="ir"><span class="il">Zone / Division</span><span class="iv" id="infoZoneDiv">—</span></div>
                    <div class="ir"><span class="il">FRS Year</span><span class="iv">2026</span></div>
                    <div class="ir"><span class="il">Start Date</span><span class="iv">15-Nov-2025</span></div>
                    <div class="ir"><span class="il">Stage</span><span class="iv" style="color:var(--co);font-weight:600">Execution</span></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="ic">
                    <h6><i class="bi bi-exclamation-triangle"></i> Dependencies</h6>
                    <div style="margin-bottom:8px">
                        <div style="font-size:10px;font-weight:700;color:var(--err);text-transform:uppercase;margin-bottom:4px">E7</div>
                        <div style="font-size:11px;line-height:1.7">A10 — 80 pcs · Antenna — 80 pcs · AI Card pending</div>
                    </div>
                    <div>
                        <div style="font-size:10px;font-weight:700;color:var(--warn);text-transform:uppercase;margin-bottom:4px">Railway</div>
                        <div style="font-size:11px;line-height:1.7">2 Cluster space N/A · 17 Cluster 110V PS issue</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SURVEY stage checklist — all items ticked marks the stage Completed -->
        <div class="ic" id="surveyCard" style="margin-top:12px">
            <h6 style="display:flex;align-items:center;gap:8px">
                <i class="bi bi-clipboard-check"></i> Survey Stage Checklist
                <span id="surveyProgress" style="font-size:11px;font-weight:600;color:var(--txm)"></span>
                <span id="surveyStageBadge" style="margin-left:auto;font-size:10px;font-weight:700;padding:3px 8px;border-radius:10px"></span>
            </h6>
            <div style="height:5px;background:var(--bd);border-radius:3px;overflow:hidden;margin:4px 0 10px">
                <div id="surveyBar" style="height:100%;width:0;background:var(--ok);transition:width .2s"></div>
            </div>
            <div id="surveyList" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:4px 20px;font-size:12px">
                <div style="color:var(--txm);font-size:11px">Select a station</div>
            </div>
        </div>
    </div>

    <!-- ── ASSETS ── -->
    <div class="tp" id="tab-assets">
        <div class="alay">
            <div class="asb">
                <div class="asb-h">
                    <h6>Asset Types</h6>
                    <button class="be7" style="padding:2px 8px;font-size:10px"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#addTypeOC"
                            title="Configure Asset Types">
                        <i class="bi bi-plus"></i>
                    </button>
                </div>
                <div class="offcanvas offcanvas-end" tabindex="-1" id="addTypeOC" data-bs-backdrop="false" data-bs-scroll="true">
                    <div class="offcanvas-header" style="border-bottom:1px solid var(--bd)">
                        <h5 class="offcanvas-title" style="font-size:13px;font-weight:700">
                            Configure Asset Types
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                    </div>
                    <div class="offcanvas-body" style="font-size:12px">
                        <div id="assetTypeConfigList">
                            <div style="padding:12px;text-align:center;color:var(--txm)">Loading…</div>
                        </div>
                        <div style="position:sticky;bottom:0;padding:10px 0;background:#fff">
                            <button class="be7 w-100" onclick="saveAssetTypeConfig()">Save</button>
                        </div>
                    </div>
                </div>
                <ul class="atl" id="atList">
                    <li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">Select a station</li>
                </ul>
            </div>
            <div class="adp">
                <div class="adp-h">
                    <h6 id="adTitle">DC Tracks</h6>
                    <span style="font-size:10px;color:var(--txm)">35 assets · 8 unverified</span>
                </div>
                <div class="aig">
                    <div class="aic">
                        <div class="ct" id="assetListTitle">Track Name</div>
                        <div class="ais">
                            <div class="adi">
                                <input type="text" placeholder="Add name" id="newTrackIn">
                                <button onclick="openAddAssetModal()" title="Add Asset"><i class="bi bi-plus"></i></button>
                            </div>
                            <div id="trackList">
                                <div class="fot-group" data-fot="1T">
                                    <div class="fot-parent sel" draggable="true" data-track="1T" onclick="selTrack(this,'1T')" ondragover="fotDragOver(event,this)" ondragleave="fotDragLeave(this)" ondrop="fotDrop(event,this)">
                                        <span class="fot-icon open">&#9654;</span><span>1T</span><span class="fot-badge">FOT 3</span>
                                    </div>
                                    <div class="fot-children open">
                                        <div class="fot-child" onclick="selTrack(this,'2T')"><span class="fc-line"></span>2T<span class="fc-tag">adj.</span><span class="fc-rm" onclick="event.stopPropagation();unfot(this)">&times;</span></div>
                                        <div class="fot-child" onclick="selTrack(this,'3T')"><span class="fc-line"></span>3T<span class="fc-tag">adj.</span><span class="fc-rm" onclick="event.stopPropagation();unfot(this)">&times;</span></div>
                                    </div>
                                </div>
                                <div class="air" draggable="true" data-track="118T" onclick="selTrack(this,'118 T')" ondragover="fotDragOver(event,this)" ondragleave="fotDragLeave(this)" ondrop="fotDrop(event,this)">118 T</div>
                                <div class="air" draggable="true" data-track="02AT" onclick="selTrack(this,'02 AT')" ondragover="fotDragOver(event,this)" ondragleave="fotDragLeave(this)" ondrop="fotDrop(event,this)">02 AT</div>
                            </div>
                        </div>
                    </div>
                    <div class="atp">
                        <div class="ath">
                            <span class="an" id="selAN">—</span>
                            <span class="pl on" id="selAssetTypeTag">—</span>
                            <span class="pl" id="selAssetSubTag">Type</span>
                        </div>
                        <div class="mode-bar">
                            <span class="mode-lbl on" id="maL">Section-level LOC</span>
                            <label class="mtog"><input type="checkbox" id="modeTog" onchange="switchMode(this.checked)"><span class="mtog-sl"></span></label>
                            <span class="mode-lbl" id="mbL">Individual LOC</span>
                        </div>
                        <div id="modeA">
                            <div class="ats">
                                <div class="ats-t">
                                    TF End
                                    <select class="loc-s loc-dd" style="margin-left:4px" onchange="this.nextElementSibling.textContent=this.value"><option>LOC-1</option><option>LOC-2</option><option>LOC-3</option><option>CRR</option></select>
                                    <span class="lb" style="background:var(--info)">LOC-1</span>
                                    <label class="stog" style="margin-left:auto"><input type="checkbox" checked onchange="togG(this,'tfA')"><span class="stog-sl"></span></label>
                                </div>
                                <div class="ar"><input type="checkbox" checked data-g="tfA"><span class="aname">CHG I/P V</span><input class="rt-inp" placeholder="Row"><input class="rt-inp" placeholder="Trm"><button class="sv-btn" onclick="svA(this)">Save</button></div>
                                <div class="ar"><input type="checkbox" checked data-g="tfA"><span class="aname">CHG O/P V</span><input class="rt-inp" placeholder="Row"><input class="rt-inp" placeholder="Trm"><button class="sv-btn" onclick="svA(this)">Save</button></div>
                                <div class="ar"><input type="checkbox" checked data-g="tfA"><span class="aname">TF V</span><input class="rt-inp" placeholder="Row"><input class="rt-inp" placeholder="Trm"><button class="sv-btn" onclick="svA(this)">Save</button></div>
                            </div>
                            <div class="ats">
                                <div class="ats-t">
                                    TR End
                                    <select class="loc-s loc-dd" style="margin-left:4px" onchange="this.nextElementSibling.textContent=this.value"><option>LOC-1</option><option selected>LOC-2</option><option>LOC-3</option><option>CRR</option></select>
                                    <span class="lb" style="background:var(--info)">LOC-2</span>
                                    <label class="stog" style="margin-left:auto"><input type="checkbox" checked onchange="togG(this,'trA')"><span class="stog-sl"></span></label>
                                </div>
                                <div class="ar"><input type="checkbox" checked data-g="trA"><span class="aname">TR V</span><input class="rt-inp" placeholder="Row"><input class="rt-inp" placeholder="Trm"><button class="sv-btn" onclick="svA(this)">Save</button></div>
                                <div class="ar"><input type="checkbox" checked data-g="trA"><span class="aname">TR mA</span><input class="rt-inp" placeholder="Row"><input class="rt-inp" placeholder="Trm"><button class="sv-btn" onclick="svA(this)">Save</button></div>
                            </div>
                        </div>
                        <div id="modeB" style="display:none">
                            <div class="ats">
                                <div class="ats-t">TF End<label class="stog" style="margin-left:auto"><input type="checkbox" checked onchange="togG(this,'tfB')"><span class="stog-sl"></span></label></div>
                                <div class="ar"><input type="checkbox" checked data-g="tfB"><span class="aname">CHG I/P V</span><input class="rt-inp" placeholder="Row"><input class="rt-inp" placeholder="Trm"><select class="loc-s-sm loc-dd"><option>LOC-1</option><option>LOC-2</option><option>LOC-3</option><option>CRR</option></select><button class="sv-btn" onclick="svA(this)">Save</button></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── LOCATION ── -->
    <div class="tp" id="tab-location">
        <!-- Location = a Cluster row named "cluster_{RF no}/{location}", same as 90 Yard Config → Create Cluster.
             RF cluster boxes group the locations sharing one RF cluster number. Cards / modem are set up in Yard Config. -->
        <div class="loc-top">
            <div class="cr-box">
                <h6><i class="bi bi-plus-circle"></i> Create Location</h6>
                <div class="cr-row">
                    <input type="text" id="locNewName" placeholder="Location name e.g. LOC-65">
                    <select id="locNewType"><option value="2">Outdoor</option><option value="1">Indoor</option></select>
                    <select id="locNewPower" title="Power supply">
                        <option value="">Power supply</option>
                        <option value="1">24 V</option>
                        <option value="2">110 V</option>
                        <option value="3">Converter 110→24 V</option>
                    </select>
                    <select id="locNewRf" title="RF cluster"></select>
                    <button class="be7" style="padding:5px 12px" onclick="createLocation()">Add</button>
                </div>
            </div>
            <div class="cr-box">
                <h6><i class="bi bi-diagram-2"></i> Create RF Cluster</h6>
                <div class="cr-row">
                    <select id="locNewCluster" style="flex:1"></select>
                    <button class="be7" style="padding:5px 12px" onclick="addRfClusterBox()">Add</button>
                </div>
                <div style="font-size:10px;color:var(--txm);margin-top:6px">An empty RF cluster is saved once a location is added or dragged into it.</div>
            </div>
        </div>
        <div class="loc-layout">
            <div class="loc-pool">
                <h6>Without RF Cluster</h6>
                <div id="locPool"><div style="font-size:10px;color:var(--txl)">Select a station</div></div>
            </div>
            <div class="clust-area" id="locClusters">
                <div style="font-size:11px;color:var(--txm)">Select a station</div>
            </div>
        </div>

        <!-- Survey gear mapping (before yard) — existing SiteSurvey table, same grid as the 90 Site Survey page -->
        <div class="cr-box" style="margin-top:14px">
            <h6 style="display:flex;align-items:center;gap:8px">
                <i class="bi bi-signpost-split"></i> Survey Gear Mapping (before Yard Config)
                <button class="be7" style="margin-left:auto;padding:4px 12px" onclick="addGearRow()"><i class="bi bi-plus"></i> Add Location Box</button>
            </h6>
            <div style="font-size:10px;color:var(--txm);margin-bottom:8px">
                One row per location box. Enter gear names separated by commas, e.g. TR: <b>1T, 2T</b>. Names are saved in upper case, like on the 90 site.
            </div>
            <div style="overflow-x:auto">
                <table class="table table-sm" style="font-size:11px;margin:0;min-width:1100px">
                    <thead>
                        <tr style="color:var(--txm)">
                            <th style="width:60px">RF Cl.</th><th style="width:110px">Location Box</th><th style="width:70px">Side</th>
                            <th style="width:80px">Dist. RR</th><th>TR</th><th>TF</th><th>Point Machine</th><th>Signal</th>
                            <th>Axle Counter</th><th>Bus Bar</th><th>UFSBI</th><th>BHMS</th><th style="width:90px"></th>
                        </tr>
                    </thead>
                    <tbody id="gearBody"><tr><td colspan="13" style="color:var(--txm)">Select a station</td></tr></tbody>
                </table>
            </div>
            <datalist id="gearLocList"></datalist>
            <div id="gearCoverage" style="font-size:11px;margin-top:8px"></div>
        </div>

        <!-- Edit location -->
        <div class="modal fade" id="locEditModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-geo-alt me-2" style="color:var(--co)"></i>Edit Location</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="locEditId">
                        <div class="row g-3">
                            <div class="col-12">
                                <label>Location Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="locEditName">
                            </div>
                            <div class="col-6">
                                <label>Type</label>
                                <select class="form-select" id="locEditType"><option value="2">Outdoor</option><option value="1">Indoor</option></select>
                            </div>
                            <div class="col-6">
                                <label>RF Cluster</label>
                                <select class="form-select" id="locEditRf"></select>
                            </div>
                            <div class="col-12">
                                <label>Power Supply</label>
                                <select class="form-select" id="locEditPower">
                                    <option value="">Not set</option>
                                    <option value="1">24 V</option>
                                    <option value="2">110 V</option>
                                    <option value="3">Converter 110 to 24 V</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--bd);padding:10px 18px">
                        <button class="bg7" data-bs-dismiss="modal">Cancel</button>
                        <button class="be7" onclick="saveEditedLocation()">Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── YARD CONFIG ── -->
    <div class="tp" id="tab-yard">
        <div class="yg">
            <div class="yi">
                <div class="yn">Platform 1 Up Line</div>
                <div class="yc"><input type="checkbox" checked><span>Signal A1</span></div>
                <div class="yc"><input type="checkbox" checked><span>Track 1T</span></div>
                <div class="yc"><input type="checkbox"><span>Signal A2</span></div>
                <div class="yc"><input type="checkbox" checked><span>PM-01</span></div>
            </div>
            <div class="yi">
                <div class="yn">Platform 2 Down Line</div>
                <div class="yc"><input type="checkbox" checked><span>Signal B1</span></div>
                <div class="yc"><input type="checkbox" checked><span>Track 2T</span></div>
                <div class="yc"><input type="checkbox"><span>PM-02</span></div>
            </div>
        </div>
    </div>

    <!-- ── MATERIAL ── -->
    <div class="tp" id="tab-material">
        <div class="stw" id="survCont">
            <div class="stw-h">
                <h6>Material Register</h6>
                <div style="display:flex;gap:6px">
                    <button class="bg7" id="fsBtn"><i class="bi bi-fullscreen"></i></button>
                    <button class="be7"><i class="bi bi-download me-1"></i>Export</button>
                </div>
            </div>
            <div style="overflow-x:auto">
                <table class="st">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Material</th>
                            <th>Unit</th>
                            <th class="gh">Planned</th>
                            <th class="gh">Consumed</th>
                            <th class="gh">Remaining</th>
                            <th>Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td class="dv">01</td><td>A10 Unit</td><td>Pcs</td><td>80</td><td>45</td><td>35</td><td><div class="mb"><div class="mb-f" style="width:56%"></div></div></td></tr>
                        <tr><td class="dv">02</td><td>Antenna</td><td>Pcs</td><td>80</td><td>30</td><td>50</td><td><div class="mb"><div class="mb-f w" style="width:37%"></div></div></td></tr>
                        <tr><td class="dv">03</td><td>AI Card</td><td>Pcs</td><td>35</td><td>0</td><td>35</td><td><div class="mb"><div class="mb-f d" style="width:0%"></div></div></td></tr>
                        <tr><td class="dv">04</td><td>Cable (50m)</td><td>Rolls</td><td>20</td><td>18</td><td>2</td><td><div class="mb"><div class="mb-f" style="width:90%"></div></div></td></tr>
                        <tr><td class="dv">05</td><td>Junction Box</td><td>Pcs</td><td>64</td><td>55</td><td>9</td><td><div class="mb"><div class="mb-f" style="width:86%"></div></div></td></tr>
                    </tbody>
                    <tfoot>
                        <tr><th colspan="3">Total</th><th>279</th><th>148</th><th>131</th><th></th></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- ── DOCUMENTS ── -->
    <div class="tp" id="tab-documents">
        <div class="dl">
            <div class="di"><div class="dn">01</div><div class="dm">Site Survey Report</div><div class="ds ok">Prepared</div></div>
            <div class="di"><div class="dn">02</div><div class="dm">Location Layout Drawing</div><div class="ds pn">Required</div></div>
            <div class="di"><div class="dn">03</div><div class="dm">Asset Master List</div><div class="ds ok">Prepared</div></div>
            <div class="di"><div class="dn">04</div><div class="dm">Cable Schedule</div><div class="ds wk">In Progress</div></div>
            <div class="di"><div class="dn">05</div><div class="dm">FTU Configuration Sheet</div><div class="ds pn">Required</div></div>
            <div class="di"><div class="dn">06</div><div class="dm">Cluster Assignment Sheet</div><div class="ds ok">Prepared</div></div>
            <div class="di"><div class="dn">07</div><div class="dm">LOC Wiring Diagram</div><div class="ds wk">In Progress</div></div>
            <div class="di"><div class="dn">08</div><div class="dm">Testing Protocol</div><div class="ds na">N/A</div></div>
        </div>
    </div>

</div><!-- /econt -->
<!-- ══ ADD ASSET MODAL ══════════════════════════════════════════════════════ -->
<div class="modal fade" id="addAssetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:10px;border:none">
            <div class="modal-header" style="padding:12px 18px;border-bottom:1px solid var(--bd)">
                <h5 class="modal-title" id="addAssetModalTitle" style="font-size:14px;font-weight:700;margin:0">Add Asset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:16px 18px">
                <!-- Top fields: Name / Http Link / Number Of Cell / Is Active -->
                <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:12px;margin-bottom:14px;align-items:end">
                    <div>
                        <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">Name <span style="color:var(--err)">*</span></label>
                        <input type="text" id="assetModalName" class="form-control form-control-sm" placeholder="Asset name">
                    </div>
                    <div>
                        <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">Http Link</label>
                        <input type="text" id="assetModalHttp" class="form-control form-control-sm" placeholder="http://...">
                    </div>
                    <div style="display:flex;align-items:center;gap:6px;padding-bottom:6px">
                        <input type="checkbox" id="assetModalActive" checked style="accent-color:var(--co);width:14px;height:14px">
                        <label for="assetModalActive" style="font-size:12px;margin:0;cursor:pointer">Is Active</label>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:16px">
                    <div>
                        <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">Number Of Cell</label>
                        <input type="number" id="assetModalCells" class="form-control form-control-sm" placeholder="0">
                    </div>
                </div>

                <!-- Point Machine details (Asset columns, same fields as the 90 Add Asset for Point Machine) -->
                <div id="assetModalPM" style="display:none;border:1px solid var(--bd);border-radius:7px;padding:10px 12px;margin-bottom:14px">
                    <div style="font-size:10px;font-weight:700;color:var(--co);text-transform:uppercase;margin-bottom:8px">Point Machine Details</div>
                    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px">
                        <div>
                            <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">Full / Half</label>
                            <select id="pmHalf" class="form-select form-select-sm"><option value="0">Full</option><option value="1">Half</option></select>
                        </div>
                        <div>
                            <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">Operation</label>
                            <select id="pmSeries" class="form-select form-select-sm" onchange="pmToggle()"><option value="0">Parallel</option><option value="1">Series</option></select>
                        </div>
                        <div class="pm-series">
                            <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">Series Type</label>
                            <select id="pmSeriesType" class="form-select form-select-sm"><option value="1">LH</option><option value="2">RH</option></select>
                        </div>
                        <div>
                            <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">Switch (IRS / TWS)</label>
                            <select id="pmTws" class="form-select form-select-sm" onchange="pmToggle()">
                                <option value="0">IRS</option>
                                <option value="1">TWS – A-End</option>
                                <option value="2">TWS – B-End</option>
                                <option value="3">TWS – Both</option>
                            </select>
                        </div>
                        <div class="pm-series" style="grid-column:span 2">
                            <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">A-End (Direction A)</label>
                            <input type="text" id="pmAliasA" class="form-control form-control-sm" placeholder="Direction A name">
                        </div>
                        <div class="pm-series" style="grid-column:span 2">
                            <label style="font-size:11px;font-weight:600;color:var(--txm);display:block;margin-bottom:4px">B-End (Direction B)</label>
                            <input type="text" id="pmAliasB" class="form-control form-control-sm" placeholder="Direction B name">
                        </div>
                    </div>
                </div>

                <!-- Sub-tabs, same as the 90 Add Asset (Signal Mapping only for Track) -->
                <ul class="nav nav-tabs" id="assetModalTabs" style="font-size:12px;margin-bottom:12px;border-bottom:1px solid var(--bd)">
                    <li class="nav-item"><button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#amConfig" style="font-size:12px;padding:6px 12px">Config</button></li>
                    <li class="nav-item" id="amSignalMapTab" style="display:none"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#amSignalMap" style="font-size:12px;padding:6px 12px">Signal Mapping</button></li>
                    <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#amAlerts" style="font-size:12px;padding:6px 12px">Alerts</button></li>
                    <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#amFRS" style="font-size:12px;padding:6px 12px">FRSAlerts</button></li>
                    <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#amCause" style="font-size:12px;padding:6px 12px">Cause Code Activation</button></li>
                </ul>

                <div class="tab-content" style="max-height:280px;overflow-y:auto">
                    <!-- Config: Attributes / Channels / Value / Multiplication -->
                    <div class="tab-pane fade show active" id="amConfig">
                        <table class="table table-sm" style="font-size:12px;margin-bottom:0">
                            <thead style="position:sticky;top:0;background:#fff;z-index:1">
                                <tr style="border-bottom:1px solid var(--bd)">
                                    <th style="font-weight:600;color:var(--txm);width:30%">Attributes</th>
                                    <th style="font-weight:600;color:var(--txm);width:30%">Channels</th>
                                    <th style="font-weight:600;color:var(--txm);width:20%">Value</th>
                                    <th style="font-weight:600;color:var(--txm);width:20%">Multiplication</th>
                                </tr>
                            </thead>
                            <tbody id="assetConfigBody">
                                <tr>
                                    <td colspan="4" style="text-align:center;color:var(--txm);padding:20px">
                                        <i class="bi bi-arrow-clockwise" style="animation:spin .7s linear infinite"></i> Loading attributes…
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Signal Mapping (Track): signals of this station linked to the track -->
                    <div class="tab-pane fade" id="amSignalMap">
                        <table class="table table-sm" style="font-size:12px;margin-bottom:0">
                            <thead style="position:sticky;top:0;background:#fff;z-index:1"><tr><th style="font-weight:600;color:var(--txm)">Signals</th></tr></thead>
                            <tbody id="amSignalMapBody"></tbody>
                        </table>
                    </div>
                    <!-- Alerts: active / alert name / operator / value -->
                    <div class="tab-pane fade" id="amAlerts">
                        <table class="table table-sm" style="font-size:12px;margin-bottom:0">
                            <thead style="position:sticky;top:0;background:#fff;z-index:1">
                                <tr>
                                    <th style="width:40px"></th>
                                    <th style="font-weight:600;color:var(--txm)">Alert Name</th>
                                    <th style="font-weight:600;color:var(--txm);width:30%">Operators</th>
                                    <th style="font-weight:600;color:var(--txm);width:25%">Value</th>
                                </tr>
                            </thead>
                            <tbody id="amAlertsBody"></tbody>
                        </table>
                    </div>
                    <!-- FRS Alerts: ranges per attribute -->
                    <div class="tab-pane fade" id="amFRS">
                        <table class="table table-sm" style="font-size:12px;margin-bottom:0">
                            <thead style="position:sticky;top:0;background:#fff;z-index:1">
                                <tr>
                                    <th style="font-weight:600;color:var(--txm)">Attributes</th>
                                    <th style="font-weight:600;color:var(--txm)">Max Safe Value</th>
                                    <th style="font-weight:600;color:var(--txm)">Average Value</th>
                                    <th style="font-weight:600;color:var(--txm)">Min Safe Value</th>
                                    <th style="font-weight:600;color:var(--txm)">Min Fail Value</th>
                                </tr>
                            </thead>
                            <tbody id="amFRSBody"></tbody>
                        </table>
                    </div>
                    <!-- Cause Code Activation -->
                    <div class="tab-pane fade" id="amCause">
                        <table class="table table-sm" style="font-size:12px;margin-bottom:0">
                            <thead style="position:sticky;top:0;background:#fff;z-index:1">
                                <tr>
                                    <th style="font-weight:600;color:var(--txm)">Cause Code</th>
                                    <th style="font-weight:600;color:var(--txm);width:80px;text-align:center">Active</th>
                                </tr>
                            </thead>
                            <tbody id="amCauseBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="padding:10px 18px;border-top:1px solid var(--bd)">
                <button type="button" class="btn btn-sm" style="border:1px solid var(--bd);color:var(--txm);padding:5px 16px" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm be7" style="padding:5px 16px" onclick="saveAssetFromModal()">Save</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        // ── Zone → Division cascade ───────────────────────────────────────────────────
        function onZoneChange(zoneId) {
            $.ajax({
                url: '@Url.Action("GetDivisionByZoneId", "Station")',
                data: { zoneId: zoneId },
                success: function (data) {
                    var dd = $('#ddDivision');
                    dd.empty().append('<option value="0">Select Division</option>');
                    $.each(data, function (i, d) {
                        dd.append('<option value="' + d.id + '">' + d.name + '</option>');
                    });
                    $('#ddStation').empty().append('<option value="0">Select Station</option>');
                    resetStats();
                }
            });
        }

        // ── Division → Station cascade ────────────────────────────────────────────────
        function onDivisionChange(divisionId) {
            $.ajax({
                url: '@Url.Action("GetSiteByDivisionId", "Station")',
                data: { divisionId: divisionId },
                success: function (data) {
                    var dd = $('#ddStation');
                    dd.empty().append('<option value="0">Select Station</option>');
                    $.each(data, function (i, s) {
                        dd.append('<option value="' + s.id + '">' + s.name + '</option>');
                    });
                    resetStats();
                }
            });
        }

        // ── Station change → load CardLine stats ──────────────────────────────────────
        function onStationChange(siteId) {
            debugger;
            var stationName  = $('#ddStation option:selected').text();
            var zoneName     = $('#ddZone option:selected').text();
            var divisionName = $('#ddDivision option:selected').text();

            $('#btnEditStation').prop('disabled', !siteId || siteId == 0);
            if (!siteId || siteId == 0) {
                resetStats();
                $('#surveyList').html('<div style="color:var(--txm);font-size:11px">Select a station</div>');
                $('#surveyProgress, #surveyStageBadge').text('').css('background', '');
                $('#surveyBar').css('width', 0);
                __locSiteId = 0; __locations = [];
                $('#locClusters').html('<div style="font-size:11px;color:var(--txm)">Select a station</div>');
                $('#locPool').html('<div style="font-size:10px;color:var(--txl)">Select a station</div>');
                return;
            }

            // Update info panel immediately
            $('#infoName').text(stationName);
            $('#infoZoneDiv').text(zoneName + ' / ' + divisionName);
            $('#stationInfo').text(zoneName + ' · ' + divisionName + ' · ' + stationName);

            // Show loading state
            ['statLocations','statClusters','statDataPoints','statAssets'].forEach(function(id) {
                $('#' + id).html('<i class="bi bi-arrow-clockwise" style="font-size:14px;animation:spin .7s linear infinite"></i>');
            });

            // Call CardLine API via controller
            $.ajax({
                url: '@Url.Action("GetCardLineBySiteId", "Station")',
                data: { siteId: siteId },
                success: function (data) {
                    if (!data || data.error) { resetStats(); return; }
                    bindStats(data);
                },
                error: function () { resetStats(); }
            });
             __siteAssets = []; __siteAssetsLoaded = false;
             loadAssetTypes(siteId);
             loadSiteAssets(siteId, function () {
                 if (__siteAssetTypes.length) renderAssetTypeSidebar();   // refresh counts + list
                 renderGearCoverage();                                     // unmapped gear needs the asset list
             });
             loadSurveyChecklist(siteId);
             loadLocations(siteId);
        }

        // ── LOCATION tab — Cluster rows "cluster_{RF}/{location}" via the API ─────────
        var __locations    = [];
        var __locSiteId    = 0;
        var __extraRfBoxes = [];   // RF clusters added on screen but with no location saved yet
        var __locDragId    = 0;

        var LOC_POWER = { 1: '24 V', 2: '110 V', 3: '110→24 V' };   // Cluster.PowerSupplyId (90 PowerSupplyType)

        function locEsc(v) { return $('<div>').text(v == null ? '' : v).html().replace(/"/g, '&quot;'); }

        function loadLocations(siteId) {
            __locSiteId = siteId; __extraRfBoxes = []; __locations = [];
            $('#locClusters').html('<div style="font-size:11px;color:var(--txm)">Loading…</div>');
            $.ajax({
                url: '@Url.Action("GetLocations", "Station")',
                data: { siteId: siteId },
                success: function (res) {
                    if (siteId != __locSiteId) return;
                    if (!Array.isArray(res)) { $('#locClusters').html('<div style="font-size:11px;color:var(--err)">' + locEsc((res && res.error) || 'Failed to load') + '</div>'); return; }
                    __locations = res;
                    renderLocations();
                    loadSurveyGear(siteId);
                },
                error: function () { $('#locClusters').html('<div style="font-size:11px;color:var(--err)">Request failed</div>'); }
            });
        }

        // ── Survey gear mapping (SiteSurvey rows) ───────────────────────────────────
        var __gearRows = [];
        var GEAR_COLS = ['TR', 'TF', 'PointMachine', 'Signal', 'AxleCounter', 'BusBar', 'UFSBI', 'BHMS'];

        function loadSurveyGear(siteId) {
            $.ajax({
                url: '@Url.Action("GetSurveyGear", "Station")',
                data: { siteId: siteId },
                success: function (res) {
                    if (siteId != __locSiteId) return;
                    if (!Array.isArray(res)) { $('#gearBody').html('<tr><td colspan="13" style="color:var(--err)">' + locEsc((res && res.error) || 'Failed to load') + '</td></tr>'); return; }
                    __gearRows = res;
                    renderGear();
                }
            });
        }

        // JSON is camelCased by ASP.NET ("tr", "ufsbi", "pointMachine"…), so match keys case-insensitively
        function gearVal(r, key) {
            var lk = key.toLowerCase();
            for (var k in r) if (k.toLowerCase() === lk) return r[k] != null ? r[k] : '';
            return '';
        }

        function gearRowHtml(r) {
            var id = r.id || 0;
            var html = '<tr data-id="' + id + '">'
                + '<td><input class="form-control form-control-sm g-cluster" type="number" min="1" max="50" value="' + (r.cluster || '') + '"></td>'
                + '<td><input class="form-control form-control-sm g-box" list="gearLocList" value="' + locEsc(r.locationBoxNo) + '" onchange="gearBoxPicked(this)"></td>'
                + '<td><input class="form-control form-control-sm g-side" value="' + locEsc(r.locationSide) + '"></td>'
                + '<td><input class="form-control form-control-sm g-dist" value="' + locEsc(r.distanceFromRR) + '"></td>';
            GEAR_COLS.forEach(function (c) {
                html += '<td><input class="form-control form-control-sm g-' + c + '" value="' + locEsc(gearVal(r, c)) + '"></td>';
            });
            html += '<td style="white-space:nowrap">'
                + '<button class="sv-btn" style="background:var(--ok);border:none;color:#fff;font-size:10px;padding:3px 8px;border-radius:3px" onclick="saveGearRow(this)">Save</button> '
                + '<span class="cl-rm" title="Delete row" onclick="deleteGearRow(this)">×</span>'
                + '</td></tr>';
            return html;
        }

        function renderGear() {
            // Location suggestions = this station's locations (Location tab)
            $('#gearLocList').html(__locations.map(function (l) { return '<option value="' + locEsc((l.location || '').toUpperCase()) + '">'; }).join(''));
            var rows = __gearRows.slice().sort(function (a, b) { return (a.cluster - b.cluster) || String(a.locationBoxNo).localeCompare(String(b.locationBoxNo), undefined, { numeric: true }); });
            $('#gearBody').html(rows.length ? rows.map(gearRowHtml).join('')
                : '<tr><td colspan="13" style="color:var(--txm)">No survey rows yet — click "Add Location Box"</td></tr>');
            renderGearCoverage();
        }

        function addGearRow() {
            if (!__locSiteId) { alert('Select a station first'); return; }
            if (!$('#gearBody tr[data-id]').length) $('#gearBody').empty();
            $('#gearBody').append(gearRowHtml({}));
        }

        // Picking a known location fills its RF cluster number
        function gearBoxPicked(inp) {
            var v = inp.value.trim().toUpperCase();
            var l = __locations.filter(function (x) { return (x.location || '').toUpperCase() === v; })[0];
            if (l && l.rfCluster) $(inp).closest('tr').find('.g-cluster').val(l.rfCluster);
        }

        function saveGearRow(btn) {
            var $r = $(btn).closest('tr');
            var body = {
                Id: parseInt($r.data('id'), 10) || 0, SiteId: __locSiteId,
                Cluster: parseInt($r.find('.g-cluster').val(), 10) || 0,
                LocationBoxNo: $r.find('.g-box').val(), LocationSide: $r.find('.g-side').val(),
                DistanceFromRR: $r.find('.g-dist').val()
            };
            GEAR_COLS.forEach(function (c) { body[c] = $r.find('.g-' + c).val(); });
            if (!body.LocationBoxNo.trim()) { alert('Enter the location box'); return; }
            if (!body.Cluster) { alert('Enter the RF cluster number'); return; }
            btn.disabled = true; btn.textContent = '…';
            $.ajax({
                url: '@Url.Action("SaveSurveyGear", "Station")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(body),
                success: function (res) {
                    if (res && res.success) loadSurveyGear(__locSiteId);
                    else { alert((res && res.error) || 'Save failed'); btn.disabled = false; btn.textContent = 'Save'; }
                },
                error: function () { alert('Request failed'); btn.disabled = false; btn.textContent = 'Save'; }
            });
        }

        function deleteGearRow(el) {
            var $r = $(el).closest('tr');
            var id = parseInt($r.data('id'), 10) || 0;
            if (!id) { $r.remove(); return; }   // unsaved row
            if (!confirm('Delete survey row "' + $r.find('.g-box').val() + '"? This removes it permanently (also on the 90 site).')) return;
            $.post('@Url.Action("DeleteSurveyGear", "Station")', { id: id, siteId: __locSiteId }, function (res) {
                if (res && res.success) loadSurveyGear(__locSiteId); else alert((res && res.error) || 'Delete failed');
            });
        }

        // Point 5: which Track / Signal / Point Machine assets are not mapped to any location box yet
        function renderGearCoverage() {
            function names(col) {
                var set = {};
                __gearRows.forEach(function (r) {
                    String(gearVal(r, col) || '').split(/[,;]+/).forEach(function (n) { n = n.trim().toUpperCase(); if (n) set[n] = true; });
                });
                return set;
            }
            var tr = names('TR'), tf = names('TF'), pm = names('PointMachine'), sg = names('Signal');
            function missing(typeId, test) {
                return __siteAssets.filter(function (a) { return a.assetTypeId === typeId && !test((a.name || '').trim().toUpperCase()); })
                                   .map(function (a) { return a.name; });
            }
            var parts = [
                ['Tracks without TR', missing(1, function (n) { return tr[n]; })],
                ['Tracks without TF', missing(1, function (n) { return tf[n]; })],
                ['Point machines', missing(3, function (n) { return pm[n]; })],
                ['Signals', missing(2, function (n) { return sg[n]; })]
            ];
            if (!__siteAssetsLoaded) { $('#gearCoverage').html(''); return; }
            var html = parts.map(function (p) {
                return p[1].length
                    ? '<div><b style="color:var(--warn)">' + p[0] + ' not mapped (' + p[1].length + '):</b> ' + p[1].map(locEsc).join(', ') + '</div>'
                    : '<div style="color:var(--ok)">✓ ' + p[0].replace(' without', ' — all have') + ' mapped</div>';
            }).join('');
            $('#gearCoverage').html(html);
        }

        function locWiredCount(clusterId) {
            return __cardLines.filter(function (r) { return r.clusterId === clusterId && r.assetId; }).length;
        }

        function locChip(l) {
            var wired = locWiredCount(l.id);
            return '<div class="clust-loc-wrap"><div class="clust-loc-inner" draggable="true" data-loc-id="' + l.id + '" '
                 +   'ondragstart="__locDragId=' + l.id + ';this.style.opacity=.4" ondragend="this.style.opacity=\'\'" '
                 +   'title="' + locEsc(l.name) + (l.modemId ? ' · Modem ' + locEsc(l.modemId) : '') + '">'
                 +   '<span class="grip" style="color:var(--txl)">⠿</span>'
                 +   '<span class="cl-name">' + locEsc(l.location) + '</span>'
                 +   '<span class="cl-info">' + (l.typeId === 1 ? 'Indoor' : 'Outdoor') + '</span>'
                 +   (l.powerSupplyId ? '<span class="cl-info" style="color:var(--info)">' + LOC_POWER[l.powerSupplyId] + '</span>'
                                      : '<span class="cl-info" style="color:var(--warn)">no PS</span>')
                 +   '<span class="cl-info">' + wired + ' wired</span>'
                 +   '<span class="cl-set" onclick="editLocation(' + l.id + ')">edit</span>'
                 + '</div></div>';
        }

        function renderLocations() {
            var byRf = {};
            var pool = [];
            __locations.forEach(function (l) {
                if (l.rfCluster) (byRf[l.rfCluster] = byRf[l.rfCluster] || []).push(l); else pool.push(l);
            });
            __extraRfBoxes.forEach(function (n) { byRf[n] = byRf[n] || []; });

            $('#locPool').html(pool.length ? pool.map(locChip).join('')
                : '<div style="font-size:10px;color:var(--txl)">None — every location has an RF cluster</div>');

            var rfs = Object.keys(byRf).map(Number).sort(function (a, b) { return a - b; });
            var html = '';
            rfs.forEach(function (n) {
                var locs = byRf[n];
                html += '<div class="clust-box">'
                      +   '<div class="clust-head"><span class="cn">RF Cluster ' + n + '</span>'
                      +     '<span class="ct group">' + locs.length + ' location' + (locs.length === 1 ? '' : 's') + '</span></div>'
                      +   '<div class="clust-drop" data-rf="' + n + '" ondragover="event.preventDefault();this.classList.add(\'drag-over\')" '
                      +     'ondragleave="this.classList.remove(\'drag-over\')" ondrop="dropLocation(event,this)">'
                      +     (locs.length ? locs.map(locChip).join('') : '<div class="empty-msg">Drag a location here, or add one with this RF cluster</div>')
                      +   '</div>'
                      + '</div>';
            });
            $('#locClusters').html(html || '<div style="font-size:11px;color:var(--txm)">No locations yet — create one above</div>');
            $('#tabLocationCount').text(__locations.length);

            // RF cluster dropdowns (1–50, as on 90). Create Location defaults to the first existing RF cluster.
            var used = {}; rfs.forEach(function (n) { used[n] = true; });
            var rfOpts = '', freeOpts = '';
            for (var i = 1; i <= 50; i++) {
                rfOpts += '<option value="' + i + '">RF ' + i + (used[i] ? '' : ' (new)') + '</option>';
                if (!used[i]) freeOpts += '<option value="' + i + '">RF Cluster ' + i + '</option>';
            }
            var keep = $('#locNewRf').val();
            $('#locNewRf').html(rfOpts).val(keep || (rfs[0] || 1));
            $('#locNewCluster').html(freeOpts || '<option value="">All 50 in use</option>');
        }

        function addRfClusterBox() {
            if (!__locSiteId) { alert('Select a station first'); return; }
            var n = parseInt($('#locNewCluster').val(), 10);
            if (!n) return;
            __extraRfBoxes.push(n);
            renderLocations();
            $('#locNewRf').val(n);
        }

        function saveLocation(data, done) {
            $.ajax({
                url: '@Url.Action("SaveLocation", "Station")',
                type: 'POST',
