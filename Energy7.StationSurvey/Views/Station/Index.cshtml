        var __mp = null, __mpSiteId = 0, __mpSel = -1, __mpBusy = false;

        function mpSite() { return parseInt($('#ddStation').val(), 10) || 0; }
        function mpSpare() { var v = parseFloat($('#mpSpare').val()); return isNaN(v) || v < 0 ? 0 : Math.min(v, 100); }
        function mpOnOpen() { if (mpSite() !== __mpSiteId || !__mp) mpLoad(); }
        $('#ddStation').on('change', function () {
            __mp = null; __mpSiteId = 0; __mpSel = -1;
            if ($('#tab-material').hasClass('on')) mpLoad(); else $('#mpBody').html('<div class="mp-empty">Open this tab to calculate</div>');
