                            <tbody id="amCauseBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="padding:10px 18px;border-top:1px solid var(--bd)">
                <button type="button" class="btn btn-sm" style="border:1px solid var(--bd);color:var(--txm);padding:5px 16px" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm be7" style="padding:5px 16px" onclick="saveAssetFromModal()">Save</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        // ── Zone → Division cascade ───────────────────────────────────────────────────
        function onZoneChange(zoneId) {
            $.ajax({
                url: '@Url.Action("GetDivisionByZoneId", "Station")',
                data: { zoneId: zoneId },
                success: function (data) {
                    var dd = $('#ddDivision');
                    dd.empty().append('<option value="0">Select Division</option>');
                    $.each(data, function (i, d) {
                        dd.append('<option value="' + d.id + '">' + d.name + '</option>');
                    });
                    $('#ddStation').empty().append('<option value="0">Select Station</option>');
                    resetStats();
                }
            });
        }

        // ── Division → Station cascade ────────────────────────────────────────────────
        function onDivisionChange(divisionId) {
            $.ajax({
                url: '@Url.Action("GetSiteByDivisionId", "Station")',
                data: { divisionId: divisionId },
                success: function (data) {
                    var dd = $('#ddStation');
                    dd.empty().append('<option value="0">Select Station</option>');
                    $.each(data, function (i, s) {
                        dd.append('<option value="' + s.id + '">' + s.name + '</option>');
                    });
                    resetStats();
                }
            });
        }

        // ── Station change → load CardLine stats ──────────────────────────────────────
        function onStationChange(siteId) {
            // <select>.value is a string; [FromBody] int SiteId (System.Text.Json) rejects "123" → model binds as null
            siteId = parseInt(siteId, 10) || 0;
            if (SV.dirty && siteId !== SV.siteId && !confirm('The survey of the current station has unsaved changes. Discard them?')) {
                $('#ddStation').val(SV.siteId);   // stay on the current station
                return;
            }
            debugger;
            var stationName  = $('#ddStation option:selected').text();
            var zoneName     = $('#ddZone option:selected').text();
            var divisionName = $('#ddDivision option:selected').text();

            $('#btnEditStation').prop('disabled', !siteId || siteId == 0);
            if (!siteId || siteId == 0) {
                resetStats();
                $('#surveyList').html('<div style="color:var(--txm);font-size:11px">Select a station</div>');
                $('#surveyProgress, #surveyStageBadge').text('').css('background', '');
                $('#surveyBar').css('width', 0);
                __locSiteId = 0; __locations = [];
                $('#locClusters').html('<div style="font-size:11px;color:var(--txm)">Select a station</div>');
                $('#locPool').html('<div style="font-size:10px;color:var(--txl)">Select a station</div>');
                svReset();
                return;
            }

            // Update info panel immediately
            $('#infoName').text(stationName);
            $('#infoZoneDiv').text(zoneName + ' / ' + divisionName);
            $('#stationInfo').text(zoneName + ' · ' + divisionName + ' · ' + stationName);

            // Loading state: dim the current numbers instead of wiping them to spinning icons
            // (wiping changed each tile's height and made the whole panel flicker)
            $('#statLocations,#statClusters,#statDataPoints,#statAssets').css('opacity', '.35');

            // Call CardLine API via controller
            $.ajax({
                url: '@Url.Action("GetCardLineBySiteId", "Station")',
                data: { siteId: siteId },
                success: function (data) {
                    if (!data || data.error) { resetStats(); return; }
                    bindStats(data);
                },
                error: function (xhr) { resetStats(); }
            });
             __siteAssets = []; __siteAssetsLoaded = false;
             loadAssetTypes(siteId);
             loadSiteAssets(siteId, function () {
                 if (__siteAssetTypes.length) renderAssetTypeSidebar();   // refresh counts + list
                 svRender();                                               // survey checks list assets missing from the survey
             });
             loadSurveyChecklist(siteId);
             svLoad(siteId);
             loadLocations(siteId);
             loadNMDL(siteId);
        }

        // ── LOCATION tab — Cluster rows "cluster_{RF}/{location}" via the API ─────────
        var __locations    = [];
        var __locSiteId    = 0;
        var __extraRfBoxes = [];   // RF clusters added on screen but with no location saved yet
        var __locDragId    = 0;

        var LOC_POWER = { 1: '24 V', 2: '110 V', 3: '110→24 V' };   // Cluster.PowerSupplyId (90 PowerSupplyType)

        function locEsc(v) { return $('<div>').text(v == null ? '' : v).html().replace(/"/g, '&quot;'); }

        function loadLocations(siteId) {
            __locSiteId = siteId; __extraRfBoxes = []; __locations = [];
            $('#locClusters').html('<div style="font-size:11px;color:var(--txm)">Loading…</div>');
            $.ajax({
                url: '@Url.Action("GetLocations", "Station")',
                data: { siteId: siteId },
                success: function (res) {
                    if (siteId != __locSiteId) return;
                    if (!Array.isArray(res)) { $('#locClusters').html('<div style="font-size:11px;color:var(--err)">' + locEsc((res && res.error) || 'Failed to load') + '</div>'); return; }
                    __locations = res;
                    renderLocations();
                },
                error: function (xhr) { $('#locClusters').html('<div style="font-size:11px;color:var(--err)">Request failed</div>'); }
            });
        }

        // ══ SURVEY TAB ══════════════════════════════════════════════════════════════════
        // Location-wise survey (same flow as the Cluster-Wise Materials Count sheet):
        //   1. pick / create a location  2. edit its details  3. add gears one by one  4. station summary.
        // Storage (unchanged, via the API): one SiteSurvey row per location — TF, TR, Signal ("S1 RG,S1 HG"),
        // PointMachine, AxleCounter, BusBar, UFSBI, BHMS — plus SurveyPointMachine details. See SaveSurvey.

        // Material rule per gear: [label, V, C, sensors (0-10V DC, 0-50V DC, 0-150V DC, 0-150V AC, 0-1A AC, 0-2A DC, 0-6A DC, 0-10A DC)]
        var SV_RULES = {
            tf:      ['1 TF', 4, 2, [3, 0, 0, 1, 0, 1, 1, 0]],
            tr:      ['1 TR', 2, 1, [1, 1, 0, 0, 0, 1, 0, 0]],
            sig2:    ['2 ASP Signal', 3, 2, [0, 1, 0, 2, 2, 0, 0, 0]],
            sig3:    ['3 ASP Signal', 5, 3, [0, 2, 0, 3, 3, 0, 0, 0]],
            sig4:    ['4 ASP Signal', 7, 4, [0, 3, 0, 4, 4, 0, 0, 0]],
            route1:  ['1 Route', 2, 1, [0, 1, 0, 1, 1, 0, 0, 0]],
            route2:  ['2 Route', 4, 2, [0, 2, 0, 2, 2, 0, 0, 0]],
            route3:  ['3 Route', 6, 3, [0, 3, 0, 3, 3, 0, 0, 0]],
            coon:    ['1 CO-ON', 2, 1, [0, 1, 0, 1, 1, 0, 0, 0]],
            pmSFull: ['Series - Full Point Machine', 4, 2, [0, 2, 2, 0, 0, 0, 0, 2]],
            pmSNorm: ['Series - Normal End with Indication', 2, 1, [0, 1, 1, 0, 0, 0, 0, 1]],
            pmSRev:  ['Series - Reverse End with Indication', 2, 1, [0, 1, 1, 0, 0, 0, 0, 1]],
            pmPFull: ['Parallel - Full Point Machine', 8, 4, [0, 4, 4, 0, 0, 0, 0, 4]],
            pmPA:    ['Parallel - A End', 4, 2, [0, 2, 2, 0, 0, 0, 0, 2]],
            pmPB:    ['Parallel - B End', 4, 2, [0, 2, 2, 0, 0, 0, 0, 2]],
            sh1:     ['1-ASP Shunt', 2, 1, [0, 1, 0, 1, 1, 0, 0, 0]],
            sh3:     ['3-ASP Shunt', 4, 3, [0, 1, 0, 3, 3, 0, 0, 0]]
        };
        var SV_SENSORS = ['(0-10)V DC', '(0-50)V DC', '(0-150)V DC', '(0-150)V AC', '(0-1)A AC', '(0-2)A DC', '(0-6)A DC', '(0-10)A DC'];

        // Gear types: col = SiteSurvey column, cfg = configuration options → [rule key, aspects stored in the Signal column]
        var SV_TYPES = {
            // Track is a UI-only grouping: the user picks "Track", then its asset type (TF / TR).
            // On add it is remapped to the real TF / TR type below, so storage and all downstream logic are unchanged.
            Track:  { label: 'Track', ph: '117TF', cfgLabel: 'Track asset type', cfg: { 'TF': 1, 'TR': 1 } },
            TF:     { label: 'TF', col: 'TF', rule: 'tf', ph: '117TF', real: true },
            TR:     { label: 'TR', col: 'TR', rule: 'tr', ph: '117TR', real: true },
            Signal: { label: 'Signal', col: 'Signal', ph: 'S2', cfgLabel: 'Aspects',
                      cfg: { '2-ASP': ['sig2', ['RG', 'HG']], '3-ASP': ['sig3', ['RG', 'HG', 'DG']], '4-ASP': ['sig4', ['RG', 'HG', 'HHG', 'DG']] } },
            Shunt:  { label: 'Shunt', col: 'Signal', ph: 'SH-01', cfgLabel: 'Aspects',
                      cfg: { '1-ASP': ['sh1', ['PG']], '3-ASP': ['sh3', ['RG', 'DG', 'PG']] } },
            Route:  { label: 'Route', col: 'Signal', ph: 'S2', cfgLabel: 'Routes',
                      cfg: { '1 Route': ['route1', ['UGA']], '2 Route': ['route2', ['UGA', 'UGB']], '3 Route': ['route3', ['UGA', 'UGB', 'UGC']] } },
            'CO-ON': { label: 'CO-ON (calling-on)', col: 'Signal', rule: 'coon', ph: 'C1', asp: ['HG'] },
            Point:  { label: 'Point machine', col: 'PointMachine', ph: 'P1', cfgLabel: 'Operation', cfg: { 'Series': 1, 'Parallel': 1 } },
            AC:     { label: 'Axle counter', col: 'AxleCounter', ph: 'AC1' },
            BusBar: { label: 'Bus bar', col: 'BusBar', ph: 'BB1' },
            UFSBI:  { label: 'UFSBI', col: 'UFSBI', ph: 'UF1' },
            BHMS:   { label: 'BHMS', col: 'BHMS', ph: 'BH1' }
        };
        var SV_PM_SUB = {
            Series:   { 'Full Point Machine': 'pmSFull', 'Normal End with Indication': 'pmSNorm', 'Reverse End with Indication': 'pmSRev' },
            Parallel: { 'Full Point Machine': 'pmPFull', 'A End': 'pmPA', 'B End': 'pmPB' }
        };
        var SV_SIG_TYPES = ['Signal', 'Shunt', 'CO-ON'];        // share one name space in the Signal column
        var SV_ROUTE_ASP = ['UG', 'UGA', 'UGB', 'UGC', 'UGD', 'ASIN'];

        var SV = svEmpty();
        var SVSEL = null;      // key of the selected location
        var SVEDIT = null;     // gear being edited (object) or null

        function svEmpty() { return { siteId: 0, loaded: false, dirty: false, seq: 0, locs: [], pms: {} }; }
        function svList(v) {
            return String(v == null ? '' : v).split(',').map(function (x) { return x.trim().replace(/\s+/g, ' ').toUpperCase(); })
                                               .filter(function (x) { return x; });
        }
        function svUp(v) { return String(v == null ? '' : v).trim().replace(/\s+/g, ' ').toUpperCase(); }
        function svNatural(a, b) { return String(a).localeCompare(String(b), undefined, { numeric: true }); }
        function svLoc(k) { return SV.locs.filter(function (l) { return l.k === k; })[0] || null; }
        function svOpenTab() { $('.etab[data-tab="survey"]').trigger('click'); }

        // ── Rule / configuration of one gear ──
        function svRuleKey(g) {
            var t = SV_TYPES[g.type];
            if (!t) return null;
            if (t.rule) return t.rule;
            if (g.type === 'Point') return (SV_PM_SUB[g.cfg] || {})[g.sub] || null;
            return t.cfg && t.cfg[g.cfg] ? t.cfg[g.cfg][0] : null;
        }
        function svCfgText(g) {
            if (g.type === 'Point') return g.cfg + ' / ' + g.sub;
            if (g.cfg) return g.cfg;
            if (g.asp && g.asp.length && SV_TYPES[g.type].col === 'Signal') return 'Stored: ' + g.asp.join(', ');
            return '—';
        }
        function svCalc(gears) {
            var r = { v: 0, c: 0, sensors: [0, 0, 0, 0, 0, 0, 0, 0] };
            gears.forEach(function (g) {
                var rule = SV_RULES[svRuleKey(g)];
                if (!rule) return;
                r.v += rule[1]; r.c += rule[2];
                rule[3].forEach(function (n, i) { r.sensors[i] += n; });
            });
            r.cards = svCards(r.v, r.c);
            return r;
        }

        // AI / CI card + Buckel rule (from the Cluster-Wise Materials Count sheet).
        // AI card = 8 voltage pins (P1-8) + 2 current pins (P9-10), CI card = 10 current pins.
        // Current goes on AI first (free P1-8 via Buckel, then P9-10); if a CI card is needed, CI is filled first.
        function svCards(V, C) {
            var z = { ai: 0, ci: 0, buckel: 0, total: 0 };
            if (!V && !C) return z;
            if (!V) { var c0 = Math.ceil(C / 10); return { ai: 0, ci: c0, buckel: 0, total: c0 }; }
            var ai = Math.ceil(V / 8), free = 8 * ai - V, reserved = 2 * ai, cap = free + reserved;
            if (C <= cap) return { ai: ai, ci: 0, buckel: Math.min(C, free), total: ai };
            var ci = Math.ceil((C - cap) / 10), rest = C - Math.min(C, 10 * ci);
            return { ai: ai, ci: ci, buckel: Math.min(rest, free), total: ai + ci };
        }

        // ── Load ──
        function svReset(msg) {
            SV = svEmpty(); SVSEL = null; SVEDIT = null;
            $('#svLocList').html('<div class="sv-empty">' + locEsc(msg || 'Select a station') + '</div>');
            $('#svGearRows').html(''); $('#svKpi,#svSens,#svChips,#svChecks,#svSummary,#svLocSub,#svLocMsg,#svGMsg').html('');
            $('#svFigs').html(''); $('#svDiagram').hide().html('');
            $('#svLName,#svLRf,#svLSide,#svLDist,#svLL2L').val('');
            $('#svStamp').text(msg || 'Select a station').removeClass('dirty');
            $('#tabSurveyCount').text('—');
        }

        function svReload() {
            if (!SV.siteId) { E7.warn('Select a station first'); return; }
            if (SV.dirty && !confirm('Discard unsaved survey changes and reload?')) return;
            svLoad(SV.siteId);
        }

        function svLoad(siteId, keepSel) {
            var selName = keepSel && svLoc(SVSEL) ? svLoc(SVSEL).name : null;
            svReset('Loading…');
            SV.siteId = siteId;
            $.ajax({
                url: '@Url.Action("GetSurvey", "Station")',
                data: { siteId: siteId },
                success: function (res) {
                    if (siteId != SV.siteId) return;
                    if (!res || res.error || !Array.isArray(res.rows)) { svReset((res && res.error) || 'Failed to load the survey'); SV.siteId = siteId; return; }
                    svFromRows(res.rows, res.pms || []);
                    SV.loaded = true; SV.dirty = false;
                    var keep = SV.locs.filter(function (l) { return l.name === selName; })[0];
                    SVSEL = keep ? keep.k : (SV.locs[0] ? SV.locs[0].k : null);
                    svTypeOptions(); svTypeChanged();
                    svRender();
                },
                error: function () { svReset('Request failed'); SV.siteId = siteId; }
            });
        }

        // SiteSurvey rows → locations with a gear list
        function svFromRows(rows, pms) {
            pms.forEach(function (p) { SV.pms[svUp(p.name)] = p; });
            rows.slice().sort(function (a, b) { return (a.cluster - b.cluster) || svNatural(a.locationBoxNo, b.locationBoxNo); })
                .forEach(function (r) {
                    var loc = { k: 'L' + (++SV.seq), id: r.id, name: svUp(r.locationBoxNo), rf: r.cluster || '', side: r.locationSide || '', dist: r.distanceFromRR || '', l2l: gearVal(r, 'LocToLocDist') || '', gears: [] };
                    function add(type, name, extra) { loc.gears.push($.extend({ type: type, name: name }, extra || {})); }
                    svList(gearVal(r, 'TF')).forEach(function (n) { add('TF', n); });
                    svList(gearVal(r, 'TR')).forEach(function (n) { add('TR', n); });
                    svSignalsFromEntries(svList(gearVal(r, 'Signal'))).forEach(function (g) { loc.gears.push(g); });
                    svList(gearVal(r, 'PointMachine')).forEach(function (n) {
                        var d = SV.pms[n] || {}, series = !!d.isSeriesOpration;
                        var sub = !d.isHalfPointMachine ? 'Full Point Machine'
                                : series ? (d.seriesOprationTypeId == 2 ? 'Reverse End with Indication' : 'Normal End with Indication')
                                         : (d.seriesOprationTypeId == 2 ? 'B End' : 'A End');
                        add('Point', n, { cfg: series ? 'Series' : 'Parallel', sub: sub });
                    });
                    svList(gearVal(r, 'AxleCounter')).forEach(function (n) { add('AC', n); });
                    ['BusBar', 'UFSBI', 'BHMS'].forEach(function (col) { svList(gearVal(r, col)).forEach(function (n) { add(col, n); }); });
                    SV.locs.push(loc);
                });
        }

        // "S1 RG,S1 HG,S1 UGA,SH1 PG" → Signal / Route / Shunt / CO-ON gears (aspects kept as stored)
        function svSignalsFromEntries(entries) {
            var by = {}, order = [];
            entries.forEach(function (e) {
                var p = e.split(' '), n = p[0], a = p.length > 1 ? p[p.length - 1] : '';
                if (!by[n]) { by[n] = []; order.push(n); }
                if (a && by[n].indexOf(a) < 0) by[n].push(a);
            });
            var out = [];
            order.forEach(function (n) {
                var asp = by[n], route = asp.filter(function (a) { return SV_ROUTE_ASP.indexOf(a) >= 0; });
                var rest = asp.filter(function (a) { return SV_ROUTE_ASP.indexOf(a) < 0; });
                if (route.length) out.push({ type: 'Route', name: n, asp: route, cfg: route.length <= 3 ? route.length + ' Route' : '' });
                if (!rest.length) return;
                if (rest.indexOf('PG') >= 0) out.push({ type: 'Shunt', name: n, asp: rest, cfg: rest.length === 1 ? '1-ASP' : rest.length === 3 ? '3-ASP' : '' });
                else if (rest.length === 1 && rest[0] === 'HG') out.push({ type: 'CO-ON', name: n, asp: rest });
                else out.push({ type: 'Signal', name: n, asp: rest, cfg: rest.length >= 2 && rest.length <= 4 ? rest.length + '-ASP' : '' });
            });
            return out;
        }

        // ── Location list (step 1) ──
        function svRenderLocs() {
            if (!SV.locs.length) { $('#svLocList').html('<div class="sv-empty">No locations yet.<br>Click <b>New</b> to add the first one.</div>'); return; }
            var groups = {};
            SV.locs.forEach(function (l) { var rf = parseInt(l.rf, 10) || 0; (groups[rf] = groups[rf] || []).push(l); });
            $('#svLocList').html(Object.keys(groups).sort(function (a, b) { return a - b; }).map(function (rf) {
                return '<div class="sv-rf">' + (rf > 0 ? 'RF cluster ' + rf : 'No RF cluster') + '</div>'
                    + groups[rf].map(function (l) {
                        var c = svCalc(l.gears);
                        return '<div class="sv-li' + (l.k === SVSEL ? ' on' : '') + '" onclick="svSelect(\'' + l.k + '\')">'
                            + '<span class="dot ' + (l.gears.length ? 'ok' : 'w') + '"></span>'
                            + '<span class="nm">' + locEsc(l.name || '(no name)') + '</span>'
                            + '<span class="ct">' + l.gears.length + ' gear · ' + c.cards.total + ' cards</span></div>';
                    }).join('');
            }).join(''));
        }

        function svSelect(k) {
            if (SVEDIT) svCancelEdit();
            SVSEL = k;
            svRender();
            $('#svGName').trigger('focus');
        }

        function svNewLoc() {
            if (!SV.loaded) { E7.warn('Select a station first'); return; }
            var last = SV.locs[SV.locs.length - 1], n = SV.locs.length + 1, name;
            do { name = 'LOC-' + n++; } while (SV.locs.some(function (l) { return l.name === name; }));
            var loc = { k: 'L' + (++SV.seq), id: 0, name: name, rf: last ? last.rf : 1, side: '', dist: '', l2l: '', gears: [] };
            SV.locs.push(loc);
            SVSEL = loc.k; SV.dirty = true;
            svRender();
            $('#svLName').trigger('focus').trigger('select');
        }

        function svDelLoc() {
            var l = svLoc(SVSEL);
            if (!l) return;
            if (!confirm('Remove location ' + l.name + (l.gears.length ? ' and its ' + l.gears.length + ' gear(s)' : '') + '? It is deleted when you press Save survey.')) return;
            SV.locs = SV.locs.filter(function (x) { return x !== l; });
            SVSEL = SV.locs[0] ? SV.locs[0].k : null; SV.dirty = true;
            svRender();
        }

        // ── Location details (step 2) ──
        function svLocField(f, v) {
            var l = svLoc(SVSEL);
            if (!l) return;
            var msg = '';
            if (f === 'name') {
                v = svUp(v);
                if (!v) msg = 'Enter a location name.';
                else if (/[\/,]/.test(v)) msg = 'A location name cannot contain "/" or ",".';
                else if (SV.locs.some(function (x) { return x !== l && x.name === v; })) msg = 'Location ' + v + ' already exists.';
                if (msg) { $('#svLName').val(l.name); $('#svLocMsg').text(msg); return; }
            }
            if (f === 'rf') {
                var n = parseInt(v, 10);
                if (!(n >= 1 && n <= 50)) { $('#svLRf').val(l.rf); $('#svLocMsg').text('RF cluster must be 1 to 50.'); return; }
                v = n;
            }
            $('#svLocMsg').text('');
            l[f] = f === 'name' ? v : String(v).trim();
            SV.dirty = true;
            svRender();
        }

        // ── Gear form (step 3) ──
        function svTypeOptions() {
            $('#svGType').html(Object.keys(SV_TYPES).filter(function (k) { return !SV_TYPES[k].real; })
                .map(function (k) { return '<option value="' + k + '">' + SV_TYPES[k].label + '</option>'; }).join(''));
        }
        function svTypeChanged() {
            var t = SV_TYPES[$('#svGType').val()] || SV_TYPES.TF;
            $('#svGName').attr('placeholder', t.ph);
            if (t.cfg) {
                $('#svGCfgL').text(t.cfgLabel);
                $('#svGCfg').html(Object.keys(t.cfg).map(function (o) { return '<option>' + o + '</option>'; }).join(''));
                $('#svGCfgW').css('visibility', 'visible');
            } else { $('#svGCfg').html(''); $('#svGCfgW').css('visibility', 'hidden'); }
            svCfgChanged();
            $('#svGMsg').text('').attr('class', 'sv-msg');
        }
        function svCfgChanged() {
            if ($('#svGType').val() === 'Track') { var tt = SV_TYPES[$('#svGCfg').val()]; if (tt) $('#svGName').attr('placeholder', tt.ph); }
            var subs = $('#svGType').val() === 'Point' ? SV_PM_SUB[$('#svGCfg').val()] : null;
            if (subs) { $('#svGSub').html(Object.keys(subs).map(function (o) { return '<option>' + o + '</option>'; }).join('')); $('#svGSubW').css('visibility', 'visible'); }
            else { $('#svGSub').html(''); $('#svGSubW').css('visibility', 'hidden'); }
        }
        function svGMsg(text, lvl) { $('#svGMsg').text(text || '').attr('class', 'sv-msg ' + (lvl || '')); }

        // Same name rules the API enforces, checked right when the gear is added
        function svGearClash(g, skip) {
            var t = SV_TYPES[g.type], hit = null;
            SV.locs.forEach(function (l) {
                l.gears.forEach(function (x) {
                    if (hit || x === skip || x.name !== g.name) return;
                    var where = l.k === SVSEL ? 'this location' : l.name;
                    if (x.type === g.type && (g.type !== 'AC' || l.k === SVSEL)) hit = t.label + ' ' + g.name + ' is already in ' + where + '.';
                    else if (SV_SIG_TYPES.indexOf(x.type) >= 0 && SV_SIG_TYPES.indexOf(g.type) >= 0)
                        hit = g.name + ' is already a ' + SV_TYPES[x.type].label + ' in ' + where + '. Use another name.';
                    else if (g.type === 'Route' && SV_SIG_TYPES.indexOf(x.type) >= 0 && l.k !== SVSEL)
                        hit = 'Signal ' + g.name + ' is in ' + l.name + '. Add its route in that location.';
                    else if (x.type === 'Route' && SV_SIG_TYPES.indexOf(g.type) >= 0 && l.k !== SVSEL)
                        hit = 'Route ' + g.name + ' is in ' + l.name + '. Add the signal in that location.';
                });
            });
            return hit;
        }

        function svAddGear() {
            var l = svLoc(SVSEL);
            if (!l) { svGMsg('Select or create a location first.', 'e'); return; }
            var type = $('#svGType').val();
            if (type === 'Track') type = $('#svGCfg').val();   // Track grouping → real asset type (TF / TR)
            var t = SV_TYPES[type], name = svUp($('#svGName').val());
            if (!name) { svGMsg('Enter the gear name / ID.', 'e'); $('#svGName').trigger('focus'); return; }
            if (/,/.test(name)) { svGMsg('A gear name cannot contain a comma.', 'e'); return; }
            if (t.col === 'Signal' && / /.test(name)) { svGMsg('Signal names cannot contain spaces (S2, not "S 2").', 'e'); return; }
            var g = { type: type, name: name };
            if (t.cfg) g.cfg = $('#svGCfg').val();
            if (type === 'Point') g.sub = $('#svGSub').val();
            if (t.col === 'Signal') g.asp = (t.cfg ? t.cfg[g.cfg][1] : t.asp).slice();
            var clash = svGearClash(g, SVEDIT);
            if (clash) { svGMsg(clash, 'e'); return; }
            if (SVEDIT) { var i = l.gears.indexOf(SVEDIT); if (i >= 0) l.gears[i] = g; else l.gears.push(g); }
            else l.gears.push(g);
            var rule = SV_RULES[svRuleKey(g)];
            svCancelEdit();
            svGMsg(t.label + ' ' + name + ' added' + (rule ? ' (' + rule[1] + ' V, ' + rule[2] + ' C).' : ' (recorded only, no material rule).'), rule ? '' : 'w');
            SV.dirty = true;
            svRender();
            $('#svGName').trigger('focus');
        }

        function svEditGear(i) {
            var l = svLoc(SVSEL), g = l && l.gears[i];
            if (!g) return;
            SVEDIT = g;
            if (g.type === 'TF' || g.type === 'TR') { $('#svGType').val('Track'); svTypeChanged(); $('#svGCfg').val(g.type); svCfgChanged(); }
            else { $('#svGType').val(g.type); svTypeChanged(); }
            $('#svGName').val(g.name);
            if (g.cfg) { $('#svGCfg').val(g.cfg); svCfgChanged(); }
            if (g.sub) $('#svGSub').val(g.sub);
            $('#svGAddBtn').text('Update'); $('#svGCancel').css('visibility', 'visible');
            svRenderGears();
            $('#svGName').trigger('focus');
        }
        function svCancelEdit() {
            SVEDIT = null;
            $('#svGName').val('');
            $('#svGAddBtn').text('Add'); $('#svGCancel').css('visibility', 'hidden');
            svGMsg('');
            svRenderGears();
        }
        function svDelGear(i) {
            var l = svLoc(SVSEL), g = l && l.gears[i];
            if (!g || !confirm('Remove ' + SV_TYPES[g.type].label + ' ' + g.name + '?')) return;
            if (SVEDIT === g) svCancelEdit();
            l.gears.splice(i, 1); SV.dirty = true;
            svRender();
        }
        $(document).on('keydown', '#svGName', function (e) { if (e.key === 'Enter') { e.preventDefault(); svAddGear(); } });

        function svRenderGears() {
            var l = svLoc(SVSEL);
            if (!l) { $('#svGearRows').html('<tr><td colspan="7" class="sv-empty">Select or create a location.</td></tr>'); return; }
            $('#svGearRows').html(l.gears.length ? l.gears.map(function (g, i) {
                var rule = SV_RULES[svRuleKey(g)];
                return '<tr' + (g === SVEDIT ? ' class="ed"' : '') + '><td><b>' + locEsc(g.name) + '</b></td>'
                    + '<td><span class="sv-type">' + SV_TYPES[g.type].label + '</span></td>'
                    + '<td>' + locEsc(svCfgText(g)) + '</td>'
                    + '<td style="color:' + (rule ? 'var(--tx)' : 'var(--txl)') + '">' + (rule ? rule[0] : 'Recorded only') + '</td>'
                    + '<td class="n">' + (rule ? rule[1] : 0) + '</td><td class="n">' + (rule ? rule[2] : 0) + '</td>'
                    + '<td style="white-space:nowrap"><button class="sv-ib" title="Edit" onclick="svEditGear(' + i + ')"><i class="bi bi-pencil"></i></button>'
                    + '<button class="sv-ib del" title="Remove" onclick="svDelGear(' + i + ')"><i class="bi bi-trash"></i></button></td></tr>';
            }).join('') : '<tr><td colspan="7" class="sv-empty">No gears in this location yet. Add the first one above.</td></tr>');
        }

        function svRenderDetail() {
            var l = svLoc(SVSEL);
            $('#svLName,#svLRf,#svLSide,#svLDist,#svLL2L,#svGType,#svGName,#svGCfg,#svGSub,#svGAddBtn').prop('disabled', !l);
            if (!l) { $('#svLName,#svLRf,#svLSide,#svLDist,#svLL2L').val(''); $('#svLocSub,#svChips,#svKpi,#svSens,#svYard').html(''); svRenderGears(); return; }
            $('#svLName').val(l.name); $('#svLRf').val(l.rf); $('#svLSide').val(l.side); $('#svLDist').val(l.dist); $('#svLL2L').val(l.l2l || '');
            $('#svLocSub').text(l.id ? '' : 'new — saved with Save survey');
            var counts = {};
            l.gears.forEach(function (g) { counts[g.type] = (counts[g.type] || 0) + 1; });
            $('#svChips').html(Object.keys(SV_TYPES).filter(function (k) { return counts[k]; })
                .map(function (k) { return '<span class="sv-chip">' + SV_TYPES[k].label + ' <b>' + counts[k] + '</b></span>'; }).join('')
                + '<span class="sv-chip">Total gears <b>' + l.gears.length + '</b></span>');
            svRenderGears();
            var c = svCalc(l.gears);
            $('#svKpi').html([['Total V', c.v], ['Total C', c.c], ['V + C', c.v + c.c], ['AI cards', c.cards.ai, 1], ['CI cards', c.cards.ci, 1], ['Buckel', c.cards.buckel], ['Total cards', c.cards.total, 1]]
                .map(function (x) { return '<div' + (x[2] ? ' class="hl"' : '') + '>' + x[0] + '<b>' + x[1] + '</b></div>'; }).join(''));
            $('#svSens').html(SV_SENSORS.map(function (s, i) { return '<div>' + s + '<b>' + c.sensors[i] + '</b></div>'; }).join(''));
            svRenderYardPreview();
        }

        // ── Checks + station summary (step 4) ──
        function svIssues() {
            var out = [], tf = {}, tr = {}, all = { Signal: {}, Point: {} };
            SV.locs.forEach(function (l) {
                if (!l.gears.length) out.push(['w', l.name + ' has no gears yet.']);
                if (!(parseInt(l.rf, 10) >= 1)) out.push(['e', l.name + ' needs an RF cluster.']);
                // Side and Dist. from RR are required by the SiteSurvey model (NOT NULL), so block the save here
                if (!String(l.side == null ? '' : l.side).trim()) out.push(['e', l.name + ' needs a Side (UP / DN / CENTRAL).']);
                if (!String(l.dist == null ? '' : l.dist).trim()) out.push(['e', l.name + ' needs Dist. from RR (m).']);
                l.gears.forEach(function (g) {
                    if (g.type === 'TF') tf[g.name] = l.name;
                    if (g.type === 'TR') tr[g.name] = l.name;
                    if (g.type === 'Signal') all.Signal[g.name] = 1;
                    if (g.type === 'Point') all.Point[g.name] = 1;
                    if (SV_TYPES[g.type].cfg && !svRuleKey(g)) out.push(['w', SV_TYPES[g.type].label + ' ' + g.name + ' in ' + l.name + ' has stored aspects (' + (g.asp || []).join(', ') + ') that match no configuration. Edit it to pick one.']);
                });
            });
            Object.keys(tr).forEach(function (n) { if (!tf[n.replace(/TR$/, 'TF')] && !tf[n]) out.push(['w', 'Track ' + n + ' (TR in ' + tr[n] + ') has no TF end in any location.']); });
            Object.keys(tf).forEach(function (n) { if (!tr[n.replace(/TF$/, 'TR')] && !tr[n]) out.push(['w', 'Track ' + n + ' (TF in ' + tf[n] + ') has no TR end in any location.']); });
            var rfs = SV.locs.map(function (l) { return parseInt(l.rf, 10); }).filter(function (n) { return n >= 1; });
            var max = rfs.length ? Math.max.apply(null, rfs) : 0;
            for (var n = 1; n < max; n++) if (rfs.indexOf(n) < 0) out.push(['w', 'No location is in RF cluster ' + n + '.']);
            if (__siteAssetsLoaded) {
                function missing(typeId, set) {
                    return __siteAssets.filter(function (a) { return a.assetTypeId === typeId && !set[svUp(a.name)]; }).map(function (a) { return a.name; });
                }
                var trk = {}; Object.keys(tf).concat(Object.keys(tr)).forEach(function (n) { trk[n] = 1; trk[n.replace(/T[FR]$/, 'T')] = 1; });
                [[1, 'Tracks', trk], [2, 'Signals', all.Signal], [3, 'Point machines', all.Point]].forEach(function (x) {
                    var m = missing(x[0], x[2]);
                    if (m.length) out.push(['w', x[1] + ' in Assets but not in the survey (' + m.length + '): ' + m.join(', ')]);
                });
            }
            return out;
        }

        function svRenderSummary() {
            var issues = svIssues(), ic = { e: 'bi-x-circle', w: 'bi-exclamation-triangle', o: 'bi-check-circle' };
            $('#svChecks').html(issues.length ? issues.map(function (w) { return '<div class="sv-iss ' + w[0] + '"><i class="bi ' + ic[w[0]] + '"></i><span>' + locEsc(w[1]) + '</span></div>'; }).join('')
                : (SV.locs.length ? '<div class="sv-iss o"><i class="bi bi-check-circle"></i><span>No issues found.</span></div>' : ''));
            if (!SV.locs.length) { $('#svSummary').html(''); return; }
            var cols = [['TF', 'TF'], ['TR', 'TR'], ['Signal', 'Signals'], ['Shunt', 'Shunts'], ['Route', 'Routes'], ['CO-ON', 'CO-ON'], ['Point', 'Points'], ['AC', 'Axle ctr']];
            var T = { v: 0, c: 0, ai: 0, ci: 0, buckel: 0, total: 0, s: [0, 0, 0, 0, 0, 0, 0, 0] };
            var body = SV.locs.slice().sort(function (a, b) { return (a.rf - b.rf) || svNatural(a.name, b.name); }).map(function (l) {
                var c = svCalc(l.gears);
                T.v += c.v; T.c += c.c; T.ai += c.cards.ai; T.ci += c.cards.ci; T.buckel += c.cards.buckel; T.total += c.cards.total;
                c.sensors.forEach(function (n, i) { T.s[i] += n; });
                return '<tr style="cursor:pointer" onclick="svSelect(\'' + l.k + '\');document.getElementById(\'svLocCard\').scrollIntoView({behavior:\'smooth\'})">'
                    + '<td><b>' + locEsc(l.name) + '</b></td><td class="n">' + locEsc(l.rf) + '</td>'
                    + cols.map(function (x) {
                        return '<td class="l">' + (locEsc(l.gears.filter(function (g) { return g.type === x[0]; })
                            .map(function (g) { return g.name + (g.cfg && x[0] !== 'TF' && x[0] !== 'TR' ? ' (' + (g.type === 'Point' ? g.cfg + ' / ' + g.sub : g.cfg) + ')' : ''); }).join(', ')) || '<span style="color:var(--txl)">—</span>') + '</td>';
                    }).join('')
                    + c.sensors.map(function (n) { return '<td class="n">' + (n ? n : '<span style="color:var(--txl)">—</span>') + '</td>'; }).join('')
                    + '<td class="n">' + c.v + '</td><td class="n">' + c.c + '</td><td class="n">' + c.cards.ai + '</td><td class="n">' + c.cards.ci + '</td><td class="n">' + c.cards.buckel + '</td><td class="n"><b>' + c.cards.total + '</b></td></tr>';
            }).join('');
            $('#svSummary').html('<thead><tr><th>Location</th><th class="n">RF</th>' + cols.map(function (x) { return '<th>' + x[1] + '</th>'; }).join('')
                + SV_SENSORS.map(function (s) { return '<th class="n">' + s + '</th>'; }).join('')
                + '<th class="n">V</th><th class="n">C</th><th class="n">AI</th><th class="n">CI</th><th class="n">Buckel</th><th class="n">Cards</th></tr></thead><tbody>' + body + '</tbody>'
                + '<tfoot><tr><td colspan="' + (cols.length + 2) + '"><b>Station total</b></td>'
                + T.s.map(function (n) { return '<td class="n"><b>' + n + '</b></td>'; }).join('')
                + '<td class="n">' + T.v + '</td><td class="n">' + T.c + '</td><td class="n">' + T.ai + '</td><td class="n">' + T.ci + '</td><td class="n">' + T.buckel + '</td><td class="n">' + T.total + '</td></tr></tfoot>');
        }

        // ══ Yard configuration PREVIEW (ported from the Cluster-Wise Materials sheet) ════════════
        // Read-only: computes the MintCard(AI)/CI/ADC/Pin layout for the selected location's gears.
        // Card count reuses svCards() (same optimiseAICICards rule). NOTHING is written to the DB here.
        //   Voltage → AI pins 1-8 · Current → CI pins first, then AI 1-8 (Buckel=Yes), then AI 9-10.
        var SVY_TF = [
            { kind: 'V', description: 'Track Feed Charger I/P Voltage', parameter: 'VTC TFC I/P', sensor: '0-150 V AC' },
            { kind: 'V', description: 'Track Feed Charger O/P Voltage (on load)', parameter: 'VTC TFC O/P', sensor: '0-10 V DC' },
            { kind: 'C', description: 'Track Feed Charger O/P Current', parameter: 'ITC TFC O/P', sensor: '0-6 A DC' },
            { kind: 'V', description: 'Voltage drop at Feed End Choke', parameter: 'VTC CH FEED END', sensor: '0-10 V DC' },
            { kind: 'V', description: 'Track Feed End Voltage (to Rails)', parameter: 'VTC FEED END', sensor: '0-10 V DC' },
            { kind: 'C', description: 'Track Feed Current', parameter: 'ITC FEED END', sensor: '0-2 A DC' }
        ];
        var SVY_TR = [
            { kind: 'V', description: 'Track Relay End V (from Rails)', parameter: 'VTC RELAY END', sensor: '0-10 V DC' },
            { kind: 'C', description: 'Track Relay End Current', parameter: 'ITC RELAY END', sensor: '0-2 A DC' },
            { kind: 'V', description: '24 V DC going to TPR after TR pick up', parameter: 'VTC 24 V DC LOC', sensor: '0-50 V DC' }
        ];
        var SVY_SIG = {
            hpr: { kind: 'V', description: 'HPR Voltage', parameter: 'VSig HPR', sensor: '0-50 V DC' },
            dpr: { kind: 'V', description: 'DPR Voltage', parameter: 'VSig DPR', sensor: '0-50 V DC' },
            hhpr: { kind: 'V', description: 'HHPR Voltage', parameter: 'VSig HHPR', sensor: '0-50 V DC' },
            dgV: { kind: 'V', description: 'Green Aspect Voltage', parameter: 'VSig DG', sensor: '0-150 V AC' },
            hgV: { kind: 'V', description: 'Yellow Aspect Voltage', parameter: 'VSig HG', sensor: '0-150 V AC' },
            hhgV: { kind: 'V', description: 'Double Yellow Aspect Voltage', parameter: 'VSig HHG', sensor: '0-150 V AC' },
            rgV: { kind: 'V', description: 'Red Aspect Voltage', parameter: 'VSig RG', sensor: '0-150 V AC' },
            dgC: { kind: 'C', description: 'Green Aspect Current', parameter: 'ISig DG', sensor: '0-1 A AC' },
            hgC: { kind: 'C', description: 'Yellow Aspect Current', parameter: 'ISig HG', sensor: '0-1 A AC' },
            hhgC: { kind: 'C', description: 'Double Yellow Aspect Current', parameter: 'ISig HHG', sensor: '0-1 A AC' },
            rgC: { kind: 'C', description: 'Red Aspect Current', parameter: 'ISig RG', sensor: '0-1 A AC' }
        };
        function svySignal(cfg) {
            var S = SVY_SIG;
            if (cfg === '2-ASP') return [S.hpr, S.rgV, S.hgV, S.rgC, S.hgC];
            if (cfg === '3-ASP') return [S.hpr, S.dpr, S.rgV, S.dgV, S.hgV, S.rgC, S.dgC, S.hgC];
            if (cfg === '4-ASP') return [S.hpr, S.dpr, S.hhpr, S.rgV, S.hgV, S.dgV, S.hhgV, S.rgC, S.hgC, S.dgC, S.hhgC];
            return [];
        }
        var SVY_COON = [
            { kind: 'V', description: 'CO-HPR Voltage', parameter: 'VCo Sig HPR', sensor: '0-50 V DC' },
            { kind: 'V', description: 'Calling ON Aspect Voltage', parameter: 'VCo Sig', sensor: '0-150 V AC' },
            { kind: 'C', description: 'Calling ON Aspect Current', parameter: 'ICo Sig', sensor: '0-1 A AC' }
        ];
        function svyRoute(cfg) {
            var n = cfg === '1 Route' ? 1 : cfg === '2 Route' ? 2 : cfg === '3 Route' ? 3 : 0;
            var secs = ['AUG', 'BUG', 'CUG'], out = [];
            for (var i = 0; i < n; i++) {
                out.push({ kind: 'V', description: 'Route HPR Voltage - ' + secs[i], parameter: 'VRo Sig HPR', sensor: '0-50 V DC' });
                out.push({ kind: 'V', description: 'Route Aspect Voltage - ' + secs[i], parameter: 'VRo Sig', sensor: '0-150 V AC' });
                out.push({ kind: 'C', description: 'Route Aspect Current - ' + secs[i], parameter: 'IRo Sig', sensor: '0-1 A AC' });
            }
            return out;
        }
        var SVY_SH3 = [
            { kind: 'V', description: 'Shunt HPR Voltage', parameter: 'VShSig HPR', sensor: '0-50 V DC' },
            { kind: 'V', description: 'Shunt ON Aspect Voltage', parameter: 'VShSig ON', sensor: '0-150 V AC' },
            { kind: 'V', description: 'Shunt OFF Aspect Voltage', parameter: 'VShSig OFF', sensor: '0-150 V AC' },
            { kind: 'V', description: 'Shunt PILOT Aspect Voltage', parameter: 'VShSig PILOT', sensor: '0-150 V AC' },
            { kind: 'C', description: 'Shunt ON Aspect Current', parameter: 'IShSig ON', sensor: '0-1 A AC' },
            { kind: 'C', description: 'Shunt OFF Aspect Current', parameter: 'IShSig OFF', sensor: '0-1 A AC' },
            { kind: 'C', description: 'Shunt PILOT Aspect Current', parameter: 'IShSig PILOT', sensor: '0-1 A AC' }
        ];
        function svyPM(end, kind, desc, param, sensor) { return { kind: kind, description: desc, parameter: end + ' ' + param, sensor: sensor }; }
        function svyPoint(cfg, sub) {
            // Series uses one end's set; Parallel has A + B. Full = both ends / normal+reverse.
            function endSet(end) {
                return {
                    nV: svyPM(end, 'V', '110 DC at Loc box for Normal', 'NW V', '0-150 V DC'),
                    rV: svyPM(end, 'V', '110 DC at Loc box for Reverse', 'RW V', '0-150 V DC'),
                    nC: svyPM(end, 'C', 'Point Machine Current Normal', 'NW C', '0-10 A DC'),
                    rC: svyPM(end, 'C', 'Point Machine Current Reverse', 'RW C', '0-10 A DC'),
                    nK: svyPM(end, 'V', '24 V DC to Relay Room after detection (Normal)', 'NWKR LOC', '0-50 V DC'),
                    rK: svyPM(end, 'V', '24 V DC to Relay Room after detection (Reverse)', 'RWKR LOC', '0-50 V DC')
                };
            }
            if (cfg === 'Series') {
                var a = endSet('A-End');
                if (sub === 'Normal End with Indication') return [a.nV, a.nC, a.nK];
                if (sub === 'Reverse End with Indication') return [a.rV, a.rC, a.rK];
                return [a.nV, a.rV, a.nC, a.rC, a.nK, a.rK];   // Full
            }
            if (cfg === 'Parallel') {
                var pa = endSet('A-End'), pb = endSet('B-End');
                var full = [pa.nV, pa.rV, pa.nC, pa.rC, pa.nK, pa.rK, pb.nV, pb.rV, pb.nC, pb.rC, pb.nK, pb.rK];
                if (sub === 'A End') return [pa.nV, pa.rV, pa.nC, pa.rC, pa.nK, pa.rK];
                if (sub === 'B End') return [pb.nV, pb.rV, pb.nC, pb.rC, pb.nK, pb.rK];
                return full;
            }
            return [];
        }
        function svyGearParams(g) {
            var defs;
            switch (g.type) {
                case 'TF': defs = SVY_TF; break;
                case 'TR': defs = SVY_TR; break;
                case 'Signal': defs = svySignal(g.cfg); break;
                case 'CO-ON': defs = SVY_COON; break;
                case 'Route': defs = svyRoute(g.cfg); break;
                case 'Shunt': defs = g.cfg === '3-ASP' ? SVY_SH3 : []; break;   // 1-ASP params not supplied
                case 'Point': defs = svyPoint(g.cfg, g.sub); break;
                default: defs = [];   // AC / BusBar / UFSBI / BHMS: recorded only, no yard rows
            }
            return (defs || []).map(function (x) { return $.extend({}, x, { gearType: g.type, asset: g.name }); });
        }
        function svyPins() { var a = []; for (var i = 1; i <= 10; i++) a.push({ pin: i, used: false }); return a; }
        function svyAllocate(params) {
            var voltage = params.filter(function (p) { return p.kind === 'V'; });
            var current = params.filter(function (p) { return p.kind === 'C'; });
            var cr = svCards(voltage.length, current.length), ai = cr.ai, ci = cr.ci, cards = [];
            for (var i = 1; i <= ai; i++) cards.push({ order: i, card: 'MintCard-' + i, adc: 'ADC ' + i, cardType: 'AI', pins: svyPins() });
            for (var j = 1; j <= ci; j++) cards.push({ order: ai + j, card: 'C-' + j, adc: 'ADC ' + (ai + j), cardType: 'CI', pins: svyPins() });
            var ais = cards.filter(function (c) { return c.cardType === 'AI'; });
            var cis = cards.filter(function (c) { return c.cardType === 'CI'; });
            function assign(card, pin, param, buckel) { var s = card.pins[pin - 1]; s.used = true; s.param = param; s.buckel = buckel ? 'Yes' : 'No'; }
            var vi = 0;
            ais.forEach(function (card) { for (var pin = 1; pin <= 8 && vi < voltage.length; pin++) assign(card, pin, voltage[vi++], false); });
            var curr = current.slice();
            if (ci > 0) cis.forEach(function (card) { for (var pin = 1; pin <= 10 && curr.length; pin++) assign(card, pin, curr.shift(), false); });
            ais.forEach(function (card) { for (var pin = 1; pin <= 8 && curr.length; pin++) { if (!card.pins[pin - 1].used) assign(card, pin, curr.shift(), true); } });
            ais.forEach(function (card) { for (var pin = 9; pin <= 10 && curr.length; pin++) { if (!card.pins[pin - 1].used) assign(card, pin, curr.shift(), false); } });
            while (curr.length) {   // defensive: should not happen given svCards sizing
                var card = { order: cards.length + 1, card: 'C-' + (cis.length + 1), adc: 'ADC ' + (cards.length + 1), cardType: 'CI', pins: svyPins() };
                for (var p = 1; p <= 10 && curr.length; p++) assign(card, p, curr.shift(), false);
                cards.push(card); cis.push(card);
            }
            var rows = [];
            cards.sort(function (a, b) { return a.order - b.order; }).forEach(function (card) {
                card.pins.forEach(function (slot) {
                    if (slot.used) rows.push($.extend({}, slot.param, { card: card.card, adc: card.adc, pin: slot.pin, buckel: slot.buckel, spare: false }));
                    else rows.push({ spare: true, card: card.card, adc: card.adc, pin: slot.pin, buckel: 'No', kind: '-', parameter: 'SPARE', sensor: '-', asset: 'SPARE', gearType: '-' });
                });
            });
            return { rows: rows, ai: ai, ci: ci };
        }
        function svRenderYardPreview() {
            var l = svLoc(SVSEL);
            if (!l) { $('#svYard').html(''); return; }
            var params = [];
            l.gears.forEach(function (g) { params = params.concat(svyGearParams(g)); });
            if (!params.length) { $('#svYard').html('<div class="sv-empty">No wireable gears in this location yet — add TF/TR/Signal/Route/Shunt(3-ASP)/Point/CO-ON to see the yard layout.</div>'); return; }
            var a = svyAllocate(params), used = a.rows.filter(function (r) { return !r.spare; }).length;
            var body = a.rows.map(function (r) {
                return '<tr' + (r.spare ? ' class="sp"' : '') + '><td>' + r.card + '</td><td>' + r.adc + '</td><td class="n">' + r.pin + '</td>'
                    + '<td class="n">' + (r.kind || '-') + '</td>'
                    + '<td>' + (r.spare ? '<span class="sv-muted">—</span>' : locEsc(r.asset) + ' <span class="sv-muted">(' + r.gearType + ')</span>') + '</td>'
                    + '<td>' + (r.spare ? '<span class="sv-muted">SPARE</span>' : locEsc(r.parameter)) + '</td>'
                    + '<td>' + locEsc(r.sensor || '-') + '</td>'
                    + '<td class="n">' + (r.buckel === 'Yes' ? '<b style="color:var(--co-hv)">Yes</b>' : '<span class="sv-muted">' + r.buckel + '</span>') + '</td></tr>';
            }).join('');
            $('#svYard').html('<div class="sv-yh"><div>MintCard (AI)<b>' + a.ai + '</b></div><div>CI card<b>' + a.ci + '</b></div><div>ADC<b>' + (a.ai + a.ci) + '</b></div>'
                + '<div>Pins used<b>' + used + '</b></div><div>Total pins<b>' + a.rows.length + '</b></div></div>'
                + '<div style="overflow-x:auto"><table class="sv-t"><thead><tr><th>Card</th><th>ADC</th><th class="n">Pin</th><th class="n">V/C</th><th>Gear</th><th>Parameter</th><th>Sensor</th><th class="n">Buckel</th></tr></thead><tbody>' + body + '</tbody></table></div>');
        }

        // ── restyle: station-level totals, figures strip and line diagram ──
        function svTotals() {
            var T = { locs: SV.locs.length, gears: 0, v: 0, c: 0, ai: 0, ci: 0, buckel: 0, total: 0, rfs: {}, s: [0, 0, 0, 0, 0, 0, 0, 0] };
            SV.locs.forEach(function (l) {
                var rf = parseInt(l.rf, 10) || 0; if (rf) T.rfs[rf] = 1;
                T.gears += l.gears.length;
                var c = svCalc(l.gears);
                T.v += c.v; T.c += c.c; T.ai += c.cards.ai; T.ci += c.cards.ci; T.buckel += c.cards.buckel; T.total += c.cards.total;
                c.sensors.forEach(function (n, i) { T.s[i] += n; });
            });
            T.rfCount = Object.keys(T.rfs).length;
            return T;
        }

        function svRenderFigs() {
            if (!SV.locs.length) { $('#svFigs').html('<div class="sv-fig"><b>0</b><span>Locations</span><small>Add the first one</small></div>'); return; }
            var T = svTotals();
            var figs = [
                ['Locations', T.locs, T.gears + ' gears', 0],
                ['RF clusters', T.rfCount, 'IoT groups', 0],
                ['Total inputs', T.v + T.c, T.v + ' V · ' + T.c + ' C', 1],
                ['AI cards', T.ai, T.buckel + ' buckel', 0],
                ['CI cards', T.ci, '', 0],
                ['Total cards', T.total, T.ai + ' AI + ' + T.ci + ' CI', 1]
            ];
            $('#svFigs').html(figs.map(function (f) {
                return '<div class="sv-fig' + (f[3] ? ' hl' : '') + '"><b>' + f[1] + '</b><span>' + f[0] + '</span>'
                    + (f[2] ? '<small>' + f[2] + '</small>' : '') + '</div>';
            }).join(''));
        }

        function svRenderDiagram() {
            if (SV.locs.length < 1) { $('#svDiagram').hide().html(''); return; }
            var locs = SV.locs.slice().sort(function (a, b) { return (a.rf - b.rf) || svNatural(a.name, b.name); });
            var gap = 110, pad = 52, y = 72, H = 150;
            var W = pad * 2 + Math.max(0, locs.length - 1) * gap;
            var x = function (i) { return pad + i * gap; };
            var bands = [], cur = null;
            locs.forEach(function (l, i) {
                var rf = parseInt(l.rf, 10) || 0;
                if (!cur || cur.rf !== rf) { cur = { rf: rf, a: i, b: i }; bands.push(cur); } else cur.b = i;
            });
            var s = '';
            bands.forEach(function (bd) {
                var a = x(bd.a) - 38, b = x(bd.b) + 38;
                s += '<rect x="' + a + '" y="' + (y - 34) + '" width="' + (b - a) + '" height="68" rx="14" fill="var(--co-lt)" stroke="var(--bd)"/>'
                   + '<text x="' + (a + 11) + '" y="' + (y - 18) + '" font-size="11" font-weight="700" fill="var(--co-hv)">' + (bd.rf ? 'RF ' + bd.rf : 'No RF') + '</text>';
            });
            s += '<line x1="' + (pad - 28) + '" x2="' + (W - pad + 28) + '" y1="' + y + '" y2="' + y + '" stroke="var(--co)" stroke-width="3"/>';
            locs.forEach(function (l, i) {
                var c = svCalc(l.gears), t = c.v + c.c, has = l.gears.length > 0;
                s += '<g><title>' + locEsc(l.name) + ': ' + c.v + ' V, ' + c.c + ' C</title>'
                   + '<circle cx="' + x(i) + '" cy="' + y + '" r="9" fill="#fff" stroke="' + (has ? 'var(--co)' : 'var(--bd)') + '" stroke-width="3"/>'
                   + '<text x="' + x(i) + '" y="' + (y + 30) + '" text-anchor="middle" font-size="11" font-weight="700" fill="var(--tx)">' + locEsc((l.name || '').slice(0, 13)) + '</text>'
                   + '<text x="' + x(i) + '" y="' + (y + 45) + '" text-anchor="middle" font-size="10" fill="var(--txm)">' + t + ' inputs</text></g>';
            });
            $('#svDiagram').show().html(
                '<div class="sv-diag-in"><svg width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Locations grouped by RF cluster">' + s + '</svg></div>'
                + '<div class="sv-diag-lg"><span><i class="d on"></i>Has gears</span><span><i class="d"></i>Empty</span><span>Bands group locations by RF cluster · ordered by RF then name</span></div>');
        }

        function svRender() {
            if (!SV.loaded) return;
            svRenderLocs(); svRenderDetail(); svRenderSummary(); svRenderFigs(); svRenderDiagram();
            var gears = SV.locs.reduce(function (n, l) { return n + l.gears.length; }, 0);
            var errs = svIssues().filter(function (w) { return w[0] === 'e'; }).length;
            $('#tabSurveyCount').text(SV.locs.length);
            $('#svStamp').toggleClass('dirty', SV.dirty).text(SV.locs.length + ' locations · ' + gears + ' gears' + (errs ? ' · ' + errs + ' to fix' : '') + (SV.dirty ? ' · unsaved changes' : ''));
        }

        // ── Save: locations → one SiteSurvey row each ──
        function svToRequest() {
            var pms = [];
            var rows = SV.locs.map(function (l) {
                var row = { Id: l.id || 0, SiteId: SV.siteId, LocationBoxNo: l.name, Cluster: parseInt(l.rf, 10) || 0, LocationSide: l.side, DistanceFromRR: l.dist, LocToLocDist: l.l2l,
                            TF: [], TR: [], Signal: [], PointMachine: [], AxleCounter: [], BusBar: [], UFSBI: [], BHMS: [] };
                l.gears.forEach(function (g) {
                    var col = SV_TYPES[g.type].col;
                    if (col === 'Signal') (g.asp || []).forEach(function (a) { row.Signal.push(g.name + ' ' + a); });
                    else row[col].push(g.name);
                    if (g.type === 'Point') {
                        var old = SV.pms[g.name] || {}, half = g.sub !== 'Full Point Machine';
                        pms.push({
                            Name: g.name, SiteId: SV.siteId, IsSeriesOpration: g.cfg === 'Series', IsHalfPointMachine: half,
                            // one-end point: 1 = A / Normal end, 2 = B / Reverse end; full point keeps what was stored
                            SeriesOprationTypeId: half ? (/^(B End|Reverse)/.test(g.sub) ? 2 : 1) : (old.seriesOprationTypeId || null),
                            IsThickWave: !!old.isThickWave, ThickWaveTypeId: old.thickWaveTypeId || null,
                            MachineA: old.machineA == null ? null : old.machineA, MachineB: old.machineB == null ? null : old.machineB
                        });
                    }
                });
                Object.keys(row).forEach(function (k) { if (Array.isArray(row[k])) row[k] = row[k].join(','); });
                return row;
            });
            return { SiteId: SV.siteId, Rows: rows, PointMachines: pms };
        }

        function svSave() {
            if (!SV.loaded) { E7.warn('Select a station first'); return; }
            var errs = svIssues().filter(function (w) { return w[0] === 'e'; });
            if (errs.length) { E7.warn(errs.length + ' item(s) to fix before saving: ' + errs[0][1]); document.getElementById('svChecks').scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
            if (!SV.dirty) { E7.success('No changes to save'); return; }
            var $b = $('#svSaveBtn').prop('disabled', true).html('<i class="bi bi-hourglass-split me-1"></i>Saving…');
            var siteId = SV.siteId;
            $.ajax({
                url: '@Url.Action("SaveSurvey", "Station")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(svToRequest()),
                success: function (res) {
                    if (res && res.success) {
                        var p = res.propagated;
                        var extra = p ? ' · added ' + (p.locations || 0) + ' location(s), ' + (p.assets || 0) + ' asset(s)'
                                        + (p.failed ? ' (' + p.failed + ' skipped)' : '') : '';
                        E7.success('Survey saved' + extra);
                        SV.dirty = false; svLoad(siteId, true);
                        // generated Location/Asset records show when you open those tabs (they reload on open)
                        try { if (typeof loadLocations === 'function' && typeof __locSiteId !== 'undefined' && __locSiteId) loadLocations(siteId); } catch (e) { }
                    }
                    else {
                        E7.error((res && res.error) || 'Save failed');
                        if (res && res.partial) { SV.dirty = false; svLoad(siteId, true); }
                    }
                },
                error: function (xhr) { E7.ajaxError(xhr, 'Save failed'); },
                complete: function () { $b.prop('disabled', false).html('<i class="bi bi-cloud-check me-1"></i>Save survey'); }
            });
        }

        window.addEventListener('beforeunload', function (e) { if (SV.dirty) { e.preventDefault(); e.returnValue = ''; } });

        // ══ Survey reporting: CSV / Excel / PDF (client-side, from the live survey data) ════════════
        function svExportGuard() {
            if (!SV.loaded || !SV.locs.length) { E7.warn('Load a station with survey locations first'); return false; }
            return true;
        }
        function svStationName() {
            var t = ($('#ddStation option:selected').text() || '').trim();
            return (t && t !== 'Select Station') ? t : 'Station';
        }
        function svFileName(ext) {
            return svStationName().replace(/[^\w\- ]+/g, '').trim() + ' survey ' + new Date().toISOString().slice(0, 10) + '.' + ext;
        }
        function svDownload(blob, name) {
            var url = URL.createObjectURL(blob), a = document.createElement('a');
            a.href = url; a.download = name; document.body.appendChild(a); a.click();
            setTimeout(function () { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
        }
        // Flatten the survey into report-ready rows + per-location summary + station totals
        function svExportData() {
            var ordered = SV.locs.slice().sort(function (a, b) { return (a.rf - b.rf) || svNatural(a.name, b.name); });
            var rows = [];
            ordered.forEach(function (l) {
                if (!l.gears.length) {
                    rows.push([l.name, l.rf, l.side, l.dist, l.l2l, '', '', '', 'No gears', 0, 0]);
                } else {
                    l.gears.forEach(function (g) {
                        var rule = SV_RULES[svRuleKey(g)];
                        rows.push([l.name, l.rf, l.side, l.dist, l.l2l, g.name, SV_TYPES[g.type].label,
                            svCfgText(g), rule ? rule[0] : 'Recorded only', rule ? rule[1] : 0, rule ? rule[2] : 0]);
                    });
                }
            });
            var summary = ordered.map(function (l) {
                var c = svCalc(l.gears);
                return [l.name, l.rf, l.gears.length, c.v, c.c, c.cards.ai, c.cards.ci, c.cards.buckel, c.cards.total].concat(c.sensors);
            });
            return { ordered: ordered, rows: rows, summary: summary, totals: svTotals() };
        }
        var SV_ROW_HEAD = ['Location', 'RF Cluster', 'Side', 'Dist from RR (m)', 'Loc-to-loc (m)', 'Gear', 'Type', 'Configuration', 'Material rule', 'V', 'C'];
        var SV_SUM_HEAD = ['Location', 'RF', 'Gears', 'V', 'C', 'AI', 'CI', 'Buckel', 'Cards'];

        // ── CSV ──
        function svCsvCell(v) { v = v == null ? '' : String(v); return /[",\r\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }
        function svExportCsv() {
            if (!svExportGuard()) return;
            var d = svExportData(), lines = [SV_ROW_HEAD].concat(d.rows);
            var csv = lines.map(function (r) { return r.map(svCsvCell).join(','); }).join('\r\n');
            svDownload(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' }), svFileName('csv'));
            E7.success('CSV exported');
        }

        // ── Excel (SheetJS, lazy-loaded) ──
        function svLoadXlsx(cb) {
            if (window.XLSX) return cb();
            var s = document.createElement('script');
            s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
            s.onload = function () { cb(); };
            s.onerror = function () { E7.error('Could not load the Excel library (offline?). Use CSV instead.'); };
            document.head.appendChild(s);
        }
        function svExportExcel() {
            if (!svExportGuard()) return;
            svLoadXlsx(function () {
                var d = svExportData(), X = window.XLSX, wb = X.utils.book_new(), T = d.totals;
                X.utils.book_append_sheet(wb, X.utils.aoa_to_sheet([SV_ROW_HEAD].concat(d.rows)), 'Survey');
                var sum = [SV_SUM_HEAD.concat(SV_SENSORS)].concat(d.summary);
                sum.push(['Station total', '', T.gears, T.v, T.c, T.ai, T.ci, T.buckel, T.total].concat(T.s));
                X.utils.book_append_sheet(wb, X.utils.aoa_to_sheet(sum), 'Summary');
                X.writeFile(wb, svFileName('xlsx'));
                E7.success('Excel exported');
            });
        }

        // ── PDF (formatted print view → Save as PDF) ──
        function svExportPdf() {
            if (!svExportGuard()) return;
            var d = svExportData(), T = d.totals, esc = locEsc;
            var sumRows = d.summary.map(function (s) {
                return '<tr><td class="l">' + esc(s[0]) + '</td><td>' + esc(s[1]) + '</td><td>' + s[2] + '</td><td>' + s[3] + '</td><td>' + s[4]
                    + '</td><td>' + s[5] + '</td><td>' + s[6] + '</td><td>' + s[7] + '</td><td><b>' + s[8] + '</b></td></tr>';
            }).join('');
            var gearRows = d.rows.map(function (r) {
                return '<tr><td class="l">' + esc(r[0]) + '</td><td>' + esc(r[1]) + '</td><td class="l">' + esc(r[5]) + '</td><td class="l">' + esc(r[6])
                    + '</td><td class="l">' + esc(r[7]) + '</td><td class="l">' + esc(r[8]) + '</td><td>' + r[9] + '</td><td>' + r[10] + '</td></tr>';
            }).join('');
            // NOTE: build the report with balanced body markup only. Literal structural tags
            // (doctype/html/head/meta/body) make Razor end the script early and dump JS onto the page.
            var css = 'body{font:12px/1.4 Arial,sans-serif;color:#1f2937;margin:24px}h1{font-size:19px;margin:0 0 2px;color:#17365d}'
                + '.meta{color:#64748b;font-size:11px;margin-bottom:14px}h2{font-size:14px;margin:18px 0 6px;color:#17365d}'
                + 'table{width:100%;border-collapse:collapse;font-size:11px;margin-bottom:6px}th,td{border:1px solid #d6dee8;padding:4px 6px;text-align:center}'
                + 'th{background:#17365d;color:#fff}td.l,th.l{text-align:left}tfoot td{background:#eef4fb;font-weight:700}';
            var html = '<style>' + css + '</style>'
                + '<h1>' + esc(svStationName()) + ' — Survey report</h1>'
                + '<div class="meta">Generated ' + new Date().toLocaleString() + ' · ' + T.locs + ' locations · ' + T.rfCount + ' RF clusters · ' + T.gears + ' gears</div>'
                + '<h2>Location summary</h2><table><thead><tr><th class="l">Location</th><th>RF</th><th>Gears</th><th>V</th><th>C</th><th>AI</th><th>CI</th><th>Buckel</th><th>Cards</th></tr></thead>'
                + '<tbody>' + sumRows + '</tbody><tfoot><tr><td class="l">Station total</td><td></td><td>' + T.gears + '</td><td>' + T.v + '</td><td>' + T.c + '</td><td>' + T.ai + '</td><td>' + T.ci + '</td><td>' + T.buckel + '</td><td>' + T.total + '</td></tr></tfoot></table>'
                + '<h2>Gears</h2><table><thead><tr><th class="l">Location</th><th>RF</th><th class="l">Gear</th><th class="l">Type</th><th class="l">Config</th><th class="l">Material rule</th><th>V</th><th>C</th></tr></thead><tbody>' + gearRows + '</tbody></table>';
            var w = window.open('', '_blank');
            if (!w) { E7.warn('Allow pop-ups to export the PDF report'); return; }
            w.document.write(html); w.document.title = svStationName() + ' survey'; w.document.close(); w.focus();
            setTimeout(function () { try { w.print(); } catch (e) { } }, 350);
        }

        // JSON is camelCased by ASP.NET ("tr", "ufsbi", "pointMachine"…), so match keys case-insensitively
        function gearVal(r, key) {
            var lk = key.toLowerCase();
            for (var k in r) if (k.toLowerCase() === lk) return r[k] != null ? r[k] : '';
            return '';
        }

        function locWiredCount(clusterId) {
            return __cardLines.filter(function (r) { return r.clusterId === clusterId && r.assetId; }).length;
        }

        function locChip(l) {
            var wired = locWiredCount(l.id);
            return '<div class="clust-loc-wrap"><div class="clust-loc-inner" draggable="true" data-loc-id="' + l.id + '" '
                 +   'ondragstart="__locDragId=' + l.id + ';this.style.opacity=.4" ondragend="this.style.opacity=\'\'" '
                 +   'title="' + locEsc(l.name) + (l.modemId ? ' · Modem ' + locEsc(l.modemId) : '') + '">'
                 +   '<span class="grip" style="color:var(--txl)">⠿</span>'
                 +   '<span class="cl-name">' + locEsc(l.location) + '</span>'
                 +   '<span class="cl-info">' + (l.typeId === 1 ? 'Indoor' : 'Outdoor') + '</span>'
                 +   (l.powerSupplyId ? '<span class="cl-info" style="color:var(--info)">' + LOC_POWER[l.powerSupplyId] + '</span>'
                                      : '<span class="cl-info" style="color:var(--warn)">no PS</span>')
                 +   '<span class="cl-info">' + wired + ' wired</span>'
                 +   '<span class="cl-set" title="Photos of this location" onclick="event.stopPropagation();openPhotos(' + l.id + ')"><i class="bi bi-camera"></i> photos</span>'
                 +   '<span class="cl-set" onclick="editLocation(' + l.id + ')">edit</span>'
                 +   '<span class="cl-set" style="color:var(--err)" title="Remove this location (soft delete)" onclick="event.stopPropagation();deleteLocation(' + l.id + ')"><i class="bi bi-trash"></i> remove</span>'
                 + '</div></div>';
        }

        function renderLocations() {
            var byRf = {};
            var pool = [];
            __locations.forEach(function (l) {
                if (l.rfCluster) (byRf[l.rfCluster] = byRf[l.rfCluster] || []).push(l); else pool.push(l);
            });
            __extraRfBoxes.forEach(function (n) { byRf[n] = byRf[n] || []; });

            $('#locPool').html(pool.length ? pool.map(locChip).join('')
                : '<div style="font-size:10px;color:var(--txl)">None — every location has an RF cluster</div>');

            var rfs = Object.keys(byRf).map(Number).sort(function (a, b) { return a - b; });
            var html = '';
            rfs.forEach(function (n) {
                var locs = byRf[n];
                html += '<div class="clust-box">'
                      +   '<div class="clust-head"><span class="cn">RF Cluster ' + n + '</span>'
                      +     '<span class="ct group">' + locs.length + ' location' + (locs.length === 1 ? '' : 's') + '</span></div>'
                      +   '<div class="clust-drop" data-rf="' + n + '" ondragover="event.preventDefault();this.classList.add(\'drag-over\')" '
                      +     'ondragleave="this.classList.remove(\'drag-over\')" ondrop="dropLocation(event,this)">'
                      +     (locs.length ? locs.map(locChip).join('') : '<div class="empty-msg">Drag a location here, or add one with this RF cluster</div>')
                      +   '</div>'
                      + '</div>';
            });
            $('#locClusters').html(html || '<div style="font-size:11px;color:var(--txm)">No locations yet — create one above</div>');
            $('#tabLocationCount').text(__locations.length);

            // RF cluster dropdowns (1–50, as on 90). Create Location defaults to the first existing RF cluster.
            var used = {}; rfs.forEach(function (n) { used[n] = true; });
            var rfOpts = '', freeOpts = '';
            for (var i = 1; i <= 50; i++) {
                rfOpts += '<option value="' + i + '">RF ' + i + (used[i] ? '' : ' (new)') + '</option>';
                if (!used[i]) freeOpts += '<option value="' + i + '">RF Cluster ' + i + '</option>';
            }
            var keep = $('#locNewRf').val();
            $('#locNewRf').html(rfOpts).val(keep || (rfs[0] || 1));
            $('#locNewCluster').html(freeOpts || '<option value="">All 50 in use</option>');
        }

        function addRfClusterBox() {
            if (!__locSiteId) { E7.warn('Select a station first'); return; }
            var n = parseInt($('#locNewCluster').val(), 10);
            if (!n) return;
            __extraRfBoxes.push(n);
            renderLocations();
            $('#locNewRf').val(n);
        }

        function saveLocation(data, done) {
            $.ajax({
                url: '@Url.Action("SaveLocation", "Station")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {
                    if (res && res.success) { E7.success('Location "' + data.LocationName + '" ' + (data.Id ? 'saved' : 'created')); if (done) done(); loadLocations(__locSiteId); }
                    else E7.error((res && res.error) || 'Save failed');
                },
                error: function (xhr) { E7.ajaxError(xhr); }
            });
        }

        function createLocation() {
            if (!__locSiteId) { E7.warn('Select a station first'); return; }
            var name = $('#locNewName').val().trim();
            if (!name) { E7.warn('Enter a location name'); $('#locNewName').focus(); return; }
            saveLocation({
                Id: 0, SiteId: __locSiteId, LocationName: name,
                TypeId: parseInt($('#locNewType').val(), 10),
                PowerSupplyId: parseInt($('#locNewPower').val(), 10) || null,
                RfCluster: parseInt($('#locNewRf').val(), 10)
            }, function () { $('#locNewName').val(''); });
        }

        // Soft-delete a location (Cluster): marks it deleted via the API, keeps the row, cascades to its ADCs/cards.
        function deleteLocation(id) {
            var l = (__locations || []).filter(function (x) { return x.id === id; })[0]
                 || (typeof __ycClusters !== 'undefined' ? __ycClusters.filter(function (x) { return x.id === id; })[0] : null);
            var name = l ? (l.location || l.name || ('location ' + id)) : ('location ' + id);
            if (!confirm('Remove "' + name + '"?\n\nThis soft-deletes the location (marked deleted, not erased) along with its ADCs and cards. '
                       + 'It disappears from the lists but the row is kept and can be restored.')) return;
            var siteId = parseInt((typeof __currentSiteId !== 'undefined' && __currentSiteId) || __locSiteId || 0, 10) || 0;
            $.ajax({
                url: '@Url.Action("DeleteLocation", "Station")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ Id: id, SiteId: siteId }),
                success: function (res) {
                    if (res && res.success) {
                        E7.success('Location "' + name + '" removed');
                        if (typeof __locSiteId !== 'undefined' && __locSiteId) loadLocations(__locSiteId);
                        if (typeof __ycSite !== 'undefined' && __ycSite) { __ycSite = 0; ycOnOpen(); }   // refresh Yard Config if loaded
                    } else E7.error((res && res.error) || 'Could not remove location');
                },
                error: function (xhr) { E7.ajaxError(xhr, 'Could not remove location'); }
            });
        }

        function editLocation(id) {
            var l = __locations.filter(function (x) { return x.id === id; })[0];
            if (!l) return;
            var rfOpts = '';
            for (var i = 1; i <= 50; i++) rfOpts += '<option value="' + i + '">RF ' + i + '</option>';
            $('#locEditRf').html(rfOpts).val(l.rfCluster || $('#locNewRf').val());
            $('#locEditId').val(l.id);
            $('#locEditName').val(l.location);
            $('#locEditType').val(l.typeId === 1 ? '1' : '2');
            $('#locEditPower').val(l.powerSupplyId ? String(l.powerSupplyId) : '');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('locEditModal')).show();
        }

        function saveEditedLocation() {
            var l = __locations.filter(function (x) { return x.id === parseInt($('#locEditId').val(), 10); })[0];
            if (!l) return;
            var rf = parseInt($('#locEditRf').val(), 10);
            if (l.rfCluster && rf !== l.rfCluster &&
                !confirm('Move "' + l.location + '" to RF Cluster ' + rf + ' at this station only?\n\n'
                       + 'The 90 site will also show this station\'s location under RF Cluster ' + rf + '.')) return;
            saveLocation({
                Id: l.id, SiteId: __locSiteId,
                LocationName: $('#locEditName').val().trim(),
                TypeId: parseInt($('#locEditType').val(), 10),
                PowerSupplyId: parseInt($('#locEditPower').val(), 10) || null,
                RfCluster: rf
            }, function () { bootstrap.Modal.getOrCreateInstance(document.getElementById('locEditModal')).hide(); });
        }

        function dropLocation(e, box) {
            e.preventDefault();
            box.classList.remove('drag-over');
            var l = __locations.filter(function (x) { return x.id === __locDragId; })[0];
            __locDragId = 0;
            var rf = parseInt(box.getAttribute('data-rf'), 10);
            if (!l || !rf || l.rfCluster === rf) return;
            if (!confirm('Move "' + l.location + '" to RF Cluster ' + rf + ' at this station only?\n\n'
                       + 'The 90 site will also show this station\'s ' + l.location + ' under RF Cluster ' + rf + '.')) return;
            saveLocation({ Id: l.id, SiteId: __locSiteId, LocationName: l.location, TypeId: l.typeId || 2,
                           PowerSupplyId: l.powerSupplyId || null, RfCluster: rf });
        }

        // ── SURVEY stage checklist ─────────────────────────────────────────────────
        function loadSurveyChecklist(siteId) {
            $('#surveyList').html('<div style="color:var(--txm);font-size:11px">Loading…</div>');
            $.ajax({
                url: '@Url.Action("GetSurveyChecklist", "Station")',
                data: { siteId: siteId },
                success: function (res) {
                    if (!res || res.error) { $('#surveyList').html('<div style="color:var(--err);font-size:11px">' + ((res && res.error) || 'Failed to load') + '</div>'); return; }
                    renderSurveyChecklist(siteId, res);
                },
                error: function (xhr) { $('#surveyList').html('<div style="color:var(--err);font-size:11px">Request failed</div>'); }
            });
        }

        function renderSurveyChecklist(siteId, s) {
            var html = '';
            (s.items || []).forEach(function (it) {
                html += '<label style="display:flex;align-items:flex-start;gap:8px;padding:4px 0;cursor:pointer;margin:0">'
                      +   '<input type="checkbox" style="margin-top:2px" ' + (it.done ? 'checked' : '')
                      +     ' onchange="saveSurveyItem(' + siteId + ',' + it.itemNo + ',this)">'
                      +   '<span><b style="color:var(--txm)">' + it.itemNo + '.</b> ' + $('<div>').text(it.title).html()
                      +     (it.done && it.doneOn ? ' <span style="font-size:10px;color:var(--ok)">✓ ' + it.doneOn + '</span>' : '')
                      +   '</span>'
                      + '</label>';
            });
            $('#surveyList').html(html);
            $('#surveyProgress').text(s.doneCount + ' / ' + s.total);
            $('#surveyBar').css('width', (s.total ? Math.round(100 * s.doneCount / s.total) : 0) + '%');
            $('#surveyStageBadge')
                .text(s.stageCompleted ? 'Completed' + (s.completedOn ? ' · ' + s.completedOn : '') : 'In Progress')
                .css({ background: s.stageCompleted ? 'var(--ok)' : 'var(--co-lt)', color: s.stageCompleted ? '#fff' : 'var(--co)' });
        }

        function saveSurveyItem(siteId, itemNo, chk) {
            var $all = $('#surveyList input').prop('disabled', true);
            $.ajax({
                url: '@Url.Action("SaveSurveyChecklistItem", "Station")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ SiteId: siteId, ItemNo: itemNo, Done: chk.checked }),
                success: function (res) {
                    if (!res || res.error) { E7.error((res && res.error) || 'Save failed'); chk.checked = !chk.checked; $all.prop('disabled', false); return; }
                    E7.success('Checklist item ' + itemNo + (chk.checked ? ' marked done' : ' marked not done'));
                    renderSurveyChecklist(siteId, res);
                },
                error: function (xhr) { E7.ajaxError(xhr); chk.checked = !chk.checked; $all.prop('disabled', false); }
            });
        }

        function bindStats(data) {
            if (!data || data.error) { resetStats(); return; }
            $('#statLocations,#statClusters,#statDataPoints,#statAssets').css('opacity', '');

            $('#statLocations').text(data.totalLocations ?? 0);
            $('#statLocationsSub').text((data.totalLocations ?? 0) + ' unique locations');
            $('#statClusters').text(data.totalClusters ?? 0);
            $('#statClustersSub').text((data.totalClusters ?? 0) + ' unique clusters');
            $('#statDataPoints').text(data.totalDataPoints ?? 0);
            $('#statDataPointsSub').text('Asset × Attribute combinations');
            $('#statAssets').text(data.totalAssets ?? 0);
            $('#statAssetsSub').text(data.assetBreakdown || '—');
            $('#tabAssetCount').text(data.totalAssets ?? 0);
            $('#tabLocationCount').text(data.totalLocations ?? 0);

            // Capture CardLine records + per-type counts for drill-down
            __cardLines = data.records || [];
            __cardLineTypeCounts = {};
            if (data.assetTypeCounts && data.assetTypeCounts.length) {
                data.assetTypeCounts.forEach(function (t) {
                    __cardLineTypeCounts[t.assetTypeId] = {
                        count: t.count || 0,
                        dataPoints: t.dataPoints || 0,
                        name: t.assetTypeName
                    };
                });
            }

            // "N wired" counts on the Location tab come from these card lines
            if (__locations.length) renderLocations();

            // Re-render sidebar only if site types are already loaded
            // (so counts update in-place without changing the type list)
            if (__siteAssetTypes.length) {
                renderAssetTypeSidebar();
            }
        }
        function resetStats() {
            $('#statLocations,#statClusters,#statDataPoints,#statAssets').css('opacity', '');
            ['statLocations','statClusters','statDataPoints','statAssets'].forEach(function(id) {
                $('#' + id).text('—');
            });
            ['statLocationsSub','statClustersSub','statDataPointsSub','statAssetsSub'].forEach(function(id) {
                $('#' + id).text('—');
            });
            $('#infoName, #infoCode, #infoZoneDiv').text('—');
            $('#stationInfo').text('');
            $('#tabLocationCount, #tabAssetCount').text('—');
            $('#atList').html('<li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">Select a station</li>');
        }

        // ── Tab switching ─────────────────────────────────────────────────────────────
        document.querySelectorAll('.etab').forEach(function(tab) {
            tab.addEventListener('click', function() {
                document.querySelectorAll('.etab').forEach(function(t) { t.classList.remove('on'); });
                document.querySelectorAll('.tp').forEach(function(p) { p.classList.remove('on'); });
                tab.classList.add('on');
                var panel = document.getElementById('tab-' + tab.dataset.tab);
                if (panel) panel.classList.add('on');
                if (tab.dataset.tab === 'yard') ycOnOpen();
                if (tab.dataset.tab === 'material') mpOnOpen();
            });
        });


