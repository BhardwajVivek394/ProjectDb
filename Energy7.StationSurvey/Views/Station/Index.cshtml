        function renderWireSummary(records, total, done) {
            ensureWireCss();
            if (!total) { $('#wireSum').html(''); return; }
            var pct = Math.round(done * 100 / total);
            var perCard = {};
            records.forEach(function (r) {
                var k = (r.clusterName || 'cluster ?') + ' · ' + (r.cardName || 'card ?');
                perCard[k] = (perCard[k] || 0) + 1;
            });
            var chips = Object.keys(perCard).sort().map(function (k) {
                return '<span class="wsum-chip" title="' + perCard[k] + ' line' + (perCard[k] > 1 ? 's' : '') + ' of this asset on ' + locEsc(k) + '">'
                     + locEsc(k) + ' <b>' + perCard[k] + '</b></span>';
            }).join('');
            $('#wireSum').html(
                '<div class="wsum">'
              +   '<div style="display:flex;align-items:center;gap:10px">'
              +     '<b style="font-size:12px">Wired ' + done + ' of ' + total + ' attributes</b>'
              +     '<div class="wsum-bar"><i style="width:' + pct + '%"></i></div>'
              +     '<span style="font-size:10px;color:var(--txm)">' + (total - done) + ' left</span>'
              +   '</div>'
              +   (chips ? '<div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:5px;align-items:center"><span style="font-size:10px;color:var(--txm)">Cards used:</span>' + chips + '</div>'
                         : '<div style="margin-top:4px;font-size:10px;color:var(--txl)">Not on any card yet — click Wire on an attribute below.</div>')
              + '</div>');
        }

        // ── Wire dialog: 1 Cluster → 2 Card (used/total) → 3 Line grid → 4 ADC/Pin (optional) ──
        var __wm = { assetId: 0, attrId: 0, typeId: 0, attrName: '', clusterId: 0, cards: [], cardId: 0, lineId: 0 };
        var __wmLast = { siteId: 0, clusterId: 0, cardId: 0 };

        function ensureWireModal() {
            ensureWireCss();
            if (document.getElementById('wireModal')) return;
            var pins = '<option value="">Pin</option>';
            for (var i = 1; i <= 10; i++) pins += '<option value="' + i + '">Pin ' + i + '</option>';
            $('body').append(
                '<div class="modal fade" id="wireModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">'
              +   '<div class="modal-header"><h5 class="modal-title"><i class="bi bi-diagram-3 me-2" style="color:var(--co)"></i>Wire <span id="wmTitle"></span></h5>'
              +     '<button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>'
              +   '<div class="modal-body">'
              +     '<div class="wm-step"><div class="wm-lbl"><span class="no">1</span>Cluster</div><select class="form-select form-select-sm" id="wmCluster" onchange="wmPickCluster(this.value)"></select></div>'
              +     '<div class="wm-step"><div class="wm-lbl"><span class="no">2</span>Card <span id="wmCardInfo" class="wm-hint"></span></div><div id="wmCards" class="wm-grid"><span class="wm-hint">Select a cluster first</span></div></div>'
              +     '<div class="wm-step"><div class="wm-lbl"><span class="no">3</span>Line <span id="wmLineInfo" class="wm-hint"></span></div><div id="wmLines" class="wm-grid"><span class="wm-hint">Select a card first</span></div>'
              +       '<div class="wm-legend"><span><i></i>Free</span><span><i style="background:var(--co);border-color:var(--co)"></i>Selected</span><span><i style="background:#f1eeec"></i>Used (hover to see by whom)</span></div></div>'
              +     '<div class="wm-step"><div class="wm-lbl"><span class="no">4</span>ADC / Pin <span class="wm-hint">optional — pick both or neither</span></div>'
              +       '<div style="display:flex;gap:8px;max-width:360px"><select class="form-select form-select-sm" id="wmAdc" onchange="wmSummary()"><option value="">No ADC</option></select>'
              +       '<select class="form-select form-select-sm" id="wmPin" onchange="wmSummary()">' + pins + '</select></div></div>'
              +     '<div id="wmSummary"></div>'
              +   '</div>'
              +   '<div class="modal-footer" style="border-top:1px solid var(--bd);padding:10px 18px">'
              +     '<span id="wmLeft" class="wm-hint" style="margin-right:auto"></span>'
              +     '<button class="bg7" data-bs-dismiss="modal">Cancel</button>'
              +     '<button class="bg7" id="wmSaveNext" onclick="saveWire(true)" disabled title="Wire this one and open the next unwired attribute on the same card">Wire &amp; next</button>'
              +     '<button class="be7" id="wmSave" onclick="saveWire(false)" disabled>Wire</button>'
              +   '</div>'
              + '</div></div></div>');
        }

        function openWire(btn) {
            ensureWireModal();
            var $row = $(btn).closest('.ar');
            __wm = {
                assetId: __wireAsset,
                attrId: parseInt($row.data('attr-id'), 10) || 0,
                typeId: parseInt($row.data('type-id'), 10) || 0,
                attrName: $row.attr('data-attr-name') || $row.find('.aname').text(),
                clusterId: 0, cards: [], cardId: 0, lineId: 0
            };
            $('#wmTitle').text(__wm.attrName + ' — ' + ($('#selAN').text() || ''));
            var leftN = $('#wireBox .wr').length;
            $('#wmLeft').text(leftN ? leftN + ' attribute' + (leftN > 1 ? 's' : '') + ' of this asset still to wire' : '');
            $('#wmCards').html('<span class="wm-hint">Select a cluster first</span>');
            $('#wmLines').html('<span class="wm-hint">Select a card first</span>');
            $('#wmCardInfo, #wmLineInfo').text('');
            $('#wmAdc').html('<option value="">No ADC</option>'); $('#wmPin').val('');
            wmSummary();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('wireModal')).show();

            $('#wmCluster').html('<option value="">Loading…</option>');
            $.ajax({
                url: '@Url.Action("GetWireClusters", "Station")', data: { siteId: __currentSiteId },
                success: function (res) {
                    if (!Array.isArray(res)) { $('#wmCluster').html('<option value="">' + locEsc((res && res.error) || 'Could not load clusters') + '</option>'); return; }
                    if (!res.length) { $('#wmCluster').html('<option value="">No clusters — add a location first (Location tab)</option>'); return; }
                    $('#wmCluster').html('<option value="">Select cluster…</option>' + res.map(function (c) {
                        return '<option value="' + c.id + '">' + locEsc(c.name) + '  (' + (c.wired || 0) + ' line' + (c.wired === 1 ? '' : 's') + ' wired)</option>';
                    }).join(''));
                    // reopen on the cluster / card used last time on this station
                    var last = __wmLast.siteId === __currentSiteId && res.some(function (c) { return c.id === __wmLast.clusterId; }) ? __wmLast.clusterId : 0;
                    if (!last && res.length === 1) last = res[0].id;
                    if (last) { $('#wmCluster').val(String(last)); wmPickCluster(last, __wmLast.cardId); }
                }
            });
        }

        function wmPickCluster(clusterId, preferCardId) {
            __wm.clusterId = parseInt(clusterId, 10) || 0;
            __wm.cards = []; __wm.cardId = 0; __wm.lineId = 0;
            $('#wmLines').html('<span class="wm-hint">Select a card first</span>'); $('#wmLineInfo').text('');
            $('#wmAdc').html('<option value="">No ADC</option>');
            wmSummary();
            if (!__wm.clusterId) { $('#wmCards').html('<span class="wm-hint">Select a cluster first</span>'); $('#wmCardInfo').text(''); return; }
            $('#wmCards').html('<span class="wm-hint">Loading cards…</span>');
            var cid = __wm.clusterId;
            $.ajax({
                url: '@Url.Action("GetWireCards", "Station")', data: { clusterId: cid },
                success: function (res) {
                    if (cid !== __wm.clusterId) return;
                    if (!res || res.error) { $('#wmCards').html('<span class="wm-hint" style="color:var(--err)">' + locEsc((res && res.error) || 'Could not load cards') + '</span>'); return; }
                    __wm.cards = res.cards || [];
                    $('#wmAdc').html('<option value="">No ADC</option>' + (res.adcs || []).map(function (a) { return '<option value="' + a.id + '">' + locEsc(a.name) + '</option>'; }).join(''));
                    renderWmCards();
                    // Pre-select: the card asked for (last used / just added), else the first card of the
                    // attribute's kind (C for mA, voltage card for V) that still has a free line
                    var hasFree = function (c) { return c.used < c.total; };
                    var want = wmAttrKind(__wm.attrName);
                    var pick = __wm.cards.filter(function (c) { return c.id === preferCardId && hasFree(c); })[0]
                            || __wm.cards.filter(function (c) { return wmCardKind(c.name) === want && hasFree(c); })[0];
                    if (pick) wmPickCard(pick.id);
                    else if (__wm.cards.length) $('#wmLines').html('<span class="wm-hint">No free ' + (want === 'I' ? 'current (C)' : 'voltage') + ' card here — pick another card or add one</span>');
                }
            });
        }

        function renderWmCards() {
            var cards = __wm.cards;
            var used = 0, total = 0;
            cards.forEach(function (c) { used += c.used; total += c.total; });
            $('#wmCardInfo').text(cards.length ? cards.length + ' card' + (cards.length > 1 ? 's' : '') + ' · ' + used + ' / ' + total + ' lines used'
                                               : 'this cluster has no cards yet — add one →');
            var want = wmAttrKind(__wm.attrName);
            var kindLbl = { I: 'CURRENT', V: 'VOLTAGE', DI: 'DIGITAL', M: 'MINT' };
            var html = cards.map(function (c) {
                var pct = c.total ? Math.round(c.used * 100 / c.total) : 0;
                var full = c.total && c.used >= c.total;
                var k = wmCardKind(c.name);
                return '<div class="wm-card k-' + k + (c.id === __wm.cardId ? ' on' : '') + (full ? ' full' : '') + '" '
                     +   (full ? '' : 'onclick="wmPickCard(' + c.id + ')" ')
                     +   'title="' + locEsc(c.name) + ' (' + kindLbl[k].toLowerCase() + ' card): ' + c.used + ' of ' + c.total + ' lines used' + (full ? ' — full' : '') + '">'
                     +   '<span class="kb">' + kindLbl[k] + (k === want ? ' ✓' : '') + '</span>'
                     +   '<div class="nm">' + locEsc(c.name) + '</div>'
                     +   '<div class="ct">' + (c.total - c.used) + ' free · ' + c.used + '/' + c.total + ' used' + (full ? ' · full' : '') + '</div>'
                     +   '<div class="bar"><i style="width:' + pct + '%"></i></div>'
                     + '</div>';
            }).join('');
            var types = ['C', 'V5', 'V82', 'MintCard', 'DI'].map(function (t) {
                return '<option value="' + t + '"' + ((want === 'I' ? 'C' : 'V5') === t ? ' selected' : '') + '>' + t + '</option>';
            }).join('');
            html += '<div class="wm-card wm-add" title="Add the next card of this type to the cluster (the API creates its empty lines)">'
                  +   '<div class="nm">+ Add card</div>'
                  +   '<div style="display:flex;gap:4px;margin-top:4px"><select id="wmCardType" class="form-select form-select-sm" style="width:96px;font-size:11px;padding:1px 24px 1px 6px">' + types + '</select>'
                  +   '<button class="be7" style="padding:3px 10px" onclick="wmAddCard(this)">Add</button></div>'
                  + '</div>';
            $('#wmCards').html(html);
        }

        function wmPickCard(cardId) {
            __wm.cardId = cardId; __wm.lineId = 0;
            renderWmCards();
            var card = __wm.cards.filter(function (c) { return c.id === cardId; })[0];
            if (!card) return;
            var free = card.lines.filter(function (l) { return !l.used; });
            $('#wmLineInfo').text(free.length + ' free of ' + card.lines.length + (free.length ? ' · first free line is pre-selected' : ' — card is full, pick or add another card'));
            $('#wmLines').html(card.lines.map(function (l) {
                var who = l.used ? ((l.assetName || 'in use') + (l.attributeName ? ' · ' + l.attributeName : '')) : 'Free';
                return '<button type="button" class="wm-line' + (l.used ? ' used' : '') + '" data-line="' + l.id + '" '
                     + (l.used ? 'disabled ' : 'onclick="wmPickLine(' + l.id + ')" ')
                     + 'title="Line ' + l.number + ': ' + locEsc(who) + '">L' + l.number + '</button>';
            }).join('') || '<span class="wm-hint">This card has no lines</span>');
            if (free.length) wmPickLine(free[0].id);
            else wmSummary();
        }

        function wmPickLine(lineId) {
            __wm.lineId = lineId;
            $('#wmLines .wm-line').removeClass('on');
            $('#wmLines .wm-line[data-line="' + lineId + '"]').addClass('on');
            wmSummary();
        }

        function wmSummary() {
            var cl = $('#wmCluster option:selected').text().replace(/\s+\(.*\)$/, '');
            var card = __wm.cards.filter(function (c) { return c.id === __wm.cardId; })[0];
            var line = card && card.lines.filter(function (l) { return l.id === __wm.lineId; })[0];
            var adc = $('#wmAdc').val(), pin = $('#wmPin').val();
            var ok = !!line && (!!adc === !!pin);
            $('#wmSave, #wmSaveNext').prop('disabled', !ok);
            $('#wmSaveNext').toggle($('#wireBox .wr').length > 1);   // only when another attribute is waiting
            if (!line) { $('#wmSummary').html('<span style="color:var(--txm)">Pick a cluster, a card and a free line.</span>'); return; }
            var where = '<b>' + locEsc(cl) + '</b> · <b>' + locEsc(card.name) + '</b> · <b>Line ' + line.number + '</b>'
                      + (adc && pin ? ' · ' + locEsc($('#wmAdc option:selected').text()) + ' Pin ' + pin : '');
            var want = wmAttrKind(__wm.attrName), got = wmCardKind(card.name);
            var warn = (want === 'I' && got !== 'I') ? 'This is a current (mA) attribute but ' + locEsc(card.name) + ' is not a C (current) card.'
                     : (want === 'V' && got === 'I') ? 'This is a voltage attribute but ' + locEsc(card.name) + ' is a C (current) card.' : '';
            $('#wmSummary').html('<b>' + locEsc(__wm.attrName) + '</b> → ' + where
                + (warn ? '<div class="warn">⚠ ' + warn + ' You can still wire it if that is how it is connected.</div>' : '')
                + (!!adc !== !!pin ? '<div class="err">Select both ADC and Pin, or neither.</div>' : ''));
        }

        function wmAddCard(btn) {
            var ct = $('#wmCardType').val();
            if (!__wm.clusterId) return;
            if (!confirm('Add a new ' + ct + ' card (with its empty lines) to this cluster? This is saved immediately.')) return;
            btn.disabled = true; btn.textContent = '…';
            var cid = __wm.clusterId;
            $.ajax({
                url: '@Url.Action("AddClusterCard", "Station")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ SiteId: parseInt(__currentSiteId, 10) || 0, ClusterId: cid, CardType: ct }),
                success: function (res) {
                    if (!(res && res.success)) { E7.error((res && res.error) || 'Could not add card'); btn.disabled = false; btn.textContent = 'Add'; return; }
                    E7.success(ct + ' card added');
                    wmPickCluster(cid, res.cardId);   // reload tiles with counts and select the new card
                },
                error: function (xhr) { E7.ajaxError(xhr); btn.disabled = false; btn.textContent = 'Add'; }
            });
        }

        // next = true → after saving, open the next unwired attribute on the same cluster / card
        function saveWire(next) {
            var assetId = __wm.assetId;
            var body = {
                SiteId: parseInt(__currentSiteId, 10) || 0,
                ClusterId: __wm.clusterId, CardId: __wm.cardId, CardLineId: __wm.lineId,
                AssetTypeId: __wm.typeId, AssetId: assetId, AttributeId: __wm.attrId,
                ADCId: parseInt($('#wmAdc').val(), 10) || null,
                Pin: parseInt($('#wmPin').val(), 10) || null
            };
            if (!body.CardLineId) { E7.warn('Select cluster, card and line'); return; }
            if (!!body.ADCId !== !!body.Pin) { E7.warn('Select both ADC and Pin, or neither'); return; }
            var $btns = $('#wmSave, #wmSaveNext').prop('disabled', true);
            var $btn = next ? $('#wmSaveNext') : $('#wmSave');
            var label = $btn.text();
            $btn.text('Saving…');
            var wiredAttrId = __wm.attrId;
            $.ajax({
                url: '@Url.Action("WireCardLine", "Station")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify(body),
                success: function (res) {
                    $btn.text(label);
                    if (!(res && res.success)) { E7.error((res && res.error) || 'Wire failed'); $btns.prop('disabled', false); return; }
                    E7.success('Line wired');
                    __wmLast = { siteId: __currentSiteId, clusterId: __wm.clusterId, cardId: __wm.cardId };
                    if (!next) bootstrap.Modal.getOrCreateInstance(document.getElementById('wireModal')).hide();
                    reloadCardLines(function () {
                        if (__wireAsset !== assetId) return;
                        loadAttributesForAsset(assetId);
                        // briefly highlight the newly wired row so it is easy to spot
                        var $new = $('#modeA .ar[data-cardline-id="' + res.id + '"]');
                        $new.css({ background: '#e7f5ee', transition: 'background 1.5s' });
                        if ($new[0] && !next) $new[0].scrollIntoView({ block: 'nearest' });
                        setTimeout(function () { $new.css('background', ''); }, 2500);
                        if (next) {
                            // attribute list is cached, so #wireBox is already redrawn without the one just wired
                            var $nextRow = $('#wireBox .wr').filter(function () { return parseInt($(this).data('attr-id'), 10) !== wiredAttrId; }).first();
                            if ($nextRow.length) openWire($nextRow.find('button')[0]);
                            else bootstrap.Modal.getOrCreateInstance(document.getElementById('wireModal')).hide();
                        }
                    });
                },
                error: function (xhr) { $btn.text(label); $btns.prop('disabled', false); E7.ajaxError(xhr); }
            });
        }

        // Refresh __cardLines without re-rendering the sidebar (keeps the current type / asset selected)
        function reloadCardLines(done) {
            var siteId = __currentSiteId;
            $.ajax({
                url: '@Url.Action("GetCardLineBySiteId", "Station")', data: { siteId: siteId },
                success: function (data) {
                    if (siteId !== __currentSiteId) return;
                    if (data && Array.isArray(data.records)) __cardLines = data.records;
                    if (done) done();
                }
            });
        }
                function selectAsset(el, assetId) {
            $('#trackList .air, #trackList .fot-parent, #trackList .fot-child').removeClass('sel');
            $(el).addClass('sel');
            var assetName = $(el).text().trim();
            $('#selAN').text(assetName);
            loadAttributesForAsset(assetId);
            // Open the Add Asset modal pre-filled with this asset
            openAddAssetModal(assetId, assetName);
        }
        var __modalAsset    = null;
        var __modalChannels = 6;
        // ── State for the Add Asset modal ─────────────────────────────────────
        var __modalAssetId       = null;   // null = new, number = edit
        var __modalAssetTypeId   = null;
        var __modalAssetTypeName = null;
        var __modalAttributes    = [];     // [{id, title}, …] fetched from API

        // ── Open modal: called from + button (new) OR selectAsset (edit) ──────
        function openAddAssetModal(assetId, assetName) {
            var $activeType = $('#atList .ati.on');
            __modalAssetTypeId   = $activeType.length ? parseInt($activeType.data('type-id'), 10) : null;
            __modalAssetTypeName = $activeType.length ? $activeType.data('type-name') : $('#adTitle').text();
            __modalAssetId       = assetId || null;

            if (!__modalAssetTypeId || !__currentSiteId) {
                E7.warn('Please select a station and asset type first.');
                return;
            }

            $('#addAssetModalTitle').text(assetId ? (assetName || 'Edit Asset') : 'Add Asset');
            $('#assetModalName').val(assetName || '');
            $('#assetModalHttp').val('');
            $('#assetModalCells').val('');
            $('#assetModalActive').prop('checked', true);
            // Point Machine section (AssetType 3) — reset to Full / Parallel
            $('#assetModalPM').toggle(__modalAssetTypeId === 3);
            $('#pmHalf, #pmSeries, #pmTws').val('0'); $('#pmSeriesType').val('1'); $('#pmAliasA, #pmAliasB').val('');
            pmToggle();

            // Show loading spinner in config table
            $('#assetConfigBody').html(
                '<tr><td colspan="4" style="text-align:center;padding:20px">'
              + '<i class="bi bi-arrow-clockwise" style="animation:spin .7s linear infinite"></i> Loading…'
              + '</td></tr>'
            );

            // Always open on the Config tab with the other tabs cleared
            bootstrap.Tab.getOrCreateInstance(document.querySelector('#assetModalTabs [data-bs-target="#amConfig"]')).show();
            $('#amSignalMapTab').hide();
            $('#amSignalMapBody, #amAlertsBody, #amFRSBody, #amCauseBody').empty();

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('addAssetModal'));
            modal.show();

            // New asset → GetAssetTypeInfo (blank attributes, like the 90 AddAsset action).
            // Edit → GetAssetJson (attributes pre-filled with the saved channel/value, like 90 GetAssetById).
            var req = assetId
                ? { url: '@Url.Action("GetAssetJson", "Station")', data: { id: assetId } }
                : { url: '@Url.Action("GetAssetTypeInfo", "Station")', data: { assetTypeId: __modalAssetTypeId, siteId: __currentSiteId } };
            $.ajax({
                url: req.url,
                data: req.data,
                success: function (asset) {
                    if (asset && !asset.error) {
                        if (assetId) {
                            $('#assetModalName').val(asset.name || assetName || '');
                            $('#assetModalHttp').val(asset.httpMisLink || '');
                            $('#assetModalCells').val(asset.numberOfCell != null ? asset.numberOfCell : '');
                            $('#assetModalActive').prop('checked', asset.isActive !== false);
                            $('#pmHalf').val(asset.isHalfPointMachine ? '1' : '0');
                            $('#pmSeries').val(asset.isSeriesOpration ? '1' : '0');
                            $('#pmSeriesType').val(String(asset.seriesOprationTypeId || 1));
                            $('#pmAliasA').val(asset.aliasDirectionA || '');
                            $('#pmAliasB').val(asset.aliasDirectionB || '');
                            // IRS/TWS = Asset.IsThickWave + ThickWaveTypeId (A=1, B=2, Both=3), as on 90
                            $('#pmTws').val(asset.isThickWave ? String(asset.thickWaveTypeId || 3) : '0');
                            pmToggle();
                        }
                        __modalAsset    = asset;
                        // Json() camelCases MQTTNoOfChannels as "mqttNoOfChannels"
                        __modalChannels = asset.mqttNoOfChannels || asset.MQTTNoOfChannels || 6;
                        __modalAttributes = asset.assetAttributes || [];
                        renderAssetConfigTable();
                        renderAssetExtraTabs(asset, !!assetId);
                    } else {
                        $('#assetConfigBody').html('<tr><td colspan="4" style="text-align:center;color:var(--err)">Failed to load attributes</td></tr>');
                    }
                },
                error: function (xhr) {
                    $('#assetConfigBody').html('<tr><td colspan="4" style="text-align:center;color:var(--err)">Request failed</td></tr>');
                }
            });
        }
        // ── Render Config tab rows from __modalAttributes ─────────────────────
        function pmToggle() { $('#assetModalPM .pm-series').toggle($('#pmSeries').val() === '1'); }

        // ── Signal Mapping / Alerts / FRS Alerts / Cause Code tabs (same data as the 90 Add Asset) ──
        function amEsc(v) { return (v === null || v === undefined) ? '' : String(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }

        function renderAssetExtraTabs(asset, isEdit) {
            // Signal Mapping — the API only fills this list for Track assets
            var maps = asset.mSignalTrackMappings || [];
            if (maps.length) {
                var sm = '';
                maps.forEach(function (m) {
                    sm += '<tr><td><label style="display:flex;align-items:center;gap:8px;margin:0;cursor:pointer">'
                        + '<input type="checkbox" class="am-sig" data-asset-id="' + m.assetId + '"' + (m.isChecked ? ' checked' : '') + '> '
                        + amEsc(m.assetName) + '</label></td></tr>';
                });
                $('#amSignalMapBody').html(sm);
                $('#amSignalMapTab').show();
            }

            // Alerts — checkbox = active, operator + value; saved only when both are set
            var ops = asset.mOperators || [];
            var alerts = asset.mAlerts || [];
            var al = '';
            alerts.forEach(function (a) {
                var opts = '<option value="">Select Operator</option>';
                ops.forEach(function (o) {
                    opts += '<option value="' + o.id + '"' + (o.id === a.operatorId ? ' selected' : '') + '>' + amEsc(o.value) + '</option>';
                });
                al += '<tr class="am-alert" data-id="' + a.id + '" data-value-id="' + (a.alertValueId || 0) + '">'
                    + '<td><input type="checkbox" class="am-alert-on"' + (a.isActive ? ' checked' : '') + '></td>'
                    + '<td style="vertical-align:middle">' + amEsc(a.alertName) + '</td>'
                    + '<td><select class="form-select form-select-sm am-alert-op">' + opts + '</select></td>'
                    + '<td><input type="text" class="form-control form-control-sm am-alert-val" value="' + amEsc(a.alertValue) + '"></td>'
                    + '</tr>';
            });
            $('#amAlertsBody').html(al || '<tr><td colspan="4" style="text-align:center;color:var(--txm);padding:16px">No alerts for this asset type</td></tr>');

            // FRS Alerts — one row per attribute
            var ranges = asset.mFRSAttributeRanges || [];
            var fr = '';
            (__modalAttributes || []).forEach(function (attr) {
                var r = ranges.filter(function (x) { return x.assetAttributeId === attr.id; })[0] || {};
                fr += '<tr class="am-frs" data-attr-id="' + attr.id + '">'
                    + '<td style="vertical-align:middle">' + amEsc(attr.title || attr.name) + '</td>'
                    + '<td><input type="text" class="form-control form-control-sm am-frs-maxsafe" value="' + amEsc(r.maxSafeValue) + '"></td>'
                    + '<td><input type="text" class="form-control form-control-sm am-frs-avg" value="' + amEsc(r.averageValue) + '"></td>'
                    + '<td><input type="text" class="form-control form-control-sm am-frs-minsafe" value="' + amEsc(r.minSafeValue) + '"></td>'
                    + '<td><input type="text" class="form-control form-control-sm am-frs-minfail" value="' + amEsc(r.minFailValue) + '"></td>'
                    + '</tr>';
            });
            $('#amFRSBody').html(fr || '<tr><td colspan="5" style="text-align:center;color:var(--txm);padding:16px">No attributes</td></tr>');

            // Cause Code Activation — new asset: all active (as on 90); edit: saved state
            var infos = asset.mAlertInfos || [];
            var cc = '';
            infos.forEach(function (i) {
                var on = isEdit ? i.isActive : true;
                cc += '<tr class="am-cause" data-id="' + i.id + '">'
                    + '<td style="vertical-align:middle">' + amEsc(i.name) + '</td>'
                    + '<td style="text-align:center"><input type="checkbox" class="am-cause-on"' + (on ? ' checked' : '') + '></td>'
                    + '</tr>';
            });
            $('#amCauseBody').html(cc || '<tr><td colspan="2" style="text-align:center;color:var(--txm);padding:16px">No cause codes for this asset type</td></tr>');
        }

        function amNum(v) { v = (v || '').trim(); if (v === '') return null; var n = parseFloat(v); return isNaN(n) ? null : n; }

        // Collect the extra tabs in the same shape the 90 site sends to Asset/SaveAsset
        function collectAssetExtraTabs() {
            var mAlerts = [];
            $('#amAlertsBody tr.am-alert').each(function () {
                var $r = $(this);
                mAlerts.push({
                    Id:            parseInt($r.data('id'), 10),
                    AlertValueId:  parseInt($r.data('value-id'), 10) || 0,
                    IsActive:      $r.find('.am-alert-on').is(':checked'),
                    AlertName:     $r.find('td').eq(1).text(),
                    OperatorId:    parseInt($r.find('.am-alert-op').val(), 10) || 0,
                    AlertValue:    $r.find('.am-alert-val').val().trim()
                });
            });

            var mFRSAttributeRanges = [];
            $('#amFRSBody tr.am-frs').each(function () {
                var $r = $(this);
                var item = {
                    AssetAttributeId: parseInt($r.data('attr-id'), 10),
                    MaxSafeValue:     amNum($r.find('.am-frs-maxsafe').val()),
                    AverageValue:     amNum($r.find('.am-frs-avg').val()),
                    MinSafeValue:     amNum($r.find('.am-frs-minsafe').val()),
                    MinFailValue:     amNum($r.find('.am-frs-minfail').val())
                };
                // like 90: skip rows with all four values empty
                if (item.MaxSafeValue !== null || item.AverageValue !== null || item.MinSafeValue !== null || item.MinFailValue !== null)
                    mFRSAttributeRanges.push(item);
            });

            var mAlertInfoActivations = [];
            $('#amCauseBody tr.am-cause').each(function () {
                mAlertInfoActivations.push({
                    AlertInfoId: parseInt($(this).data('id'), 10),
                    IsActive:    $(this).find('.am-cause-on').is(':checked')
                });
            });

            var mSignalTrackMappings = [];
            $('#amSignalMapBody .am-sig:checked').each(function () {
                mSignalTrackMappings.push({ SignalAssetId: parseInt($(this).data('asset-id'), 10) });
            });

            return {
                mAlerts: mAlerts,
                mFRSAttributeRanges: mFRSAttributeRanges,
                mAlertInfoActivations: mAlertInfoActivations,
                mSignalTrackMappings: mSignalTrackMappings
            };
        }

        function renderAssetConfigTable() {
            var $body = $('#assetConfigBody');
            if (!__modalAttributes || !__modalAttributes.length) {
                $body.html('<tr><td colspan="4" style="text-align:center;color:var(--txm);padding:20px">No attributes for this asset type</td></tr>');
                return;
            }

            var html = '';
            __modalAttributes.forEach(function (attr) {
                var title   = attr.title || attr.name || ('Attr ' + attr.id);
                var selChan = attr.assetInfoChannel || '';
                var selVal  = attr.assetInfoValue   || '';
                var selMult = attr.multiplication   != null ? attr.multiplication : '';

                // Build channel dropdown — Channel 1 to N (same as old site)
                var chanOpts = '<option value="">Select Channel</option>';
                for (var i = 1; i <= __modalChannels; i++) {
                    var chVal = 'Channel' + i;
                    chanOpts += '<option value="' + chVal + '"' + (String(selChan).toLowerCase() === chVal.toLowerCase() ? ' selected' : '') + '>Channel ' + i + '</option>';
                }

                html += '<tr>'
                      +   '<td style="vertical-align:middle;font-weight:500">' + title + '</td>'
                      +   '<td><select class="form-select form-select-sm cfg-channel" data-attr-id="' + attr.id + '">' + chanOpts + '</select></td>'
                      +   '<td><input type="text" class="form-control form-control-sm cfg-value" data-attr-id="' + attr.id + '" value="' + selVal + '"></td>'
                      +   '<td><input type="text" class="form-control form-control-sm cfg-mult"  data-attr-id="' + attr.id + '" value="' + selMult + '"></td>'
                      + '</tr>';
            });
            $body.html(html);
        }
        // ── Save from modal → POST to /Station/SaveAsset ──────────────────────
        function saveAssetFromModal() {
            var name = $('#assetModalName').val().trim();
            if (!name) { E7.warn('Enter the asset name'); $('#assetModalName').focus(); return; }

            // Build mAssetInfos — same structure as old site's fnSaveAsset
            var mAssetInfos = [];
            var skipped = [];
            (__modalAttributes || []).forEach(function (attr) {
                var channel = $('.cfg-channel[data-attr-id="' + attr.id + '"]').val();
                var value   = $('.cfg-value[data-attr-id="'   + attr.id + '"]').val().trim();
                var mult    = $('.cfg-mult[data-attr-id="'    + attr.id + '"]').val().trim();
                // API Asset/SaveAsset only creates an AssetInfo row when Value is filled;
                // isSuccess = the API already has a row for this attribute (then a channel-only change is saved)
                if (channel && !value && !attr.isSuccess) skipped.push(attr.title || attr.name || ('Attr ' + attr.id));
                mAssetInfos.push({
                    AssetAttributeId: attr.id,
                    Channels:         channel || '',   // API/AssetInfo field is "Channels"
                    Value:            value,
                    Multiplication:   mult ? parseFloat(mult) : null
                });
            });
            if (skipped.length && !confirm(
                    'These attributes have a channel but no Value, so the API will NOT save them:\n\n- '
                    + skipped.join('\n- ') + '\n\nEnter a Value for them to save the channel. Save the rest anyway?')) {
                return;
            }

            var payload = {
                Id:           __modalAssetId || 0,
                SiteId:       parseInt(__currentSiteId),
                AssetTypeId:  __modalAssetTypeId,
                Name:         name,
                HttpMisLink:  $('#assetModalHttp').val().trim(),
                NumberOfCell: parseFloat($('#assetModalCells').val()) || null,
                IsActive:     $('#assetModalActive').is(':checked'),
                mAssetInfos:  mAssetInfos
            };
            $.extend(payload, collectAssetExtraTabs());

            // Point Machine details — same rules as 90 SiteList.js: series type and A/B-end names only when Series
            if (__modalAssetTypeId === 3) {
                var isSeries = $('#pmSeries').val() === '1';
                payload.IsHalfPointMachine   = $('#pmHalf').val() === '1';
                payload.IsSeriesOpration     = isSeries;
                payload.SeriesOprationTypeId = isSeries ? parseInt($('#pmSeriesType').val(), 10) : null;
                payload.AliasDirectionA      = isSeries ? $('#pmAliasA').val().trim() : null;
                payload.AliasDirectionB      = isSeries ? $('#pmAliasB').val().trim() : null;
                var tws = parseInt($('#pmTws').val(), 10) || 0;   // 0 = IRS
                payload.IsThickWave          = tws > 0;
                payload.ThickWaveTypeId      = tws > 0 ? tws : null;
            }

            var $saveBtn = $('#addAssetModal .be7');
            $saveBtn.prop('disabled', true).text('Saving…');

            $.ajax({
                url:         '@Url.Action("SaveAsset", "Station")',
                type:        'POST',
                contentType: 'application/json',
                data:        JSON.stringify(payload),
                success: function (res) {
                    if (res && res.success) {
                        $saveBtn.text('✓ Saved');
                        E7.success('Asset "' + name + '" saved');
                        setTimeout(function () {
                            bootstrap.Modal.getInstance(document.getElementById('addAssetModal')).hide();
                            $saveBtn.prop('disabled', false).text('Save');
                            // Re-read the station's assets so a new asset appears straight away
                            loadSiteAssets(__currentSiteId, function () {
                                var n = siteAssetCount(__modalAssetTypeId);
                                $('#atList .ati[data-type-id="' + __modalAssetTypeId + '"] .ac').text(n);
                                $('.adp-h span:last-child').text(n + ' assets');
                                loadAssetsForType(__modalAssetTypeId, __modalAssetTypeName);
                            });
                        }, 900);
                    } else {
                        E7.error(res && res.error ? res.error : 'Error saving asset.');
                        $saveBtn.prop('disabled', false).text('Save');
                    }
                },
                error: function (xhr) {
                    E7.ajaxError(xhr);
                    $saveBtn.prop('disabled', false).text('Save');
                }
            });
        }
        // ── Save selection → re-render sidebar → close offcanvas ────────
                function saveAssetTypeConfig() {
            var selectedIds = [];
            var selectedNames = {};

            $('#assetTypeConfigList .at-chk:checked').each(function () {
                var id = parseInt($(this).val(), 10);
                selectedIds.push(id);
                selectedNames[id] = $(this).closest('label').find('span').text().trim();
            });

            saveTypeIds(__currentSiteId, selectedIds);

            // Save names too so sidebar can show them without re-fetching
            if (!__savedTypeNamesBySite) __savedTypeNamesBySite = {};
            __savedTypeNamesBySite[__currentSiteId] = selectedNames;

            renderAssetTypeSidebar();
            E7.success('Asset types updated');

            var oc = bootstrap.Offcanvas.getInstance(document.getElementById('addTypeOC'));
            if (oc) oc.hide();
        }


    </script>
    <style>    @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }</style>
}
