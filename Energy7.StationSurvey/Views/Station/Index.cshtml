        }

        // Save Row / Terminal for one attribute row → CardLine (same API as 90 Yard Config)
        function svA(btn) {
            var row = btn.closest('.ar');
            var cardLineId = parseInt(row.getAttribute('data-cardline-id'), 10) || 0;
            if (!cardLineId) { alert('This attribute has no card line yet. Set it up in Yard Config on the 90 site first.'); return; }

            var inputs = row.querySelectorAll('.rt-inp');
            var isCur  = row.getAttribute('data-current') === '1';
            var rowNo  = inputs[0] ? inputs[0].value.trim() : '';
            function num(i, label) {
                var t = inputs[i] ? inputs[i].value.trim() : '';
                if (t === '') return null;
                var n = parseInt(t, 10);
                if (isNaN(n)) throw label + ' must be a number';
                return n;
            }
            var trm, third;
            try { trm = num(1, 'Terminal +'); third = num(2, isCur ? 'Sequence no.' : 'Terminal -'); }
            catch (msg) { alert(msg); return; }

            var body = { Id: cardLineId, RowNumber: rowNo, TerminalNumberPositive: trm };
            if (isCur) body.CurrentSequenceNumber = third; else body.TerminalNumberNegative = third;

            btn.disabled = true; btn.textContent = '…';
            $.ajax({
                url: '@Url.Action("UpdateCardLineLocation", "Station")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(body),
                success: function (res) {
                    if (res && res.success) {
                        // keep the in-memory CardLine list in step so re-rendering shows saved values
                        __cardLines.forEach(function (r) {
                            if (r.id === cardLineId) {
                                r.rowNumber = res.rowNumber;
                                r.terminalNumberPositive = res.terminalNumberPositive;
                                r.terminalNumberNegative = res.terminalNumberNegative;
                                r.currentSequenceNumber = res.currentSequenceNumber;
                            }
                        });
                        btn.textContent = '✓'; btn.style.background = 'var(--ok)';
                        setTimeout(function () { btn.textContent = 'Save'; btn.style.background = ''; }, 1500);
                    } else {
                        alert(res && res.error ? res.error : 'Save failed');
                        btn.textContent = 'Save';
                    }
                },
                error: function () { alert('Request failed'); btn.textContent = 'Save'; },
                complete: function () { btn.disabled = false; }
            });
        }
