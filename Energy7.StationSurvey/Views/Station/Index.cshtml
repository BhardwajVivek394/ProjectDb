        function bindStats(data) {
            if (!data || data.error) { resetStats(); return; }

            $('#statLocations').text(data.totalLocations ?? 0);
            $('#statLocationsSub').text((data.totalLocations ?? 0) + ' unique locations');
            $('#statClusters').text(data.totalClusters ?? 0);
            $('#statClustersSub').text((data.totalClusters ?? 0) + ' unique clusters');
            $('#statDataPoints').text(data.totalDataPoints ?? 0);
            $('#statDataPointsSub').text('Asset × Attribute combinations');
            $('#statAssets').text(data.totalAssets ?? 0);
            $('#statAssetsSub').text(data.assetBreakdown || '—');
            $('#tabAssetCount').text(data.totalAssets ?? 0);
            $('#tabLocationCount').text(data.totalLocations ?? 0);

            // Capture CardLine records + per-type counts for drill-down
            __cardLines = data.records || [];
            __cardLineTypeCounts = {};
            if (data.assetTypeCounts && data.assetTypeCounts.length) {
                data.assetTypeCounts.forEach(function (t) {
                    __cardLineTypeCounts[t.assetTypeId] = {
                        count: t.count || 0,
                        dataPoints: t.dataPoints || 0,
                        name: t.assetTypeName
                    };
                });
            }

            // Re-render sidebar only if site types are already loaded
            // (so counts update in-place without changing the type list)
            if (__siteAssetTypes.length) {
                renderAssetTypeSidebar();
            }
        }
