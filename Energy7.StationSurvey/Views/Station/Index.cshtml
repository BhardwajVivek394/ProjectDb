                 // ── State ─────────────────────────────────────────────────────────────────
        var __masterAssetTypes   = [];
        var __siteAssetTypes     = [];
        var __currentSiteId      = 0;
        var __cardLineTypeCounts = {};
        var __cardLines          = [];
        var __siteAssets         = [];      // all assets of the station (Asset API)
        var __siteAssetsLoaded   = false;
        var __savedTypeIdsBySite = {};   // { siteId: [typeId, typeId, ...] } — cleared on refresh
        var __savedTypeNamesBySite = {};

        // ── Selection helpers (in-memory, per page load) ──────────────────────────
        function getSavedTypeIds(siteId) {
            return __savedTypeIdsBySite[siteId] || null;
        }
        function saveTypeIds(siteId, ids) {
            __savedTypeIdsBySite[siteId] = ids;
        }

        // ── Also clear any legacy cookies from earlier testing ────────────────────
        (function clearLegacyCookies() {
            document.cookie.split(';').forEach(function (c) {
                var name = c.split('=')[0].trim();
                if (name.indexOf('assetTypes_') === 0) {
                    document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
                }
            });
        })();

        // ── Field helpers (tolerant of casing differences) ────────────────────────
        function typeId(t)   { return t.id ?? t.assetTypeId ?? 0; }
        function typeName(t) { return t.name ?? t.assetTypeName ?? 'Unknown'; }
        function typeCount(t){ return t.assetCount ?? t.count ?? 0; }
        function typeUnver(t){ return t.unverifiedCount ?? t.unverified ?? 0; }

        // ── Load both datasets, then render sidebar ───────────────────────────────
                          function loadAssetTypes(siteId) {
            __currentSiteId = siteId;
            $('#atList').html('<li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">Loading…</li>');

            // Site-scoped list (primary source for sidebar)
            var pSite = $.ajax({
                url: '/Station/GetAllAssetTypeById',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify([siteId])
            });

            // Master list (used only for the offcanvas checklist)
            var pMaster = $.ajax({
                url: '/Station/GetAllAssetType',
                type: 'GET'
            });

            $.when(pSite, pMaster).done(function (siteRes, masterRes) {
                __siteAssetTypes   = (siteRes[0]   && !siteRes[0].error)   ? siteRes[0]   : [];
                __masterAssetTypes = (masterRes[0] && !masterRes[0].error) ? masterRes[0] : [];
                renderAssetTypeSidebar();
            }).fail(function () {
                $('#atList').html('<li style="padding:12px;text-align:center;color:var(--err);font-size:11px">Failed to load</li>');
            });
        }

                        function renderAssetTypeSidebar() {
            var $list = $('#atList');
            var saved = getSavedTypeIds(__currentSiteId);
            var savedNames = (__savedTypeNamesBySite && __savedTypeNamesBySite[__currentSiteId]) || {};

            var toShow;
            if (saved && saved.length) {
                // Build list from saved IDs — merge name from savedNames first,
                // fall back to __siteAssetTypes, fall back to __masterAssetTypes
                toShow = saved.map(function (id) {
                    // try site types first
                    var found = __siteAssetTypes.find(function (t) { return typeId(t) === id; });
                    if (!found && __masterAssetTypes.length) {
                        found = __masterAssetTypes.find(function (t) { return typeId(t) === id; });
                    }
                    // if still not found, build a minimal object from the saved name
                    if (!found) {
                        found = { id: id, name: savedNames[id] || ('Type ' + id), assetCount: 0 };
                    }
                    return found;
                });
            } else {
                toShow = __siteAssetTypes;
            }

            if (!toShow.length) {
                $list.html('<li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">No asset types for this site</li>');
                $('#tabAssetCount').text(0);
                return;
            }

            var totalAssets = 0;
            var html = '';

            $.each(toShow, function (i, t) {
                var id     = typeId(t);
                var name   = typeName(t);
                var clInfo = __cardLineTypeCounts[id];
                var count  = __siteAssetsLoaded ? siteAssetCount(id) : (clInfo ? clInfo.count : typeCount(t));
                var unver  = typeUnver(t);

                totalAssets += count;
                var isFirst  = (i === 0) ? ' on' : '';
                var unvBadge = unver > 0 ? '<span class="ae">' + unver + '?</span>' : '';

                html += '<li class="ati' + isFirst + '" data-type-id="' + id + '" data-type-name="' + name + '">'
                      +     '<span>' + name + '</span>'
                      +     '<span><span class="ac">' + count + '</span>' + unvBadge + '</span>'
                      + '</li>';
            });

            $list.html(html);
            $('#tabAssetCount').text(totalAssets);

            var first     = toShow[0];
            var firstId   = typeId(first);
            var firstInfo = __cardLineTypeCounts[firstId];
            var firstCount = __siteAssetsLoaded ? siteAssetCount(firstId) : (firstInfo ? firstInfo.count : typeCount(first));
            $('#adTitle').text(typeName(first));
            $('.adp-h span:last-child').text(firstCount + ' assets');

            bindAssetTypeClicks();
            loadAssetsForType(firstId, typeName(first));
        }
        // ── Click handler for sidebar items (delegated) ───────────────────────────
                function bindAssetTypeClicks() {
            $('#atList').off('click', '.ati').on('click', '.ati', function () {
                $('#atList .ati').removeClass('on');
                $(this).addClass('on');

                var tId     = parseInt($(this).data('type-id'), 10);
                var tName   = $(this).data('type-name');
                var count   = $(this).find('.ac').text();

                $('#adTitle').text(tName);
                $('.adp-h span:last-child').text(count + ' assets');

                loadAssetsForType(tId, tName);
            });
        }

        // ── Offcanvas: populate checklist when it opens ───────────────────────────
        $(document).on('show.bs.offcanvas', '#addTypeOC', function () {
            var $box = $('#assetTypeConfigList');
            if (!__masterAssetTypes.length) {
                $box.html('<div style="padding:12px;text-align:center;color:var(--txm)">Select a station first</div>');
                return;
            }

            var saved = getSavedTypeIds(__currentSiteId);
            var checkedSet;
            if (saved && saved.length) {
                checkedSet = {};
                saved.forEach(function (id) { checkedSet[id] = true; });
            } else {
                // Default: check all types that have records at this site
                checkedSet = {};
                __siteAssetTypes.forEach(function (t) { checkedSet[typeId(t)] = true; });
            }

            var html = '';
            __masterAssetTypes.forEach(function (t) {
                var id      = typeId(t);
                var name    = typeName(t);
                var checked = checkedSet[id] ? 'checked' : '';
                html += '<label class="yc" style="padding:5px 0;display:flex;align-items:center;gap:8px">'
                      +     '<input type="checkbox" class="at-chk" value="' + id + '" ' + checked + '>'
                      +     '<span>' + name + '</span>'
                      + '</label>';
            });
            $box.html(html);
        });
        // ── All assets of the station from the Asset API (Asset/GetAll, like the 90 Sites page) ──
        // CardLine only knows assets that are wired on a card, so newly added assets would not show.
        function loadSiteAssets(siteId, done) {
            $.ajax({
                url: '@Url.Action("GetSiteAssets", "Station")',
                data: { siteId: siteId },
                success: function (res) {
                    if (siteId != __currentSiteId) return;   // station changed meanwhile
                    __siteAssets = Array.isArray(res) ? res : [];
                    __siteAssetsLoaded = Array.isArray(res);
                    if (done) done();
                }
            });
        }

        function siteAssetCount(assetTypeId) {
            return __siteAssets.filter(function (a) { return a.assetTypeId === assetTypeId; }).length;
        }

                        function loadAssetsForType(assetTypeId, assetTypeName) {
            // Assets of this type: Asset API first, plus any only known from CardLine
            var map = {};
            __siteAssets.forEach(function (a) {
                if (a.assetTypeId === assetTypeId) map[a.id] = { id: a.id, name: a.name || ('Asset ' + a.id), inactive: a.isActive === false };
            });
            __cardLines.forEach(function (r) {
                if (r.assetTypeId === assetTypeId && r.assetId) {
                    if (!map[r.assetId]) {
                        map[r.assetId] = { id: r.assetId, name: r.assetName || ('Asset ' + r.assetId) };
                    }
                }
            });

            var assets = Object.values(map).sort(function (a, b) {
                return (a.name || '').localeCompare(b.name || '', undefined, { numeric: true });
            });

            // ── Update middle-panel title ("TRACK NAME" → "SIGNAL NAME" etc.) ─────
            var upper = (assetTypeName || 'ASSET').toUpperCase();
            $('#assetListTitle').text(upper + ' NAME');

            // ── Update right-panel tag ("DC Track" → current asset type) ──────────
            $('#selAssetTypeTag').text(assetTypeName || '—');

            var $list = $('#trackList');
            if (!assets.length) {
                $list.html('<div style="padding:12px;text-align:center;color:var(--txm);font-size:11px">No assets</div>');
                $('#modeA').html('<div style="padding:16px;text-align:center;color:var(--txm);font-size:11px">No assets of this type</div>');
                $('#modeB').html('');
                $('#selAN').text('—');
                return;
            }

            var html = '';
            assets.forEach(function (a, i) {
                var sel = (i === 0) ? ' sel' : '';
                html += '<div class="air' + sel + '" data-asset-id="' + a.id + '" '
                      +     'onclick="selectAsset(this, ' + a.id + ')">'
                      +     $('<div>').text(a.name || '').html()
                      +     (a.inactive ? ' <span style="font-size:9px;color:var(--txl)">(inactive)</span>' : '')
                      + '</div>';
            });
            $list.html(html);

            // Auto-load the first asset's attributes and update its name in the header
            $('#selAN').text(assets[0].name);
            loadAttributesForAsset(assets[0].id);
        }
                function loadAttributesForAsset(assetId) {
            var records = __cardLines.filter(function (r) { return r.assetId === assetId; });
            if (!records.length) {
                $('#modeA').html('<div style="padding:16px;text-align:center;color:var(--txm);font-size:11px">No card lines for this asset yet — '
                    + 'Row / Terminal can be set once it is wired in Yard Config (90 site). Click the asset to edit its channels.</div>');
                $('#modeB').html('');
                return;
            }

            $('#selAN').text(records[0].assetName || '');

            // Group attributes by LocationName (e.g. "TF End", "TR End", or "lc 14")
            var groups = {};
            records.forEach(function (r) {
                var loc = r.locationName || 'Default';
                if (!groups[loc]) groups[loc] = [];
                groups[loc].push(r);
            });

            var html = '';
            var idx  = 0;
            Object.keys(groups).forEach(function (loc) {
                var rows   = groups[loc];
                var grpKey = 'g' + (idx++);

                html += '<div class="ats">';
                html +=   '<div class="ats-t">' + loc;
                html +=     '<label class="stog" style="margin-left:auto">'
                      +       '<input type="checkbox" checked onchange="togG(this,\'' + grpKey + '\')">'
                      +       '<span class="stog-sl"></span>'
                      +     '</label>';
                html +=   '</div>';

                rows.forEach(function (r) {
                    var attrName = r.attributeName || '';
                    var row      = r.rowNumber != null ? r.rowNumber : '';
                    var trm      = r.terminalNumberPositive != null ? r.terminalNumberPositive : '';
                    // Voltage: Row, +ve, -ve terminal.  Current: Row, +ve terminal, sequence no. (90 rule)
                    var isCur    = isCurrentCardLine(r);
                    var third    = isCur
                        ? (r.currentSequenceNumber != null ? r.currentSequenceNumber : '')
                        : (r.terminalNumberNegative != null ? r.terminalNumberNegative : '');

                    html += '<div class="ar" data-cardline-id="' + (r.id || '') + '" data-current="' + (isCur ? 1 : 0) + '">'
                          +   '<input type="checkbox" checked data-g="' + grpKey + '">'
                          +   '<span class="aname">' + attrName + ' <span style="font-size:9px;color:var(--txl)">' + (isCur ? 'I' : 'V') + '</span></span>'
                          +   '<input class="rt-inp" placeholder="Row" value="' + row + '">'
                          +   '<input class="rt-inp" placeholder="+ Trm" title="Terminal +" value="' + trm + '">'
                          +   '<input class="rt-inp" placeholder="' + (isCur ? 'Seq' : '- Trm') + '" title="' + (isCur ? 'Current sequence no.' : 'Terminal -') + '" value="' + third + '">'
                          +   '<button class="sv-btn" onclick="svA(this)">Save</button>'
                          + '</div>';
                });

                html += '</div>';
            });

            $('#modeA').html(html);
            $('#modeB').html('');   // individual-LOC mode — can populate later if needed
        }
                function selectAsset(el, assetId) {
            $('#trackList .air, #trackList .fot-parent, #trackList .fot-child').removeClass('sel');
            $(el).addClass('sel');
            var assetName = $(el).text().trim();
            $('#selAN').text(assetName);
            loadAttributesForAsset(assetId);
            // Open the Add Asset modal pre-filled with this asset
            openAddAssetModal(assetId, assetName);
        }
        var __modalAsset    = null;
        var __modalChannels = 6;
        // ── State for the Add Asset modal ─────────────────────────────────────
        var __modalAssetId       = null;   // null = new, number = edit
        var __modalAssetTypeId   = null;
        var __modalAssetTypeName = null;
        var __modalAttributes    = [];     // [{id, title}, …] fetched from API

        // ── Open modal: called from + button (new) OR selectAsset (edit) ──────
        function openAddAssetModal(assetId, assetName) {
            var $activeType = $('#atList .ati.on');
            __modalAssetTypeId   = $activeType.length ? parseInt($activeType.data('type-id'), 10) : null;
            __modalAssetTypeName = $activeType.length ? $activeType.data('type-name') : $('#adTitle').text();
            __modalAssetId       = assetId || null;

            if (!__modalAssetTypeId || !__currentSiteId) {
                alert('Please select a station and asset type first.');
                return;
            }

            $('#addAssetModalTitle').text(assetId ? (assetName || 'Edit Asset') : 'Add Asset');
            $('#assetModalName').val(assetName || '');
            $('#assetModalHttp').val('');
            $('#assetModalCells').val('');
            $('#assetModalActive').prop('checked', true);
            // Point Machine section (AssetType 3) — reset to Full / Parallel
            $('#assetModalPM').toggle(__modalAssetTypeId === 3);
            $('#pmHalf, #pmSeries, #pmTws').val('0'); $('#pmSeriesType').val('1'); $('#pmAliasA, #pmAliasB').val('');
            pmToggle();

            // Show loading spinner in config table
            $('#assetConfigBody').html(
                '<tr><td colspan="4" style="text-align:center;padding:20px">'
              + '<i class="bi bi-arrow-clockwise" style="animation:spin .7s linear infinite"></i> Loading…'
              + '</td></tr>'
            );

            // Always open on the Config tab with the other tabs cleared
            bootstrap.Tab.getOrCreateInstance(document.querySelector('#assetModalTabs [data-bs-target="#amConfig"]')).show();
            $('#amSignalMapTab').hide();
            $('#amSignalMapBody, #amAlertsBody, #amFRSBody, #amCauseBody').empty();

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('addAssetModal'));
            modal.show();

            // New asset → GetAssetTypeInfo (blank attributes, like the 90 AddAsset action).
            // Edit → GetAssetJson (attributes pre-filled with the saved channel/value, like 90 GetAssetById).
            var req = assetId
                ? { url: '@Url.Action("GetAssetJson", "Station")', data: { id: assetId } }
                : { url: '@Url.Action("GetAssetTypeInfo", "Station")', data: { assetTypeId: __modalAssetTypeId, siteId: __currentSiteId } };
            $.ajax({
                url: req.url,
                data: req.data,
                success: function (asset) {
                    if (asset && !asset.error) {
                        if (assetId) {
                            $('#assetModalName').val(asset.name || assetName || '');
                            $('#assetModalHttp').val(asset.httpMisLink || '');
                            $('#assetModalCells').val(asset.numberOfCell != null ? asset.numberOfCell : '');
                            $('#assetModalActive').prop('checked', asset.isActive !== false);
                            $('#pmHalf').val(asset.isHalfPointMachine ? '1' : '0');
                            $('#pmSeries').val(asset.isSeriesOpration ? '1' : '0');
                            $('#pmSeriesType').val(String(asset.seriesOprationTypeId || 1));
                            $('#pmAliasA').val(asset.aliasDirectionA || '');
                            $('#pmAliasB').val(asset.aliasDirectionB || '');
                            // IRS/TWS = Asset.IsThickWave + ThickWaveTypeId (A=1, B=2, Both=3), as on 90
                            $('#pmTws').val(asset.isThickWave ? String(asset.thickWaveTypeId || 3) : '0');
                            pmToggle();
                        }
                        __modalAsset    = asset;
                        // Json() camelCases MQTTNoOfChannels as "mqttNoOfChannels"
                        __modalChannels = asset.mqttNoOfChannels || asset.MQTTNoOfChannels || 6;
                        __modalAttributes = asset.assetAttributes || [];
                        renderAssetConfigTable();
                        renderAssetExtraTabs(asset, !!assetId);
                    } else {
                        $('#assetConfigBody').html('<tr><td colspan="4" style="text-align:center;color:var(--err)">Failed to load attributes</td></tr>');
                    }
                },
                error: function () {
                    $('#assetConfigBody').html('<tr><td colspan="4" style="text-align:center;color:var(--err)">Request failed</td></tr>');
                }
            });
        }
        // ── Render Config tab rows from __modalAttributes ─────────────────────
        function pmToggle() { $('#assetModalPM .pm-series').toggle($('#pmSeries').val() === '1'); }

        // ── Signal Mapping / Alerts / FRS Alerts / Cause Code tabs (same data as the 90 Add Asset) ──
        function amEsc(v) { return (v === null || v === undefined) ? '' : String(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }

        function renderAssetExtraTabs(asset, isEdit) {
            // Signal Mapping — the API only fills this list for Track assets
            var maps = asset.mSignalTrackMappings || [];
            if (maps.length) {
                var sm = '';
                maps.forEach(function (m) {
                    sm += '<tr><td><label style="display:flex;align-items:center;gap:8px;margin:0;cursor:pointer">'
                        + '<input type="checkbox" class="am-sig" data-asset-id="' + m.assetId + '"' + (m.isChecked ? ' checked' : '') + '> '
                        + amEsc(m.assetName) + '</label></td></tr>';
                });
                $('#amSignalMapBody').html(sm);
                $('#amSignalMapTab').show();
            }

            // Alerts — checkbox = active, operator + value; saved only when both are set
            var ops = asset.mOperators || [];
            var alerts = asset.mAlerts || [];
            var al = '';
            alerts.forEach(function (a) {
                var opts = '<option value="">Select Operator</option>';
                ops.forEach(function (o) {
                    opts += '<option value="' + o.id + '"' + (o.id === a.operatorId ? ' selected' : '') + '>' + amEsc(o.value) + '</option>';
                });
                al += '<tr class="am-alert" data-id="' + a.id + '" data-value-id="' + (a.alertValueId || 0) + '">'
                    + '<td><input type="checkbox" class="am-alert-on"' + (a.isActive ? ' checked' : '') + '></td>'
                    + '<td style="vertical-align:middle">' + amEsc(a.alertName) + '</td>'
                    + '<td><select class="form-select form-select-sm am-alert-op">' + opts + '</select></td>'
                    + '<td><input type="text" class="form-control form-control-sm am-alert-val" value="' + amEsc(a.alertValue) + '"></td>'
                    + '</tr>';
            });
            $('#amAlertsBody').html(al || '<tr><td colspan="4" style="text-align:center;color:var(--txm);padding:16px">No alerts for this asset type</td></tr>');

            // FRS Alerts — one row per attribute
            var ranges = asset.mFRSAttributeRanges || [];
            var fr = '';
            (__modalAttributes || []).forEach(function (attr) {
                var r = ranges.filter(function (x) { return x.assetAttributeId === attr.id; })[0] || {};
                fr += '<tr class="am-frs" data-attr-id="' + attr.id + '">'
                    + '<td style="vertical-align:middle">' + amEsc(attr.title || attr.name) + '</td>'
                    + '<td><input type="text" class="form-control form-control-sm am-frs-maxsafe" value="' + amEsc(r.maxSafeValue) + '"></td>'
                    + '<td><input type="text" class="form-control form-control-sm am-frs-avg" value="' + amEsc(r.averageValue) + '"></td>'
                    + '<td><input type="text" class="form-control form-control-sm am-frs-minsafe" value="' + amEsc(r.minSafeValue) + '"></td>'
                    + '<td><input type="text" class="form-control form-control-sm am-frs-minfail" value="' + amEsc(r.minFailValue) + '"></td>'
                    + '</tr>';
            });
            $('#amFRSBody').html(fr || '<tr><td colspan="5" style="text-align:center;color:var(--txm);padding:16px">No attributes</td></tr>');

            // Cause Code Activation — new asset: all active (as on 90); edit: saved state
            var infos = asset.mAlertInfos || [];
            var cc = '';
            infos.forEach(function (i) {
                var on = isEdit ? i.isActive : true;
                cc += '<tr class="am-cause" data-id="' + i.id + '">'
                    + '<td style="vertical-align:middle">' + amEsc(i.name) + '</td>'
                    + '<td style="text-align:center"><input type="checkbox" class="am-cause-on"' + (on ? ' checked' : '') + '></td>'
                    + '</tr>';
            });
            $('#amCauseBody').html(cc || '<tr><td colspan="2" style="text-align:center;color:var(--txm);padding:16px">No cause codes for this asset type</td></tr>');
        }

        function amNum(v) { v = (v || '').trim(); if (v === '') return null; var n = parseFloat(v); return isNaN(n) ? null : n; }

        // Collect the extra tabs in the same shape the 90 site sends to Asset/SaveAsset
        function collectAssetExtraTabs() {
            var mAlerts = [];
            $('#amAlertsBody tr.am-alert').each(function () {
                var $r = $(this);
                mAlerts.push({
                    Id:            parseInt($r.data('id'), 10),
                    AlertValueId:  parseInt($r.data('value-id'), 10) || 0,
                    IsActive:      $r.find('.am-alert-on').is(':checked'),
                    AlertName:     $r.find('td').eq(1).text(),
                    OperatorId:    parseInt($r.find('.am-alert-op').val(), 10) || 0,
                    AlertValue:    $r.find('.am-alert-val').val().trim()
                });
            });

            var mFRSAttributeRanges = [];
            $('#amFRSBody tr.am-frs').each(function () {
                var $r = $(this);
                var item = {
                    AssetAttributeId: parseInt($r.data('attr-id'), 10),
                    MaxSafeValue:     amNum($r.find('.am-frs-maxsafe').val()),
                    AverageValue:     amNum($r.find('.am-frs-avg').val()),
                    MinSafeValue:     amNum($r.find('.am-frs-minsafe').val()),
                    MinFailValue:     amNum($r.find('.am-frs-minfail').val())
                };
                // like 90: skip rows with all four values empty
                if (item.MaxSafeValue !== null || item.AverageValue !== null || item.MinSafeValue !== null || item.MinFailValue !== null)
                    mFRSAttributeRanges.push(item);
            });

            var mAlertInfoActivations = [];
            $('#amCauseBody tr.am-cause').each(function () {
                mAlertInfoActivations.push({
                    AlertInfoId: parseInt($(this).data('id'), 10),
                    IsActive:    $(this).find('.am-cause-on').is(':checked')
                });
            });

            var mSignalTrackMappings = [];
            $('#amSignalMapBody .am-sig:checked').each(function () {
                mSignalTrackMappings.push({ SignalAssetId: parseInt($(this).data('asset-id'), 10) });
            });

            return {
                mAlerts: mAlerts,
                mFRSAttributeRanges: mFRSAttributeRanges,
                mAlertInfoActivations: mAlertInfoActivations,
                mSignalTrackMappings: mSignalTrackMappings
            };
        }

        function renderAssetConfigTable() {
            var $body = $('#assetConfigBody');
            if (!__modalAttributes || !__modalAttributes.length) {
                $body.html('<tr><td colspan="4" style="text-align:center;color:var(--txm);padding:20px">No attributes for this asset type</td></tr>');
                return;
            }

            var html = '';
            __modalAttributes.forEach(function (attr) {
                var title   = attr.title || attr.name || ('Attr ' + attr.id);
                var selChan = attr.assetInfoChannel || '';
                var selVal  = attr.assetInfoValue   || '';
                var selMult = attr.multiplication   != null ? attr.multiplication : '';

                // Build channel dropdown — Channel 1 to N (same as old site)
                var chanOpts = '<option value="">Select Channel</option>';
                for (var i = 1; i <= __modalChannels; i++) {
                    var chVal = 'Channel' + i;
                    chanOpts += '<option value="' + chVal + '"' + (String(selChan).toLowerCase() === chVal.toLowerCase() ? ' selected' : '') + '>Channel ' + i + '</option>';
                }

                html += '<tr>'
                      +   '<td style="vertical-align:middle;font-weight:500">' + title + '</td>'
                      +   '<td><select class="form-select form-select-sm cfg-channel" data-attr-id="' + attr.id + '">' + chanOpts + '</select></td>'
                      +   '<td><input type="text" class="form-control form-control-sm cfg-value" data-attr-id="' + attr.id + '" value="' + selVal + '"></td>'
                      +   '<td><input type="text" class="form-control form-control-sm cfg-mult"  data-attr-id="' + attr.id + '" value="' + selMult + '"></td>'
                      + '</tr>';
            });
            $body.html(html);
        }
        // ── Save from modal → POST to /Station/SaveAsset ──────────────────────
        function saveAssetFromModal() {
            var name = $('#assetModalName').val().trim();
            if (!name) { $('#assetModalName').focus(); return; }

            // Build mAssetInfos — same structure as old site's fnSaveAsset
            var mAssetInfos = [];
            var skipped = [];
            (__modalAttributes || []).forEach(function (attr) {
                var channel = $('.cfg-channel[data-attr-id="' + attr.id + '"]').val();
                var value   = $('.cfg-value[data-attr-id="'   + attr.id + '"]').val().trim();
                var mult    = $('.cfg-mult[data-attr-id="'    + attr.id + '"]').val().trim();
                // API Asset/SaveAsset only creates an AssetInfo row when Value is filled;
                // isSuccess = the API already has a row for this attribute (then a channel-only change is saved)
                if (channel && !value && !attr.isSuccess) skipped.push(attr.title || attr.name || ('Attr ' + attr.id));
                mAssetInfos.push({
                    AssetAttributeId: attr.id,
                    Channels:         channel || '',   // API/AssetInfo field is "Channels"
                    Value:            value,
                    Multiplication:   mult ? parseFloat(mult) : null
                });
            });
            if (skipped.length && !confirm(
                    'These attributes have a channel but no Value, so the API will NOT save them:\n\n- '
                    + skipped.join('\n- ') + '\n\nEnter a Value for them to save the channel. Save the rest anyway?')) {
                return;
            }

            var payload = {
                Id:           __modalAssetId || 0,
                SiteId:       parseInt(__currentSiteId),
                AssetTypeId:  __modalAssetTypeId,
                Name:         name,
                HttpMisLink:  $('#assetModalHttp').val().trim(),
                NumberOfCell: parseFloat($('#assetModalCells').val()) || null,
                IsActive:     $('#assetModalActive').is(':checked'),
                mAssetInfos:  mAssetInfos
            };
            $.extend(payload, collectAssetExtraTabs());

            // Point Machine details — same rules as 90 SiteList.js: series type and A/B-end names only when Series
            if (__modalAssetTypeId === 3) {
                var isSeries = $('#pmSeries').val() === '1';
                payload.IsHalfPointMachine   = $('#pmHalf').val() === '1';
                payload.IsSeriesOpration     = isSeries;
                payload.SeriesOprationTypeId = isSeries ? parseInt($('#pmSeriesType').val(), 10) : null;
                payload.AliasDirectionA      = isSeries ? $('#pmAliasA').val().trim() : null;
                payload.AliasDirectionB      = isSeries ? $('#pmAliasB').val().trim() : null;
                var tws = parseInt($('#pmTws').val(), 10) || 0;   // 0 = IRS
                payload.IsThickWave          = tws > 0;
                payload.ThickWaveTypeId      = tws > 0 ? tws : null;
            }

            var $saveBtn = $('#addAssetModal .be7');
            $saveBtn.prop('disabled', true).text('Saving…');

            $.ajax({
                url:         '@Url.Action("SaveAsset", "Station")',
                type:        'POST',
                contentType: 'application/json',
                data:        JSON.stringify(payload),
                success: function (res) {
                    if (res && res.success) {
                        $saveBtn.text('✓ Saved');
                        setTimeout(function () {
                            bootstrap.Modal.getInstance(document.getElementById('addAssetModal')).hide();
                            $saveBtn.prop('disabled', false).text('Save');
                            // Re-read the station's assets so a new asset appears straight away
                            loadSiteAssets(__currentSiteId, function () {
                                var n = siteAssetCount(__modalAssetTypeId);
                                $('#atList .ati[data-type-id="' + __modalAssetTypeId + '"] .ac').text(n);
                                $('.adp-h span:last-child').text(n + ' assets');
                                loadAssetsForType(__modalAssetTypeId, __modalAssetTypeName);
                            });
                        }, 900);
                    } else {
                        alert(res && res.error ? res.error : 'Error saving asset.');
                        $saveBtn.prop('disabled', false).text('Save');
                    }
                },
                error: function () {
                    alert('Request failed.');
                    $saveBtn.prop('disabled', false).text('Save');
                }
            });
        }
        // ── Save selection → re-render sidebar → close offcanvas ────────
                function saveAssetTypeConfig() {
            var selectedIds = [];
            var selectedNames = {};

            $('#assetTypeConfigList .at-chk:checked').each(function () {
                var id = parseInt($(this).val(), 10);
                selectedIds.push(id);
                selectedNames[id] = $(this).closest('label').find('span').text().trim();
            });

            saveTypeIds(__currentSiteId, selectedIds);

            // Save names too so sidebar can show them without re-fetching
            if (!__savedTypeNamesBySite) __savedTypeNamesBySite = {};
            __savedTypeNamesBySite[__currentSiteId] = selectedNames;

            renderAssetTypeSidebar();

            var oc = bootstrap.Offcanvas.getInstance(document.getElementById('addTypeOC'));
            if (oc) oc.hide();
        }


    </script>
    <style>    @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }</style>
}
