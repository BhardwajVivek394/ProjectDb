        // Save Row / Terminal for one attribute row → CardLine (same API as 90 Yard Config)
        function svA(btn) {
            var row = btn.closest('.ar');
            var cardLineId = parseInt(row.getAttribute('data-cardline-id'), 10) || 0;
            if (!cardLineId) { E7.warn('This attribute has no card line yet. Set it up in Yard Config on the 90 site first.'); return; }

            var inputs = row.querySelectorAll('.rt-inp');
            var isCur  = row.getAttribute('data-current') === '1';
            var locInp = row.querySelector('.loc-inp');
            var locName = locInp ? locInp.value.trim() : '';
            if (!locName) { E7.warn('Location Name is required'); if (locInp) locInp.focus(); return; }   // 90 ValidateCardLineCircuit
            var rowNo  = inputs[0] ? inputs[0].value.trim() : '';
            function num(i, label) {
                var t = inputs[i] ? inputs[i].value.trim() : '';
                if (t === '') return null;
                var n = parseInt(t, 10);
                if (isNaN(n)) throw label + ' must be a number';
                return n;
            }
            var trm, third;
            try { trm = num(1, 'Terminal +'); third = num(2, isCur ? 'Sequence no.' : 'Terminal -'); }
            catch (msg) { E7.warn(msg); return; }

            var body = { Id: cardLineId, LocationName: locName, RowNumber: rowNo, TerminalNumberPositive: trm };
            if (isCur) body.CurrentSequenceNumber = third; else body.TerminalNumberNegative = third;

            btn.disabled = true; btn.textContent = '…';
            $.ajax({
                url: '@Url.Action("UpdateCardLineLocation", "Station")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(body),
                success: function (res) {
                    if (res && res.success) {
                        E7.success('Saved ' + (locName || 'row'));
                        // keep the in-memory CardLine list in step so re-rendering shows saved values
                        var regroupAssetId = 0;
                        __cardLines.forEach(function (r) {
                            if (r.id === cardLineId) {
                                if ((r.locationName || '') !== (res.locationName || '')) regroupAssetId = r.assetId;
                                r.locationName = res.locationName;
                                r.rowNumber = res.rowNumber;
                                r.terminalNumberPositive = res.terminalNumberPositive;
                                r.terminalNumberNegative = res.terminalNumberNegative;
                                r.currentSequenceNumber = res.currentSequenceNumber;
                            }
                        });
                        // Rows are grouped by Location Name — a changed location moves the row to its new group
                        if (regroupAssetId) { loadAttributesForAsset(regroupAssetId); return; }
                        // show what the API actually stored (blank Row keeps the old one, unused terminal is cleared)
                        if (inputs[0]) inputs[0].value = res.rowNumber != null ? res.rowNumber : '';
                        if (inputs[2]) inputs[2].value = (isCur ? res.currentSequenceNumber : res.terminalNumberNegative) != null
                            ? (isCur ? res.currentSequenceNumber : res.terminalNumberNegative) : '';
                        btn.textContent = '✓'; btn.style.background = 'var(--ok)';
                        setTimeout(function () { btn.textContent = 'Save'; btn.style.background = ''; }, 1500);
                    } else {
                        E7.error(res && res.error ? res.error : 'Save failed');
                        btn.textContent = 'Save';
                    }
                },
                error: function (xhr) { E7.ajaxError(xhr); btn.textContent = 'Save'; },
                complete: function () { btn.disabled = false; }
            });
        }
