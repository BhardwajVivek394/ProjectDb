        // Where a wired attribute sits: "cluster_1/LOC-1 · C-1 · L3 · ADC1 P2"
        function wiredTag(r) {
            var parts = [];
            if (r.clusterName) parts.push(r.clusterName);
            if (r.cardName) parts.push(r.cardName);
            if (r.number) parts.push('L' + r.number);
            if (r.pin) parts.push((r.sequenceNumber ? 'ADC' + r.sequenceNumber + ' ' : '') + 'P' + r.pin);
            var txt = parts.join(' · ');
            return '<div class="aw-wired" title="Wired at: ' + locEsc(txt || 'card line ' + r.id) + '">'
                 + '<span class="d"></span>' + locEsc(txt || 'Wired') + '</div>';
        }

        // ── Card-line wiring: attributes of this asset not yet on any card line (90 Yard Config card-line popup) ──
        var __attrCache  = {};   // assetTypeId → [{id,title}]
        var __wireAsset  = 0;
        var __wireClusters = null;   // per station
        var __wireClustersSite = 0;

        function wireAssetTypeId(assetId, records) {
            var a = __siteAssets.filter(function (x) { return x.id === assetId; })[0];
            if (a && a.assetTypeId) return a.assetTypeId;
            return records.length ? records[0].assetTypeId : 0;
        }

        function renderUnwired(assetId, records) {
            __wireAsset = assetId;
            var typeIdV = wireAssetTypeId(assetId, records);
            if (!typeIdV) { $('#wireBox').html('<div style="padding:8px 4px;color:var(--err);font-size:10px">Asset type of this asset is unknown — reload the station.</div>'); return; }
            function draw(attrs) {
                if (__wireAsset !== assetId) return;   // user moved to another asset meanwhile
                var wired = {};
                records.forEach(function (r) { if (r.attributeId) wired[r.attributeId] = true; });
                // Derived attributes (e.g. "Last Update … sec ago") are calculated, not a physical input — nothing to wire
                var physical = attrs.filter(function (a) { return !a.derived; });
                var derivedN = attrs.length - physical.length;
                var free = physical.filter(function (a) { return !wired[a.id]; });
                renderWireSummary(records, physical.length, physical.length - free.length);

                if (!attrs.length) {
                    $('#wireBox').html('<div style="padding:8px 4px;color:var(--warn);font-size:10px">This asset type has no attributes defined, so there is nothing to wire.</div>');
                    return;
                }
                var note = derivedN ? '<div style="padding:7px 14px 0;color:var(--txl);font-size:9px">' + derivedN + ' calculated attribute' + (derivedN > 1 ? 's' : '') + ' (no wiring needed) not listed.</div>' : '';
                if (!free.length) { $('#wireBox').html(note); return; }
                var h = '<div class="aw-grp">'
                      + '<div class="aw-ghead"><span class="aw-gname"><i class="bi bi-plug"></i>Not wired yet</span>'
                      + '<span class="aw-gcount">' + free.length + ' attribute' + (free.length > 1 ? 's' : '') + '</span></div>';
                free.forEach(function (a) {
                    var isCur = (a.title || '').toLowerCase().indexOf('ma') >= 0;
                    h += '<div class="ar wr aw-un" data-attr-id="' + a.id + '" data-type-id="' + typeIdV + '" data-attr-name="' + locEsc(a.title) + '">'
                       +   '<span class="nm">' + locEsc(a.title) + ' <span class="aw-vi ' + (isCur ? 'I' : 'V') + '">' + (isCur ? 'I' : 'V') + '</span></span>'
                       +   '<span class="st">not on any card line</span>'
                       +   '<button class="wbtn" onclick="openWire(this)"><i class="bi bi-plug"></i> Wire</button>'
                       + '</div>';
                });
                $('#wireBox').html(h + '</div>' + note);
            }
            if (__attrCache[typeIdV]) { draw(__attrCache[typeIdV]); return; }
            $.ajax({
                url: '@Url.Action("GetAssetAttributesByTypeId", "Station")', data: { assetTypeId: typeIdV },
                success: function (res) {
                    if (!Array.isArray(res)) { $('#wireBox').html('<div style="padding:8px 4px;color:var(--err);font-size:10px">' + locEsc((res && res.error) || 'Could not load attributes') + '</div>'); return; }
                    __attrCache[typeIdV] = res.map(function (a) { return { id: a.id, title: a.title || ('Attribute ' + a.id), derived: a.isDerived === true }; })
                                              .sort(function (x, y) { return x.title.localeCompare(y.title, undefined, { numeric: true }); });
                    draw(__attrCache[typeIdV]);
                },
                error: function (xhr) { $('#wireBox').html('<div style="padding:8px 4px;color:var(--err);font-size:10px">Could not load attributes</div>'); }
            });
        }

        // "Wired 3 of 11 attributes" + which cards this asset uses and how many lines on each
