        function readAsBase64(file, cb) {
            var r = new FileReader();
            r.onload = function () {
                var s = r.result || '';
                var i = ('' + s).indexOf(',');
                var b64 = i >= 0 ? ('' + s).substring(i + 1) : ('' + s);
                var dot = file.name.lastIndexOf('.');
                var ext = dot >= 0 ? file.name.substring(dot) : '';
                cb(b64, ext);
            };
            r.readAsDataURL(file);
        }
