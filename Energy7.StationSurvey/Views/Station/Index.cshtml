@{
    ViewData["Title"] = "Station Survey";
}

<!-- ═══ FILTER BAR ═══ -->
<div class="sbar">
    <div class="fg">
        <label>Zone</label>
        <select id="ddZone" asp-items="ViewBag.Zones" onchange="onZoneChange(this.value)">
        </select>
    </div>
    <div class="fg">
        <label>Division</label>
        <select id="ddDivision" asp-items="ViewBag.Divisions" onchange="onDivisionChange(this.value)">
        </select>
    </div>
    <div class="fg">
        <label>Station</label>
        <select id="ddStation" asp-items="ViewBag.Sites" onchange="onStationChange(this.value)">
        </select>
        <button class="bg7" id="btnEditStation" title="Edit station" disabled
                onclick="openStationModal($('#ddStation').val())"><i class="bi bi-pencil-square"></i> Edit</button>
    </div>
    <div class="dv"></div>
    <div class="sbadge"><span class="dot"></span><span id="badgeStatus">Select Station</span></div>
    <span style="font-size:10px;color:var(--txl);margin-left:6px" id="stationInfo"></span>
</div>

<!-- ═══ TABS ═══ -->
<div class="etabs">
    <div class="etab on" data-tab="overview"><i class="bi bi-grid" style="font-size:13px"></i> Overview</div>
    <div class="etab" data-tab="survey"><i class="bi bi-clipboard-data" style="font-size:13px"></i> Survey <span class="tc" id="tabSurveyCount">—</span></div>
    <div class="etab" data-tab="assets"><i class="bi bi-cpu" style="font-size:13px"></i> Assets <span class="tc" id="tabAssetCount">—</span></div>
    <div class="etab" data-tab="location"><i class="bi bi-geo-alt" style="font-size:13px"></i> Location <span class="tc" id="tabLocationCount">—</span></div>
    <div class="etab" data-tab="yard"><i class="bi bi-diagram-3" style="font-size:13px"></i> Yard Config</div>
    <div class="etab" data-tab="material"><i class="bi bi-box-seam" style="font-size:13px"></i> Material</div>
    <div class="etab" data-tab="documents"><i class="bi bi-file-earmark-check" style="font-size:13px"></i> Documents</div>
</div>

<!-- ═══ TAB CONTENT ═══ -->
<div class="econt">

    <!-- ── OVERVIEW ── -->
    <div class="tp on" id="tab-overview">
        <div class="sgrid">
            <div class="sc acc">
                <div class="sl">Total Locations</div>
                <div class="sv" id="statLocations">—</div>
                <div class="ss" id="statLocationsSub">Select a station</div>
            </div>
            <div class="sc">
                <div class="sl">Total Clusters</div>
                <div class="sv" id="statClusters">—</div>
                <div class="ss" id="statClustersSub">—</div>
            </div>
            <div class="sc">
                <div class="sl">Total Data Points</div>
                <div class="sv" id="statDataPoints">—</div>
                <div class="ss" id="statDataPointsSub">—</div>
            </div>
            <div class="sc">
                <div class="sl">Total Assets</div>
                <div class="sv" id="statAssets">—</div>
                <div class="ss" id="statAssetsSub">—</div>
            </div>
            <div class="sc">
                <div class="sl">TDC Countdown</div>
                <div class="sv" style="color:var(--err)">3d</div>
                <div class="ss">Expires: 28 Mar 2026</div>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="ic">
                    <h6><i class="bi bi-building"></i> Station Information</h6>
                    <div class="ir"><span class="il">Station Name</span><span class="iv" id="infoName">—</span></div>
                    <div class="ir"><span class="il">Station Code</span><span class="iv" id="infoCode">—</span></div>
                    <div class="ir"><span class="il">Zone / Division</span><span class="iv" id="infoZoneDiv">—</span></div>
                    <div class="ir"><span class="il">FRS Year</span><span class="iv">2026</span></div>
                    <div class="ir"><span class="il">Start Date</span><span class="iv">15-Nov-2025</span></div>
                    <div class="ir"><span class="il">Stage</span><span class="iv" style="color:var(--co);font-weight:600">Execution</span></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="ic">
                    <h6><i class="bi bi-exclamation-triangle"></i> Dependencies</h6>
                    <div style="margin-bottom:8px">
                        <div style="font-size:10px;font-weight:700;color:var(--err);text-transform:uppercase;margin-bottom:4px">E7</div>
                        <div style="font-size:11px;line-height:1.7">A10 — 80 pcs · Antenna — 80 pcs · AI Card pending</div>
                    </div>
                    <div>
                        <div style="font-size:10px;font-weight:700;color:var(--warn);text-transform:uppercase;margin-bottom:4px">Railway</div>
                        <div style="font-size:11px;line-height:1.7">2 Cluster space N/A · 17 Cluster 110V PS issue</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SURVEY stage checklist — all items ticked marks the stage Completed -->
        <div class="ic" id="surveyCard" style="margin-top:12px">
            <h6 style="display:flex;align-items:center;gap:8px">
                <i class="bi bi-clipboard-check"></i> Survey Stage Checklist
                <span id="surveyProgress" style="font-size:11px;font-weight:600;color:var(--txm)"></span>
                <span id="surveyStageBadge" style="margin-left:auto;font-size:10px;font-weight:700;padding:3px 8px;border-radius:10px"></span>
            </h6>
            <div style="height:5px;background:var(--bd);border-radius:3px;overflow:hidden;margin:4px 0 10px">
                <div id="surveyBar" style="height:100%;width:0;background:var(--ok);transition:width .2s"></div>
            </div>
            <div id="surveyList" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:4px 20px;font-size:12px">
                <div style="color:var(--txm);font-size:11px">Select a station</div>
            </div>
        </div>

        <!-- SURVEY — NMDL / SIP / SMMS document upload (per station) -->
        <div class="ic" id="nmdlCard" style="margin-top:12px">
            <h6 style="display:flex;align-items:center;gap:8px">
                <i class="bi bi-file-earmark-arrow-up"></i> NMDL / Survey Documents
                <span style="margin-left:auto;display:flex;gap:6px;align-items:center">
                    <input type="file" id="nmdlFile" style="display:none"
                           accept=".pdf,.xls,.xlsx,.doc,.docx,.csv,.png,.jpg,.jpeg" onchange="nmdlPicked(this)">
                    <button class="be7" onclick="document.getElementById('nmdlFile').click()"><i class="bi bi-upload me-1"></i>Upload</button>
                </span>
            </h6>
            <div id="nmdlList" style="font-size:12px"><div style="color:var(--txm);font-size:11px">Select a station</div></div>
        </div>
    </div>

    <!-- ── SURVEY ── location-wise: pick a location, add its gears one by one, counts update live.
         Saved to the existing SiteSurvey rows (one per location box) and SurveyPointMachine through the API
         — see StationController.SaveSurvey. Material rules = Cluster-Wise Materials Count sheet. -->
    <div class="tp" id="tab-survey">
        <style>
            .sv-top{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px}
            .sv-top h6{font-size:14px;font-weight:700;margin:0;display:flex;align-items:center;gap:7px}.sv-top h6 i{color:var(--co)}
            .sv-pill{font-size:10px;font-weight:600;padding:3px 9px;border-radius:12px;background:var(--bd-lt);color:var(--txm)}
            .sv-pill.dirty{background:#fdf3e1;color:var(--warn)}
            .sv-lay{display:grid;grid-template-columns:260px minmax(0,1fr);gap:14px;align-items:start}
            @@media (max-width:900px){.sv-lay{grid-template-columns:1fr}}
            .sv-card{background:var(--sf);border:1px solid var(--bd);border-radius:10px;padding:14px 16px;margin-bottom:12px;box-shadow:0 1px 3px rgba(16,24,40,.04)}
            .sv-h{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;margin-bottom:8px}
            .sv-h i{color:var(--co)}.sv-h .sp{flex:1}
            .sv-h .sub{font-size:10px;font-weight:400;color:var(--txl)}
            .sv-step{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:9px;background:var(--co);color:#fff;font-size:10px;font-weight:700}
            .sv-rf{font-size:10px;font-weight:700;color:var(--txm);text-transform:uppercase;letter-spacing:.3px;margin:10px 0 4px}
            .sv-li{display:flex;align-items:center;gap:8px;padding:7px 9px;border:1px solid var(--bd);border-radius:7px;margin-bottom:5px;cursor:pointer;font-size:12px;background:#fff}
            .sv-li:hover{border-color:var(--txl)}
            .sv-li.on{border-color:var(--co);background:var(--co-lt)}
            .sv-li .nm{font-weight:700;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
            .sv-li .ct{font-size:10px;color:var(--txm);white-space:nowrap}
            .sv-li .dot{width:7px;height:7px;border-radius:4px;background:var(--bd)}.sv-li .dot.ok{background:var(--ok)}.sv-li .dot.w{background:var(--warn)}
            .sv-f{display:grid;gap:8px;align-items:end}
            .sv-f label{display:block;font-size:10px;font-weight:600;color:var(--txm);text-transform:uppercase;letter-spacing:.3px;margin-bottom:3px}
            .sv-f input,.sv-f select{width:100%;height:32px;border:1px solid var(--bd);border-radius:7px;padding:0 9px;font-size:12px;background:#fff}
            .sv-f input:focus,.sv-f select:focus{outline:none;border-color:var(--co)}
            .sv-f .be7,.sv-f .bg7{height:32px}
            .sv-head{grid-template-columns:2fr 1fr 1fr 1fr 1fr auto}
            .sv-add{grid-template-columns:1.1fr 1.3fr 1.2fr 1.4fr auto auto;background:var(--hv);border:1px solid var(--bd-lt);border-radius:8px;padding:10px}
            @@media (max-width:1100px){.sv-head,.sv-add{grid-template-columns:1fr 1fr}}
            .sv-msg{font-size:11px;margin-top:6px;min-height:15px}
            .sv-msg.e{color:var(--err)}.sv-msg.w{color:var(--warn)}
            .sv-chips{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 8px}
            .sv-chip{font-size:10px;font-weight:600;padding:3px 9px;border-radius:12px;background:var(--bd-lt);color:var(--txm)}
            .sv-chip b{color:var(--tx)}
            .sv-t{width:100%;border-collapse:collapse;font-size:12px}
            .sv-t th{font-size:10px;font-weight:600;color:var(--txm);text-transform:uppercase;letter-spacing:.3px;padding:6px;text-align:left;white-space:nowrap;border-bottom:1px solid var(--bd)}
            .sv-t td{padding:6px;border-bottom:1px solid var(--bd-lt);vertical-align:middle}
            .sv-t td.n,.sv-t th.n{text-align:center}
            .sv-t tr.ed td{background:var(--co-lt)}
            .sv-t tfoot td{font-weight:700;background:var(--hv)}
            .sv-type{display:inline-block;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;background:#eef4fb;color:#17365d}
            .sv-ib{border:none;background:none;color:var(--txm);cursor:pointer;font-size:13px;padding:2px 5px}.sv-ib:hover{color:var(--co)}.sv-ib.del:hover{color:var(--err)}
            .sv-kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(105px,1fr));gap:8px;margin-top:10px}
            .sv-kpi div{background:var(--hv);border:1px solid var(--bd-lt);border-radius:7px;padding:7px 9px;font-size:10px;color:var(--txm)}
            .sv-kpi b{display:block;font-size:17px;color:var(--tx)}
            .sv-kpi .hl{background:var(--co-lt);border-color:#f6d3ca}.sv-kpi .hl b{color:var(--co-hv)}
            .sv-sens{display:grid;grid-template-columns:repeat(auto-fit,minmax(95px,1fr));gap:6px;margin-top:8px}
            .sv-sens div{font-size:10px;color:var(--txm);border:1px dashed var(--bd);border-radius:6px;padding:5px 8px}.sv-sens b{color:var(--tx);font-size:13px;margin-left:4px}
            .sv-iss{font-size:11px;padding:4px 9px;border-radius:6px;margin-top:5px;display:flex;gap:6px;align-items:flex-start}
            .sv-iss.e{background:#fdecea;color:var(--err)}.sv-iss.w{background:#fdf3e1;color:var(--warn)}.sv-iss.o{background:#e6f5ef;color:var(--ok)}
            .sv-empty{font-size:11px;color:var(--txl);padding:10px 2px;text-align:center}
            .sv-sum{overflow-x:auto}.sv-sum .sv-t{min-width:1100px}.sv-sum td.l{max-width:180px;font-size:11px}
            /* ── restyle: station figures strip + line diagram (mimic survey-detail look) ── */
            .sv-figs{display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:0;border:1px solid var(--bd);border-radius:10px;background:var(--sf);overflow:hidden;margin-bottom:12px;box-shadow:0 1px 3px rgba(16,24,40,.04)}
            .sv-fig{padding:12px 15px;border-right:1px solid var(--bd-lt)}
            .sv-fig:last-child{border-right:0}
            .sv-fig b{display:block;font-size:26px;font-weight:700;line-height:1.05;color:var(--tx);font-variant-numeric:tabular-nums}
            .sv-fig.hl b{color:var(--co-hv)}
            .sv-fig span{display:block;font-size:11px;color:var(--txm);margin-top:5px}
            .sv-fig small{display:block;font-size:10px;color:var(--txl);margin-top:2px}
            .sv-diagram{border:1px solid var(--bd);border-radius:10px;background:var(--sf);padding:8px 10px 10px;margin-bottom:12px;box-shadow:0 1px 3px rgba(16,24,40,.04)}
            .sv-diag-in{overflow-x:auto}
            .sv-diag-in svg{display:block}
            .sv-diag-lg{display:flex;flex-wrap:wrap;gap:16px;font-size:10px;color:var(--txm);margin-top:6px;padding:0 4px}
            .sv-diag-lg span{display:inline-flex;align-items:center;gap:5px}
            .sv-diag-lg i.d{width:9px;height:9px;border-radius:5px;border:2px solid var(--bd);background:#fff}
            .sv-diag-lg i.d.on{border-color:var(--co)}
            /* yard configuration preview (read-only, ported from Cluster-Wise sheet) */
            .sv-yh{display:grid;grid-template-columns:repeat(auto-fit,minmax(90px,1fr));gap:6px;margin-bottom:8px}
            .sv-yh div{background:var(--co-lt);border:1px solid #f6d3ca;border-radius:7px;padding:6px 9px;font-size:10px;color:var(--txm)}
            .sv-yh b{display:block;font-size:16px;color:var(--co-hv)}
            .sv-t tr.sp td{color:var(--txl)}
            .sv-muted{color:var(--txl)}
            /* yard-config tab: suggested configuration preview panel */
            .yc-prev{border:1px solid var(--bd);border-radius:10px;background:var(--sf);margin-bottom:14px;overflow:hidden;box-shadow:0 1px 3px rgba(16,24,40,.04)}
            .yc-prev-h{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:10px 14px;background:var(--co-lt);border-bottom:1px solid var(--bd);font-size:13px;font-weight:700}
            .yc-prev-h i{color:var(--co)}
            .yc-prev-sub{font-size:10px;font-weight:400;color:var(--txm)}
            .yc-prev-chips{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap}
            .yc-prev-chips span{font-size:10px;font-weight:600;background:#fff;border:1px solid var(--bd);border-radius:10px;padding:2px 9px;color:var(--co-hv)}
            .yc-prev-body{padding:10px 14px;overflow-x:auto}
        </style>
        <div class="sv-top">
            <h6><i class="bi bi-clipboard-data"></i> Station Survey</h6>
            <span class="sv-pill" id="svStamp">Select a station</span>
            <span style="flex:1"></span>
            <button class="bg7" onclick="svExportCsv()" title="Export survey as CSV"><i class="bi bi-filetype-csv me-1"></i>CSV</button>
            <button class="bg7" onclick="svExportExcel()" title="Export survey as Excel"><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
            <button class="bg7" onclick="svExportPdf()" title="Print / save survey as PDF"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</button>
            <button class="bg7" onclick="svReload()"><i class="bi bi-arrow-clockwise me-1"></i>Reload</button>
            <button class="be7" id="svSaveBtn" onclick="svSave()"><i class="bi bi-cloud-check me-1"></i>Save survey</button>
        </div>

        <!-- restyle: live station figures + line diagram (locations grouped by RF cluster) -->
        <div class="sv-figs" id="svFigs"></div>
        <div class="sv-diagram" id="svDiagram" style="display:none"></div>

        <div class="sv-lay">
            <!-- Step 1: locations -->
            <div class="sv-card" style="margin:0">
                <div class="sv-h"><span class="sv-step">1</span> Locations <span class="sp"></span>
                    <button class="bg7" style="padding:3px 10px;font-size:11px" onclick="svNewLoc()"><i class="bi bi-plus"></i> New</button></div>
                <div id="svLocList"><div class="sv-empty">Select a station</div></div>
            </div>

            <!-- Step 2 + 3: selected location, its gears and counts -->
            <div>
                <div class="sv-card" id="svLocCard">
                    <div class="sv-h"><span class="sv-step">2</span> Location details <span class="sub" id="svLocSub"></span></div>
                    <div class="sv-f sv-head">
                        <div><label>Location / cluster name</label><input id="svLName" placeholder="LOC-1" onchange="svLocField('name', this.value)"></div>
                        <div><label>RF cluster</label><input id="svLRf" type="number" min="1" max="50" onchange="svLocField('rf', this.value)"></div>
                        <div><label>Side <span style="color:var(--err)">*</span></label><input id="svLSide" placeholder="UP / DN" onchange="svLocField('side', this.value)"></div>
                        <div><label>Dist. from RR (m) <span style="color:var(--err)">*</span></label><input id="svLDist" onchange="svLocField('dist', this.value)"></div>
                        <div><label>Loc-to-loc dist (m)</label><input id="svLL2L" onchange="svLocField('l2l', this.value)"></div>
                        <div><button class="bg7" title="Remove location" onclick="svDelLoc()"><i class="bi bi-trash"></i></button></div>
                    </div>
                    <div class="sv-msg e" id="svLocMsg"></div>
                </div>

                <div class="sv-card">
                    <div class="sv-h"><span class="sv-step">3</span> Gears in this location <span class="sub">Type → name → configuration → Add. Press Enter to add quickly.</span></div>
                    <div class="sv-f sv-add">
                        <div><label>Gear type</label><select id="svGType" onchange="svTypeChanged()"></select></div>
                        <div><label>Gear name / ID</label><input id="svGName" placeholder="117TF, S2, SH-01, P1"></div>
                        <div id="svGCfgW"><label id="svGCfgL">Configuration</label><select id="svGCfg" onchange="svCfgChanged()"></select></div>
                        <div id="svGSubW"><label>Point machine detail</label><select id="svGSub"></select></div>
                        <div><button class="be7" id="svGAddBtn" onclick="svAddGear()">Add</button></div>
                        <div><button class="bg7" id="svGCancel" onclick="svCancelEdit()" style="visibility:hidden">Cancel</button></div>
                    </div>
                    <div class="sv-msg" id="svGMsg"></div>
                    <div class="sv-chips" id="svChips"></div>
                    <div style="overflow-x:auto">
                        <table class="sv-t">
                            <thead><tr><th>Gear name</th><th>Type</th><th>Configuration</th><th>Material rule</th><th class="n">V</th><th class="n">C</th><th style="width:60px"></th></tr></thead>
                            <tbody id="svGearRows"></tbody>
                        </table>
                    </div>
                    <div class="sv-kpi" id="svKpi"></div>
                    <div class="sv-sens" id="svSens"></div>
                </div>

                <div class="sv-card" id="svYardCard">
                    <div class="sv-h"><i class="bi bi-diagram-3" style="color:var(--co)"></i> Yard configuration (preview)
                        <span class="sub">Auto-assigned MintCard / CI / ADC / Pin from this location's gears · preview only, not saved to yard yet</span></div>
                    <div id="svYard"></div>
                </div>
            </div>
        </div>

        <!-- Step 4: station summary + checks -->
        <div class="sv-card">
            <div class="sv-h"><span class="sv-step">4</span> Station summary <span class="sub">All locations together. Click a row to open that location.</span></div>
            <div id="svChecks"></div>
            <div class="sv-sum" style="margin-top:8px"><table class="sv-t" id="svSummary"></table></div>
        </div>
    </div>

    <!-- ── ASSETS ── -->
    <div class="tp" id="tab-assets">
        <div class="alay">
            <div class="asb">
                <div class="asb-h">
                    <h6>Asset Types</h6>
                    <button class="be7" style="padding:2px 8px;font-size:10px"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#addTypeOC"
                            title="Configure Asset Types">
                        <i class="bi bi-plus"></i>
                    </button>
                </div>
                <div class="offcanvas offcanvas-end" tabindex="-1" id="addTypeOC" data-bs-backdrop="false" data-bs-scroll="true">
                    <div class="offcanvas-header" style="border-bottom:1px solid var(--bd)">
                        <h5 class="offcanvas-title" style="font-size:13px;font-weight:700">
                            Configure Asset Types
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                    </div>
                    <div class="offcanvas-body" style="font-size:12px">
                        <div id="assetTypeConfigList">
                            <div style="padding:12px;text-align:center;color:var(--txm)">Loading…</div>
                        </div>
                        <div style="position:sticky;bottom:0;padding:10px 0;background:#fff">
                            <button class="be7 w-100" onclick="saveAssetTypeConfig()">Save</button>
                        </div>
                    </div>
                </div>
                <ul class="atl" id="atList">
                    <li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">Select a station</li>
                </ul>
            </div>
            <div class="adp">
                <div class="adp-h">
                    <h6 id="adTitle">DC Tracks</h6>
                    <span style="font-size:10px;color:var(--txm)">35 assets · 8 unverified</span>
                </div>
                <div class="aig">
                    <div class="aic">
                        <div class="ct" id="assetListTitle">Track Name</div>
                        <div class="ais">
                            <div class="adi">
                                <input type="text" placeholder="Add name" id="newTrackIn">
                                <button onclick="openAddAssetModal()" title="Add Asset"><i class="bi bi-plus"></i></button>
                            </div>
                            <div id="trackList">
                                <div class="fot-group" data-fot="1T">
                                    <div class="fot-parent sel" draggable="true" data-track="1T" onclick="selTrack(this,'1T')" ondragover="fotDragOver(event,this)" ondragleave="fotDragLeave(this)" ondrop="fotDrop(event,this)">
                                        <span class="fot-icon open">&#9654;</span><span>1T</span><span class="fot-badge">FOT 3</span>
                                    </div>
