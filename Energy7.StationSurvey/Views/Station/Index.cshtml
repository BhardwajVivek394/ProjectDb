        // Card kind from its name: C-n current, V5/V82 voltage, DI digital, MintCard
        function wmCardKind(name) {
            var n = (name || '').toUpperCase();
            if (n.indexOf('C-') === 0) return 'I';
            if (n.indexOf('DI-') === 0) return 'DI';
            if (n.indexOf('MINTCARD-') === 0) return 'M';
