                 // ── State ─────────────────────────────────────────────────────────────────
        var __masterAssetTypes   = [];
        var __siteAssetTypes     = [];
        var __currentSiteId      = 0;
        var __cardLineTypeCounts = {};
        var __cardLines          = [];
        var __siteAssets         = [];      // all assets of the station (Asset API)
        var __siteAssetsLoaded   = false;
        var __savedTypeIdsBySite = {};   // { siteId: [typeId, typeId, ...] } — cleared on refresh
        var __savedTypeNamesBySite = {};

        // ── Selection helpers (in-memory, per page load) ──────────────────────────
        function getSavedTypeIds(siteId) {
            return __savedTypeIdsBySite[siteId] || null;
        }
        function saveTypeIds(siteId, ids) {
            __savedTypeIdsBySite[siteId] = ids;
        }

        // ── Also clear any legacy cookies from earlier testing ────────────────────
        (function clearLegacyCookies() {
            document.cookie.split(';').forEach(function (c) {
                var name = c.split('=')[0].trim();
                if (name.indexOf('assetTypes_') === 0) {
                    document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
                }
            });
        })();

        // ── Field helpers (tolerant of casing differences) ────────────────────────
        function typeId(t)   { return t.id ?? t.assetTypeId ?? 0; }
        function typeName(t) { return t.name ?? t.assetTypeName ?? 'Unknown'; }
        function typeCount(t){ return t.assetCount ?? t.count ?? 0; }
        function typeUnver(t){ return t.unverifiedCount ?? t.unverified ?? 0; }

        // ── Load both datasets, then render sidebar ───────────────────────────────
                          function loadAssetTypes(siteId) {
            __currentSiteId = siteId;
            $('#atList').html('<li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">Loading…</li>');

            // Site-scoped list (primary source for sidebar)
            var pSite = $.ajax({
                url: '/Station/GetAllAssetTypeById',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify([siteId])
            });

            // Master list (used only for the offcanvas checklist)
            var pMaster = $.ajax({
                url: '/Station/GetAllAssetType',
                type: 'GET'
            });

            $.when(pSite, pMaster).done(function (siteRes, masterRes) {
                __siteAssetTypes   = (siteRes[0]   && !siteRes[0].error)   ? siteRes[0]   : [];
                __masterAssetTypes = (masterRes[0] && !masterRes[0].error) ? masterRes[0] : [];
                renderAssetTypeSidebar();
            }).fail(function () {
                $('#atList').html('<li style="padding:12px;text-align:center;color:var(--err);font-size:11px">Failed to load</li>');
            });
        }

        // A station change calls this from three async callbacks in quick succession, which
        // redrew the asset sidebar three times and made it flicker. Coalesce the burst into
        // one draw on the next frame, using whatever data has arrived by then.
        var __sbTimer = null;
        function renderAssetTypeSidebar() {
            clearTimeout(__sbTimer);
            __sbTimer = setTimeout(function () { __sbTimer = null; renderSidebarNow(); }, 45);
        }
        function renderSidebarNow() {
            var $list = $('#atList');
            var saved = getSavedTypeIds(__currentSiteId);
            var savedNames = (__savedTypeNamesBySite && __savedTypeNamesBySite[__currentSiteId]) || {};

            var toShow;
            if (saved && saved.length) {
                // Build list from saved IDs — merge name from savedNames first,
                // fall back to __siteAssetTypes, fall back to __masterAssetTypes
                toShow = saved.map(function (id) {
                    // try site types first
                    var found = __siteAssetTypes.find(function (t) { return typeId(t) === id; });
                    if (!found && __masterAssetTypes.length) {
                        found = __masterAssetTypes.find(function (t) { return typeId(t) === id; });
                    }
                    // if still not found, build a minimal object from the saved name
                    if (!found) {
                        found = { id: id, name: savedNames[id] || ('Type ' + id), assetCount: 0 };
                    }
                    return found;
                });
            } else {
                toShow = __siteAssetTypes;
            }

            if (!toShow.length) {
                $list.html('<li style="padding:12px;text-align:center;color:var(--txm);font-size:11px">No asset types for this site</li>');
                $('#tabAssetCount').text(0);
                return;
            }

            var totalAssets = 0;
            var html = '';

            $.each(toShow, function (i, t) {
                var id     = typeId(t);
                var name   = typeName(t);
                var clInfo = __cardLineTypeCounts[id];
                var count  = __siteAssetsLoaded ? siteAssetCount(id) : (clInfo ? clInfo.count : typeCount(t));
                var unver  = typeUnver(t);

                totalAssets += count;
                var isFirst  = (i === 0) ? ' on' : '';
                var unvBadge = unver > 0 ? '<span class="ae">' + unver + '?</span>' : '';

                html += '<li class="ati' + isFirst + '" data-type-id="' + id + '" data-type-name="' + name + '">'
                      +     '<span>' + name + '</span>'
                      +     '<span><span class="ac">' + count + '</span>' + unvBadge + '</span>'
                      + '</li>';
            });

            $list.html(html);
            $('#tabAssetCount').text(totalAssets);

            var first     = toShow[0];
            var firstId   = typeId(first);
            var firstInfo = __cardLineTypeCounts[firstId];
