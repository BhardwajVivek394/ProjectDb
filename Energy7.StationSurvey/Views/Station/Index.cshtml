        function ycOnOpen() {
            ensureYcCss();
            var site = parseInt(__currentSiteId, 10) || 0;
            if (!site) { $('#ycStationSub').text('Select a station first'); $('#ycClusterList').html('<div class="yc-empty">Select a station</div>'); $('#ycStats').html(''); return; }
            if (site === __ycSite && __ycClusters.length) return;   // already loaded for this station
            ycLoad(site);
        }

        function ycLoad(site) {
            $('#ycStationSub').text(($('#infoName').text() || '') + ' — loading…');
            // Keep the current list visible (dimmed) on refresh; show skeleton only on first load
            if ($('#ycClusterList .yc-cl').length) ycOverlay('#ycClusterList', true);
            else $('#ycClusterList').html('<div class="yc-empty"><div class="e7-spin" style="margin:10px auto"></div>Loading…</div>');
            $.ajax({
                url: '@Url.Action("GetYardClusters", "Station")', data: { siteId: site },
                success: function (res) {
                    if (!res || res.error || !Array.isArray(res.clusters)) {
                        $('#ycClusterList').html('<div class="yc-empty" style="color:var(--err)">' + locEsc((res && res.error) || 'Could not load') + '</div>');
                        return;
                    }
                    __ycSite = site; __ycClusters = res.clusters; __ycCache = {}; __ycSelId = 0;
                    ycRenderList();
                    ycRenderStats();
                    if (__ycClusters.length) ycSelectCluster(__ycClusters[0].id);
                    else $('#ycDetail').html('<div class="yc-empty-lg"><i class="bi bi-diagram-3"></i><div>No clusters yet. Add a location on the <b>Location</b> tab, then wire assets.</div></div>');
                },
                error: function (xhr) { $('#ycClusterList').html('<div class="yc-empty" style="color:var(--err)">Request failed</div>'); }
            });
        }

        function ycRenderStats() {
            var nCl = __ycClusters.length;
            var wired = __ycClusters.reduce(function (s, c) { return s + (c.wiredLines || 0); }, 0);
            var assets = __ycClusters.reduce(function (s, c) { return s + (c.assetCount || 0); }, 0);
            $('#ycStationSub').text(($('#infoName').text() || '') + ' · hardware wiring layout');
            $('#ycStats').html(
                '<div class="yc-stat"><b>' + nCl + '</b><span>Clusters</span></div>'
              + '<div class="yc-stat"><b>' + wired + '</b><span>Wired lines</span></div>'
              + '<div class="yc-stat"><b>' + assets + '</b><span>Asset links</span></div>');
            $('#ycClusterCount').text(nCl);
        }

        function ycRenderList() {
            if (!__ycClusters.length) { $('#ycClusterList').html('<div class="yc-empty">No clusters</div>'); return; }
            $('#ycClusterList').html(__ycClusters.map(function (c) {
                var typ = c.typeId === 1 ? '<span class="yc-pill indoor">Indoor</span>' : c.typeId === 2 ? '<span class="yc-pill outdoor">Outdoor</span>' : '';
                var wired = c.wiredLines ? '<span class="yc-pill wired">' + c.wiredLines + ' wired</span>' : '<span class="yc-pill">empty</span>';
                return '<div class="yc-cl' + (c.id === __ycSelId ? ' on' : '') + '" data-id="' + c.id + '" onclick="ycSelectCluster(' + c.id + ')">'
                     +   '<div class="yc-cl-top"><span class="yc-cl-nm">' + locEsc(c.location || c.name) + '</span>'
                     +     (c.rfCluster ? '<span class="yc-cl-rf">RF ' + c.rfCluster + '</span>' : '') + '</div>'
                     +   '<div class="yc-cl-meta">' + typ + wired + (c.modemId ? '<span style="color:var(--txl)">· ' + locEsc(c.modemId) + '</span>' : '') + '</div>'
                     + '</div>';
            }).join(''));
        }

        // Overlay a panel with a spinner while keeping its current content (and height) in place,
        // so loading never collapses the panel and makes it jump/flicker.
        function ycOverlay(sel, on) {
            var $e = $(sel);
            if (on) {
                $e.addClass('yc-rel');
                if (!$e.children('.yc-busy').length) {
                    $e.children().addClass('yc-dim');
                    $e.append('<div class="yc-busy"><div class="e7-spin"></div></div>');
                }
            } else {
                $e.children('.yc-busy').remove();
                $e.children().removeClass('yc-dim');
            }
        }

        function ycSelectCluster(id) {
            __ycSelId = id;
            $('#ycClusterList .yc-cl').removeClass('on');
            $('#ycClusterList .yc-cl[data-id="' + id + '"]').addClass('on');
            var cl = __ycClusters.filter(function (c) { return c.id === id; })[0];
            if (!cl) return;
            if (__ycCache[id]) { ycRenderDetail(cl, __ycCache[id]); return; }   // cached → instant, no spinner
            ycOverlay('#ycDetail', true);   // keep old cards visible (dimmed) while the new ones load
            $.ajax({
                url: '@Url.Action("GetWireCards", "Station")', data: { clusterId: id },
                success: function (res) {
                    if (__ycSelId !== id) { ycOverlay('#ycDetail', false); return; }
                    if (!res || res.error) { ycOverlay('#ycDetail', false); $('#ycDetail').html('<div class="yc-empty-lg" style="color:var(--err)">' + locEsc((res && res.error) || 'Could not load') + '</div>'); return; }
                    __ycCache[id] = res;
                    ycRenderDetail(cl, res);   // replaces content (overlay removed with it)
                },
                error: function (xhr) { ycOverlay('#ycDetail', false); $('#ycDetail').html('<div class="yc-empty-lg" style="color:var(--err)">Request failed</div>'); }
            });
        }

        function ycRenderDetail(cl, data) {
            var cards = data.cards || [], adcs = data.adcs || [];
            var power = { 1: '24 V', 2: '110 V', 3: '110→24 V' }[cl.powerSupplyId] || '—';
            var totLines = 0, usedLines = 0;
            cards.forEach(function (c) { totLines += c.total; usedLines += c.used; });

            var head = '<div class="yc-dh"><div style="flex:1">'
                     +   '<div class="yc-dh-nm">' + locEsc(cl.location || cl.name) + '</div>'
                     +   '<div class="yc-dh-tags">'
                     +     (cl.rfCluster ? '<span class="t">RF <b>' + cl.rfCluster + '</b></span>' : '')
                     +     '<span class="t">' + (cl.typeId === 1 ? 'Indoor' : cl.typeId === 2 ? 'Outdoor' : '—') + '</span>'
                     +     '<span class="t">Power <b>' + power + '</b></span>'
                     +     (cl.modemId ? '<span class="t">Modem <b>' + locEsc(cl.modemId) + '</b></span>' : '')
                     +     (cl.ip ? '<span class="t">IP <b>' + locEsc(cl.ip) + '</b></span>' : '')
                     +     '<span class="t">Cards <b>' + cards.length + '</b></span>'
                     +     '<span class="t">Lines <b>' + usedLines + ' / ' + totLines + '</b></span>'
                     +   '</div></div>'
                     +   '<button class="bg7" onclick="editLocation(' + cl.id + ')" title="Edit this location"><i class="bi bi-pencil"></i> Edit</button>'
                     + '</div>';

            var adcRow = '<div class="yc-adc"><span class="yc-adc-lbl">ADCs</span>'
                       + (adcs.length ? adcs.map(function (a) { return '<span class="chip">' + locEsc(a.name) + '</span>'; }).join('')
                                      : '<span class="yc-adc-none">none yet</span>')
                       + '<button class="yc-adc-add" onclick="ycToggleAdcForm(this)" title="Add an ADC to this cluster"><i class="bi bi-plus"></i> ADC</button>'
                       + '<span class="yc-adc-form" style="display:none">'
                       +   '<input class="loc-s-sm yc-adcnum" type="number" min="1" placeholder="ADC no." style="width:76px">'
                       +   '<select class="loc-s-sm yc-adctype" style="width:118px"><option value="2">Normal</option><option value="1">Special 1056</option><option value="3">Special 1507</option></select>'
                       +   '<button class="be7" style="padding:3px 11px" onclick="ycAddAdc(this)">Add</button>'
                       +   '<button class="bg7" style="padding:3px 9px" onclick="ycToggleAdcForm(this)">Cancel</button>'
                       + '</span>'
                       + '</div>';

            var cardHtml = cards.map(function (c) {
                var k = wmCardKind(c.name);
                var kb = { I: 'CURRENT', V: 'VOLTAGE', DI: 'DIGITAL', M: 'MINT' }[k];
                var pct = c.total ? Math.round(c.used * 100 / c.total) : 0;
                var rows = (c.lines || []).map(function (l) {
                    if (!l.used) return '<tr class="free"><td class="ln">L' + l.number + '</td><td colspan="2"><span class="dot f"></span>free</td><td class="ap"></td></tr>';
                    var isCur = (l.attributeName || '').toLowerCase().indexOf('ma') >= 0;
                    var ap = [l.adc, l.pin ? 'P' + l.pin : ''].filter(Boolean).join('·');
                    return '<tr class="used"><td class="ln">L' + l.number + '</td>'
                         + '<td class="as">' + locEsc(l.assetName || '—') + '</td>'
                         + '<td class="at">' + locEsc(l.attributeName || '') + (l.attributeName ? '<span class="vi ' + (isCur ? 'I' : 'V') + '">' + (isCur ? 'I' : 'V') + '</span>' : '') + '</td>'
                         + '<td class="ap">' + locEsc(ap) + '</td></tr>';
                }).join('');
                return '<div class="yc-card k-' + k + '">'
                     +   '<div class="yc-card-h"><span class="nm">' + locEsc(c.name) + '</span><span class="kb">' + kb + '</span>'
                     +     '<span class="use">' + c.used + '/' + c.total + '</span><div class="ubar"><i style="width:' + pct + '%"></i></div>'
                     +     '<button class="yc-map-btn" onclick="ycOpenMap(' + c.id + ')" title="Map / edit this card’s lines"><i class="bi bi-pencil-square"></i> Map</button></div>'
                     +   '<table class="yc-sched"><tbody>' + (rows || '<tr><td class="yc-empty">no lines</td></tr>') + '</tbody></table>'
                     + '</div>';
            }).join('');

            var addKind = { C: 'I', V5: 'V', V82: 'V', MintCard: 'M', DI: 'DI' };
            var addTile = '<div class="yc-addcard">'
                        +   '<div class="yc-ac-h"><i class="bi bi-plus-circle"></i> Add a card</div>'
                        +   '<div class="yc-ac-sub">Pick a card type — it is created with its empty lines</div>'
                        +   '<div class="yc-ac-types">'
                        +     ['C', 'V5', 'V82', 'MintCard', 'DI'].map(function (t, i) {
                                  return '<button class="yc-ac-type k-' + addKind[t] + (i === 0 ? ' on' : '') + '" data-t="' + t + '" onclick="ycPickAddType(this)">' + t + '</button>';
                              }).join('')
                        +   '</div>'
                        +   '<button class="be7 yc-ac-add" onclick="ycAddCard(this)"><i class="bi bi-plus-lg"></i> Add card</button>'
                        + '</div>';

            $('#ycDetail').html(head + adcRow + '<div class="yc-cards">' + cardHtml + addTile + '</div>');
            __ycAddType = 'C';
        }

        var __ycAddType = 'C';
        function ycPickAddType(btn) {
            __ycAddType = $(btn).data('t');
            $(btn).closest('.yc-ac-types').find('.yc-ac-type').removeClass('on');
            $(btn).addClass('on');
        }

        function ycAddCard(btn) {
            var ct = __ycAddType || 'C', cid = __ycSelId;
            if (!cid) return;
            if (!confirm('Add a new ' + ct + ' card (with its empty lines) to this cluster?')) return;
            btn.disabled = true; btn.textContent = '…';
            $.ajax({
                url: '@Url.Action("AddClusterCard", "Station")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ SiteId: parseInt(__currentSiteId, 10) || 0, ClusterId: cid, CardType: ct }),
                success: function (res) {
                    if (!(res && res.success)) { E7.error((res && res.error) || 'Could not add card'); btn.disabled = false; btn.textContent = 'Add'; return; }
                    E7.success(ct + ' card added');
                    delete __ycCache[cid];           // force reload with the new card
                    ycSelectCluster(cid);
                },
                error: function (xhr) { E7.ajaxError(xhr); btn.disabled = false; btn.textContent = 'Add'; }
            });
        }

        // ── Add ADC to the selected cluster (same API as 90 Yard Config → POST api/ADC) ──
        function ycToggleAdcForm(btn) {
            var $form = $(btn).closest('.yc-adc').find('.yc-adc-form');
            var $add = $(btn).closest('.yc-adc').find('.yc-adc-add');
            if ($form.is(':visible')) { $form.hide(); $add.show(); }
            else { $form.css('display', 'inline-flex'); $add.hide(); $form.find('.yc-adcnum').val('').focus(); }
        }
        function ycAddAdc(btn) {
            var $form = $(btn).closest('.yc-adc-form');
            var num = parseInt($form.find('.yc-adcnum').val(), 10) || 0;
            var type = parseInt($form.find('.yc-adctype').val(), 10) || 0;
            var cid = __ycSelId;
            if (!cid) return;
            if (!num) { E7.warn('Enter the ADC number'); $form.find('.yc-adcnum').focus(); return; }
            btn.disabled = true; btn.textContent = '…';
            $.ajax({
                url: '@Url.Action("AddClusterAdc", "Station")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ SiteId: parseInt(__currentSiteId, 10) || 0, ClusterId: cid, AdcNumber: num, AdcTypeId: type }),
                success: function (res) {
                    if (!(res && res.success)) { E7.error((res && res.error) || 'Could not add ADC'); btn.disabled = false; btn.textContent = 'Add'; return; }
                    E7.success('ADC ' + num + ' added');
                    delete __ycCache[cid];       // refresh so the new ADC chip + the wire dialog's ADC list update
                    ycSelectCluster(cid);
                },
                error: function (xhr) { E7.ajaxError(xhr); btn.disabled = false; btn.textContent = 'Add'; }
            });
        }


        // ── Map Card modal: map / re-map / clear all lines of a card at once (like 90 fnEditCardLine) ──
        var __map = { clusterId: 0, cardId: 0, cardName: '', adcs: [], types: [], assetsByType: {}, lines: [] };

        function ycEnsureMapModal() {
            if (document.getElementById('mapModal')) return;
            $('body').append(
                '<div class="modal fade" id="mapModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content">'
              +   '<div class="modal-header"><h5 class="modal-title"><i class="bi bi-diagram-3 me-2" style="color:var(--co)"></i>Map <span id="mapTitle"></span></h5>'
              +     '<button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>'
              +   '<div class="modal-body"><div class="map-intro" id="mapIntro"></div>'
              +     '<div class="map-wrap"><table class="map-tbl"><thead><tr>'
              +       '<th>Line</th><th>Asset Type</th><th>Asset</th><th>Attribute</th><th>ADC</th><th>Pin</th><th></th>'
              +     '</tr></thead><tbody id="mapBody"></tbody></table></div></div>'
              +   '<div class="modal-footer" style="border-top:1px solid var(--bd);padding:10px 18px">'
              +     '<span class="map-foot-info" id="mapInfo"></span>'
              +     '<button class="bg7" data-bs-dismiss="modal">Cancel</button>'
              +     '<button class="be7" id="mapSave" onclick="ycMapSave()">Save mapping</button>'
              +   '</div>'
              + '</div></div></div>');
        }

        function ycOpenMap(cardId) {
            ensureYcCss(); ycEnsureMapModal();
            var data = __ycCache[__ycSelId];
            if (!data) { E7.warn('Reload the cluster first.'); return; }
            var card = (data.cards || []).filter(function (c) { return c.id === cardId; })[0];
            if (!card) return;
            __map = {
                clusterId: __ycSelId, cardId: cardId, cardName: card.name,
                adcs: data.adcs || [],
                types: __siteAssetTypes.map(function (t) { return { id: typeId(t), name: typeName(t) }; }).filter(function (t) { return t.id; }),
                assetsByType: {}, lines: card.lines || []
            };
            __siteAssets.forEach(function (a) { (__map.assetsByType[a.assetTypeId] = __map.assetsByType[a.assetTypeId] || []).push({ id: a.id, name: a.name }); });

            $('#mapTitle').text(__map.cardName + ' — ' + ($('.yc-dh-nm').text() || ''));
            $('#mapIntro').html('Assign an <b>asset + attribute</b> (and optionally an ADC + pin) to each line of this card. '
                + 'All changes save together. Leave a line blank to keep it free, or press ✕ to clear a mapping.');
            $('#mapBody').html('<tr><td colspan="7" style="padding:24px;text-align:center"><div class="e7-spin" style="margin:0 auto"></div></td></tr>');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('mapModal')).show();

            // Preload attribute sets for the types already used by lines + the first type (for fresh rows)
            var needed = {};
            __map.lines.forEach(function (l) { if (l.assetTypeId) needed[l.assetTypeId] = true; });
            if (__map.types.length) needed[__map.types[0].id] = true;
            var typeIds = Object.keys(needed).map(Number);
            var pending = typeIds.length;
            if (!pending) { ycMapRenderRows(); return; }
            typeIds.forEach(function (t) { ycEnsureAttrs(t, function () { if (--pending === 0) ycMapRenderRows(); }); });
        }

        function ycEnsureAttrs(tid, cb) {
            if (__attrCache[tid]) { cb(); return; }
            $.ajax({
                url: '@Url.Action("GetAssetAttributesByTypeId", "Station")', data: { assetTypeId: tid },
                success: function (res) {
                    __attrCache[tid] = Array.isArray(res) ? res.map(function (a) { return { id: a.id, title: a.title || ('Attribute ' + a.id), derived: a.isDerived === true }; }) : [];
                    cb();
                },
                error: function (xhr) { __attrCache[tid] = []; cb(); }
            });
        }

        function mapOpts(list, selId, ph) {
            return '<option value="">' + ph + '</option>'
                 + list.map(function (o) { return '<option value="' + o.id + '"' + (String(o.id) === String(selId) ? ' selected' : '') + '>' + locEsc(o.name != null ? o.name : o.title) + '</option>'; }).join('');
        }

        function ycMapRenderRows() {
            var pins = []; for (var i = 1; i <= 10; i++) pins.push({ id: i, name: 'Pin ' + i });
            var body = __map.lines.map(function (l) {
                var assets = __map.assetsByType[l.assetTypeId] || [];
                var attrs = (__attrCache[l.assetTypeId] || []).map(function (a) { return { id: a.id, name: a.title }; });
                return '<tr data-line-id="' + l.id + '" data-number="' + l.number + '"' + (l.used ? ' class="set"' : '') + '>'
                     +   '<td class="map-ln">L' + l.number + '</td>'
                     +   '<td><select class="map-sel map-type" onchange="ycMapTypeChange(this)">' + mapOpts(__map.types, l.assetTypeId || '', 'Type') + '</select></td>'
                     +   '<td><select class="map-sel map-asset" onchange="ycMapRowTouch(this)">' + mapOpts(assets, l.assetId || '', 'Asset') + '</select></td>'
                     +   '<td><select class="map-sel map-attr" onchange="ycMapRowTouch(this)">' + mapOpts(attrs, l.attributeId || '', 'Attribute') + '</select></td>'
                     +   '<td><select class="map-sel map-adc">' + mapOpts(__map.adcs, l.adcId || '', 'ADC') + '</select></td>'
                     +   '<td><select class="map-sel map-pin">' + mapOpts(pins, l.pin || '', 'Pin') + '</select></td>'
                     +   '<td><button class="map-clr" title="Clear this line" onclick="ycMapClearRow(this)">✕</button></td>'
                     + '</tr>';
            }).join('');
            $('#mapBody').html(body || '<tr><td colspan="7" style="padding:16px;text-align:center;color:var(--txm)">This card has no lines.</td></tr>');
            ycMapInfo();
        }

        function ycMapTypeChange(sel) {
            var $tr = $(sel).closest('tr');
            var t = parseInt(sel.value, 10) || 0;
            $tr.find('.map-asset').html(mapOpts(__map.assetsByType[t] || [], '', 'Asset'));
            var $attr = $tr.find('.map-attr').html('<option value="">Loading…</option>').prop('disabled', true);
            if (!t) { $attr.html('<option value="">Attribute</option>').prop('disabled', false); ycMapRowTouch(sel); return; }
            ycEnsureAttrs(t, function () {
                $attr.html(mapOpts((__attrCache[t] || []).map(function (a) { return { id: a.id, name: a.title }; }), '', 'Attribute')).prop('disabled', false);
                ycMapRowTouch(sel);
            });
        }

        function ycMapRowTouch(sel) {
            var $tr = $(sel).closest('tr');
            var ok = $tr.find('.map-asset').val() && $tr.find('.map-attr').val();
            $tr.toggleClass('set', !!ok);
            ycMapInfo();
        }

        function ycMapClearRow(btn) {
            $(btn).closest('tr').find('select').val('').end().removeClass('set');
            ycMapInfo();
        }

        function ycMapInfo() {
            var n = 0;
            $('#mapBody tr[data-line-id]').each(function () { if ($(this).find('.map-asset').val() && $(this).find('.map-attr').val()) n++; });
            $('#mapInfo').text(n + ' of ' + __map.lines.length + ' line' + (__map.lines.length === 1 ? '' : 's') + ' mapped');
        }

        function ycMapSave() {
            var lines = [], err = '';
            $('#mapBody tr[data-line-id]').each(function () {
                var $tr = $(this), num = $tr.data('number');
                var type = parseInt($tr.find('.map-type').val(), 10) || 0;
                var asset = parseInt($tr.find('.map-asset').val(), 10) || 0;
                var attr = parseInt($tr.find('.map-attr').val(), 10) || 0;
                var adc = parseInt($tr.find('.map-adc').val(), 10) || 0;
                var pin = parseInt($tr.find('.map-pin').val(), 10) || 0;
                if ((asset || attr) && !(asset && attr && type) && !err) err = 'Line ' + num + ': choose asset type, asset and attribute together (or clear all).';
                if ((!!adc !== !!pin) && !err) err = 'Line ' + num + ': select both ADC and Pin, or neither.';
                lines.push({ Id: parseInt($tr.data('line-id'), 10), AssetTypeId: type || null, AssetId: asset || null, AttributeId: attr || null, ADCId: adc || null, Pin: pin || null });
            });
            if (err) { E7.warn(err); return; }
            var $btn = $('#mapSave').prop('disabled', true).text('Saving…');
            $.ajax({
                url: '@Url.Action("SaveCardLines", "Station")', type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ SiteId: parseInt(__currentSiteId, 10) || 0, ClusterId: __map.clusterId, CardId: __map.cardId, Lines: lines }),
                success: function (res) {
                    $btn.prop('disabled', false).text('Save mapping');
                    if (!(res && res.success)) { E7.error((res && res.error) || 'Save failed'); return; }
                    E7.success('Mapping saved for ' + (__map.cardName || 'card'));
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('mapModal')).hide();
                    delete __ycCache[__map.clusterId];
                    ycSelectCluster(__map.clusterId);
                    reloadCardLines(function () {});   // keep the Assets tab in step
                },
                error: function (xhr) { $btn.prop('disabled', false).text('Save mapping'); E7.ajaxError(xhr); }
            });
        }

        $(function () { $('#ycRefresh').on('click', function () { __ycSite = 0; ycOnOpen(); }); });

        // ── Global loading: one calm top progress bar instead of per-section spinners ──
        // Shows only if a request takes >180ms, so quick calls never flash. No layout shift.
        (function () {
            if (!document.getElementById('e7barCss')) {
                $('head').append('<style id="e7barCss">#e7bar{position:fixed;top:0;left:0;height:3px;width:0;'
                  + 'background:linear-gradient(90deg,var(--co),var(--co-hv));box-shadow:0 0 6px rgba(225,99,73,.6);'
                  + 'z-index:20050;opacity:0;transition:width .3s ease,opacity .35s ease;pointer-events:none}</style>');
                $('body').append('<div id="e7bar"></div>');
            }
            var showT = null, creepT = null;
            $(document).ajaxStart(function () {
                clearTimeout(showT);
                showT = setTimeout(function () {
                    var $b = $('#e7bar').css({ opacity: 1, width: '30%' });
                    creepT = setTimeout(function () { $b.css('width', '68%'); }, 400);
                }, 180);
            });
            $(document).ajaxStop(function () {
                clearTimeout(showT); clearTimeout(creepT);
                var $b = $('#e7bar');
                if ($b.css('opacity') === '0') return;   // never shown (all requests were fast)
                $b.css('width', '100%');
                setTimeout(function () {
                    $b.css('opacity', 0);
                    setTimeout(function () { $b.css('width', 0); }, 350);
                }, 250);
            });
        })();


        // ══ SURVEY NMDL UPLOAD ═══════════════════════════════════════════════════════════
        function loadNMDL(siteId) {
            siteId = parseInt(siteId, 10) || 0;
            if (!siteId) { $('#nmdlList').html('<div style="color:var(--txm);font-size:11px">Select a station</div>'); return; }
            $('#nmdlList').html('<div style="color:var(--txl);font-size:11px">Loading…</div>');
            $.ajax({
                url: '@Url.Action("GetNMDL", "Station")', data: { siteId: siteId },
                success: function (res) {
                    if (!Array.isArray(res)) { $('#nmdlList').html('<div style="color:var(--err);font-size:11px">' + locEsc((res && res.error) || 'Failed to load') + '</div>'); return; }
                    renderNMDL(res);
                },
