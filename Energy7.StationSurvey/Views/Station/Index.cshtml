        // ── Click handler for sidebar items (delegated) ───────────────────────────
                function bindAssetTypeClicks() {
            $('#atList').off('click', '.ati').on('click', '.ati', function () {
                $('#atList .ati').removeClass('on');
                $(this).addClass('on');

                var tId     = parseInt($(this).data('type-id'), 10);
                var tName   = $(this).data('type-name');
                var count   = $(this).find('.ac').text();

                $('#adTitle').text(tName);
                $('.adp-h span:last-child').text(count + ' assets');

                loadAssetsForType(tId, tName);
            });
        }

        // ── Offcanvas: populate checklist when it opens ───────────────────────────
        $(document).on('show.bs.offcanvas', '#addTypeOC', function () {
            var $box = $('#assetTypeConfigList');
            if (!__masterAssetTypes.length) {
                $box.html('<div style="padding:12px;text-align:center;color:var(--txm)">Select a station first</div>');
                return;
            }

            var saved = getSavedTypeIds(__currentSiteId);
            var checkedSet;
            if (saved && saved.length) {
                checkedSet = {};
                saved.forEach(function (id) { checkedSet[id] = true; });
            } else {
                // Default: check all types that have records at this site
                checkedSet = {};
                __siteAssetTypes.forEach(function (t) { checkedSet[typeId(t)] = true; });
            }

            var html = '';
            __masterAssetTypes.forEach(function (t) {
                var id      = typeId(t);
                var name    = typeName(t);
                var checked = checkedSet[id] ? 'checked' : '';
                html += '<label class="yc" style="padding:5px 0;display:flex;align-items:center;gap:8px">'
                      +     '<input type="checkbox" class="at-chk" value="' + id + '" ' + checked + '>'
                      +     '<span>' + name + '</span>'
                      + '</label>';
            });
            $box.html(html);
        });
        // ── All assets of the station from the Asset API (Asset/GetAll, like the 90 Sites page) ──
        // CardLine only knows assets that are wired on a card, so newly added assets would not show.
        function loadSiteAssets(siteId, done) {
            $.ajax({
                url: '@Url.Action("GetSiteAssets", "Station")',
                data: { siteId: siteId },
                success: function (res) {
                    if (siteId != __currentSiteId) return;   // station changed meanwhile
                    __siteAssets = Array.isArray(res) ? res : [];
                    __siteAssetsLoaded = Array.isArray(res);
                    if (done) done();
                }
            });
        }

        function siteAssetCount(assetTypeId) {
            return __siteAssets.filter(function (a) { return a.assetTypeId === assetTypeId; }).length;
        }

                        function loadAssetsForType(assetTypeId, assetTypeName) {
            // Assets of this type: Asset API first, plus any only known from CardLine
            var map = {};
            __siteAssets.forEach(function (a) {
                if (a.assetTypeId === assetTypeId) map[a.id] = { id: a.id, name: a.name || ('Asset ' + a.id), inactive: a.isActive === false };
            });
            __cardLines.forEach(function (r) {
                if (r.assetTypeId === assetTypeId && r.assetId) {
                    if (!map[r.assetId]) {
                        map[r.assetId] = { id: r.assetId, name: r.assetName || ('Asset ' + r.assetId) };
                    }
                }
            });

            var assets = Object.values(map).sort(function (a, b) {
                return (a.name || '').localeCompare(b.name || '', undefined, { numeric: true });
            });

            // ── Update middle-panel title ("TRACK NAME" → "SIGNAL NAME" etc.) ─────
            var upper = (assetTypeName || 'ASSET').toUpperCase();
            $('#assetListTitle').text(upper + ' NAME');

            // ── Update right-panel tag ("DC Track" → current asset type) ──────────
            $('#selAssetTypeTag').text(assetTypeName || '—');

            var $list = $('#trackList');
            if (!assets.length) {
                $list.html('<div style="padding:12px;text-align:center;color:var(--txm);font-size:11px">No assets</div>');
                $('#modeA').html('<div style="padding:16px;text-align:center;color:var(--txm);font-size:11px">No assets of this type</div>');
                $('#modeB').html('');
                $('#selAN').text('—');
                return;
            }

            var html = '';
            assets.forEach(function (a, i) {
                var sel = (i === 0) ? ' sel' : '';
                html += '<div class="air' + sel + '" data-asset-id="' + a.id + '" '
                      +     'onclick="selectAsset(this, ' + a.id + ')">'
                      +     $('<div>').text(a.name || '').html()
                      +     (a.inactive ? ' <span style="font-size:9px;color:var(--txl)">(inactive)</span>' : '')
                      + '</div>';
            });
            $list.html(html);

            // Auto-load the first asset's attributes and update its name in the header
            $('#selAN').text(assets[0].name);
            loadAttributesForAsset(assets[0].id);
        }
                function loadAttributesForAsset(assetId) {
            ensureAssetsCss();
            var records = __cardLines.filter(function (r) { return r.assetId === assetId; });
            if (records.length) $('#selAN').text(records[0].assetName || '');

            // shared grid column template for headers + rows
            var AWC = '18px minmax(150px,1.6fr) minmax(120px,1fr) 64px 64px 76px 76px';

            // Group attributes by LocationName (e.g. "TF End", "TR End", or "lc 14")
            var groups = {};
            records.forEach(function (r) {
                var loc = r.locationName || 'Default';
                if (!groups[loc]) groups[loc] = [];
                groups[loc].push(r);
            });

            var html = '';
            var idx  = 0;
            Object.keys(groups).forEach(function (loc) {
                var rows   = groups[loc];
                var grpKey = 'g' + (idx++);
                var noLoc  = (loc === 'Default');

                html += '<div class="aw-grp' + (noLoc ? ' aw-grp-warn' : '') + '" style="--awc:' + AWC + '">';
                html +=   '<div class="aw-ghead">'
                      +     '<span class="aw-gname"><i class="bi ' + (noLoc ? 'bi-exclamation-circle' : 'bi-geo-alt-fill') + '"></i>' + locEsc(noLoc ? 'No location set' : loc) + '</span>'
                      +     '<span class="aw-gcount">' + rows.length + ' line' + (rows.length > 1 ? 's' : '') + '</span>'
                      +     (noLoc ? '<span class="aw-ghint">Enter a location on each row, then Save</span>' : '')
                      +     '<label class="stog" style="margin-left:auto" title="Enable / disable this group">'
                      +       '<input type="checkbox" checked onchange="togG(this,\'' + grpKey + '\')">'
                      +       '<span class="stog-sl"></span>'
                      +     '</label>'
                      +   '</div>';
                html +=   '<div class="aw-cols"><span></span><span class="l">Attribute</span><span class="l">Location</span><span>Row</span><span>+ Term</span><span>&minus; Term / Seq</span><span></span></div>';

                rows.forEach(function (r) {
                    var attrName = r.attributeName || '';
                    var row      = r.rowNumber != null ? r.rowNumber : '';
                    var trm      = r.terminalNumberPositive != null ? r.terminalNumberPositive : '';
                    // Voltage: Row, +ve, -ve terminal.  Current: Row, +ve terminal, sequence no. (90 rule)
                    var isCur    = isCurrentCardLine(r);
                    var third    = isCur
                        ? (r.currentSequenceNumber != null ? r.currentSequenceNumber : '')
                        : (r.terminalNumberNegative != null ? r.terminalNumberNegative : '');

                    html += '<div class="ar aw-row" data-cardline-id="' + (r.id || '') + '" data-current="' + (isCur ? 1 : 0) + '">'
                          +   '<input type="checkbox" checked data-g="' + grpKey + '">'
                          +   '<div class="aw-name">'
                          +     '<div class="aw-attr">' + locEsc(attrName) + ' <span class="aw-vi ' + (isCur ? 'I' : 'V') + '">' + (isCur ? 'I' : 'V') + '</span></div>'
                          +     wiredTag(r)
                          +   '</div>'
                          +   '<input class="loc-inp" placeholder="Location *" title="Location Name (required)" value="' + locEsc(r.locationName) + '">'
                          +   '<input class="rt-inp" placeholder="Row" value="' + locEsc(row) + '">'
                          +   '<input class="rt-inp" placeholder="+ Trm" title="Terminal +" value="' + trm + '">'
                          +   '<input class="rt-inp" placeholder="' + (isCur ? 'Seq' : '- Trm') + '" title="' + (isCur ? 'Current sequence no.' : 'Terminal -') + '" value="' + third + '">'
                          +   '<button class="sv-btn" onclick="svA(this)"><i class="bi bi-check-lg"></i>Save</button>'
                          + '</div>';
                });

                html += '</div>';
            });

            if (!records.length)
                html = '<div class="aw-empty"><i class="bi bi-plug"></i>No card lines for this asset yet.<br>'
                     + '<span style="font-size:10px;color:var(--txl)">Wire an attribute below to a cluster card line, then set its Location / Row / Terminal.</span></div>';
            html += '<div id="wireBox"><div style="padding:8px 4px;color:var(--txl);font-size:10px">Loading attributes…</div></div>';

            $('#modeA').html('<div id="wireSum"></div><div class="aw-wrap">' + html + '</div>');
            $('#modeB').html('');   // individual-LOC mode — can populate later if needed
            renderUnwired(assetId, records);
        }

        // Where a wired attribute sits: "cluster_1/LOC-1 · C-1 · L3 · ADC1 P2"
        function wiredTag(r) {
            var parts = [];
            if (r.clusterName) parts.push(r.clusterName);
            if (r.cardName) parts.push(r.cardName);
            if (r.number) parts.push('L' + r.number);
            if (r.pin) parts.push((r.sequenceNumber ? 'ADC' + r.sequenceNumber + ' ' : '') + 'P' + r.pin);
            var txt = parts.join(' · ');
            var chips = parts.map(function (p) { return '<span class="seg">' + locEsc(p) + '</span>'; }).join('<span class="sep">›</span>');
            return '<div class="aw-wired" title="Wired at: ' + locEsc(txt || 'card line ' + r.id) + '">'
                 + '<span class="d"></span>' + (chips || 'Wired') + '</div>';
        }

        // ── Card-line wiring: attributes of this asset not yet on any card line (90 Yard Config card-line popup) ──
        var __attrCache  = {};   // assetTypeId → [{id,title}]
        var __wireAsset  = 0;
        var __wireClusters = null;   // per station
        var __wireClustersSite = 0;

        function wireAssetTypeId(assetId, records) {
            var a = __siteAssets.filter(function (x) { return x.id === assetId; })[0];
            if (a && a.assetTypeId) return a.assetTypeId;
            return records.length ? records[0].assetTypeId : 0;
        }

        function renderUnwired(assetId, records) {
            __wireAsset = assetId;
            var typeIdV = wireAssetTypeId(assetId, records);
            if (!typeIdV) { $('#wireBox').html('<div style="padding:8px 4px;color:var(--err);font-size:10px">Asset type of this asset is unknown — reload the station.</div>'); return; }
            function draw(attrs) {
                if (__wireAsset !== assetId) return;   // user moved to another asset meanwhile
                var wired = {};
                records.forEach(function (r) { if (r.attributeId) wired[r.attributeId] = true; });
                // Derived attributes (e.g. "Last Update … sec ago") are calculated, not a physical input — nothing to wire
                var physical = attrs.filter(function (a) { return !a.derived; });
                var derivedN = attrs.length - physical.length;
                var free = physical.filter(function (a) { return !wired[a.id]; });
                renderWireSummary(records, physical.length, physical.length - free.length);

                if (!attrs.length) {
                    $('#wireBox').html('<div style="padding:8px 4px;color:var(--warn);font-size:10px">This asset type has no attributes defined, so there is nothing to wire.</div>');
                    return;
                }
                var note = derivedN ? '<div class="aw-note"><i class="bi bi-info-circle me-1"></i>' + derivedN + ' calculated attribute' + (derivedN > 1 ? 's' : '') + ' (no wiring needed) not listed.</div>' : '';
                if (!free.length) { $('#wireBox').html(note); return; }
                function awIsCur(a) { return (a.title || '').toLowerCase().indexOf('ma') >= 0; }
                var volt = free.filter(function (a) { return !awIsCur(a); });
                var curr = free.filter(awIsCur);
                function awRow(a) {
                    var isCur = awIsCur(a);
                    return '<div class="ar wr aw-un" data-attr-id="' + a.id + '" data-type-id="' + typeIdV + '" data-attr-name="' + locEsc((a.title || '').toLowerCase()) + '">'
                        + '<span class="nm">' + locEsc(a.title) + ' <span class="aw-vi ' + (isCur ? 'I' : 'V') + '">' + (isCur ? 'I' : 'V') + '</span></span>'
                        + '<button class="wbtn" onclick="openWire(this)"><i class="bi bi-plug"></i> Wire</button>'
                        + '</div>';
                }
                function awSub(label, arr, cls) {
                    return arr.length ? '<div class="aw-sub ' + cls + '">' + label + '<span>' + arr.length + '</span></div>' + arr.map(awRow).join('') : '';
                }
                var h = '<div class="aw-grp">'
                      + '<div class="aw-ghead"><span class="aw-gname"><i class="bi bi-plug"></i>Not wired yet</span>'
                      + '<span class="aw-gcount">' + free.length + ' attribute' + (free.length > 1 ? 's' : '') + ' · ' + volt.length + ' V · ' + curr.length + ' I</span>'
                      + '<input class="aw-search" type="search" placeholder="Filter…" oninput="awFilterUnwired(this.value)">'
                      + '</div>'
                      + awSub('Voltage inputs', volt, 'v') + awSub('Current inputs', curr, 'i')
                      + '<div class="aw-nomatch" style="display:none">No attribute matches your filter.</div>'
                      + '</div>';
                $('#wireBox').html(h + note);
            }
            if (__attrCache[typeIdV]) { draw(__attrCache[typeIdV]); return; }
            $.ajax({
                url: '@Url.Action("GetAssetAttributesByTypeId", "Station")', data: { assetTypeId: typeIdV },
                success: function (res) {
                    if (!Array.isArray(res)) { $('#wireBox').html('<div style="padding:8px 4px;color:var(--err);font-size:10px">' + locEsc((res && res.error) || 'Could not load attributes') + '</div>'); return; }
                    __attrCache[typeIdV] = res.map(function (a) { return { id: a.id, title: a.title || ('Attribute ' + a.id), derived: a.isDerived === true }; })
                                              .sort(function (x, y) { return x.title.localeCompare(y.title, undefined, { numeric: true }); });
                    draw(__attrCache[typeIdV]);
                },
                error: function (xhr) { $('#wireBox').html('<div style="padding:8px 4px;color:var(--err);font-size:10px">Could not load attributes</div>'); }
            });
        }

        // Filter the "Not wired yet" list by attribute name; hide a V/I sub-header when it has no visible rows.
        function awFilterUnwired(q) {
