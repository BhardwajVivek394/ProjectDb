        function mpLoad() {
            var siteId = mpSite();
            if (!siteId) { __mp = null; $('#mpStamp').hide(); $('#mpBody').html('<div class="mp-empty">Select a station</div>'); return; }
            if (__mpBusy) return;
            __mpBusy = true;
            $('#mpBody').html('<div class="mp-empty"><span class="spinner-border spinner-border-sm me-2"></span>Calculating…</div>');
            $.ajax({
                url: '@Url.Action("GetMaterialPositioning", "Station")',
                data: { siteId: siteId, spare: mpSpare() },
                success: function (res) {
                    if (siteId !== mpSite()) return;
                    if (!res || res.error) { $('#mpBody').html('<div class="mp-empty" style="color:var(--err)">' + locEsc((res && res.error) || 'Failed to calculate') + '</div>'); return; }
                    __mp = res; __mpSiteId = siteId; __mpSel = -1;
                    mpRender();
                },
                error: function () { $('#mpBody').html('<div class="mp-empty" style="color:var(--err)">Failed to calculate</div>'); },
                complete: function () { __mpBusy = false; }
